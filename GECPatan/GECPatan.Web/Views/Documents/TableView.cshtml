@model GECPatan.Web.Models.DocumentCategoryDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var category = Model.Category!;
    ViewBag.Title = category.Title;

    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//"))
        {
            return path;
        }
        if (string.IsNullOrEmpty(Model.ApiBaseUrl))
        {
            return Url.Content("~/" + path.TrimStart('~', '/'));
        }
        return Model.ApiBaseUrl + "/" + path.TrimStart('~', '/');
    }

    string GetFileType(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "OTHER";
        var ext = System.IO.Path.GetExtension(path).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "PDF",
            ".doc" or ".docx" => "WORD",
            ".xls" or ".xlsx" => "EXCEL",
            _ => "OTHER"
        };
    }

    string IconFor(string fileType) => fileType switch
    {
        "PDF" => "fa-file-pdf-o",
        "WORD" => "fa-file-word-o",
        "EXCEL" => "fa-file-excel-o",
        _ => "fa-file-o"
    };

    // Flatten every year section's files into one running count, newest
    // year first — matches the old static TableView.cshtml numbering.
    var rows = category.YearSections
        .OrderByDescending(y => y.Year)
        .SelectMany(y => y.Files.OrderBy(f => f.DisplayOrder).Select(f => new { Year = y.Year, File = f }))
        .ToList();
    int count = 1;
}

<style>
    /* Table & Container Layout */
    .table-container-wrapper {
        padding: 0 15px;
        margin: 0 auto;
        max-width: 1200px;
    }

    .table {
        background-color: #fff;
    }

    @@media (max-width: 768px) {
        .table-container-wrapper {
            padding: 0 10px;
        }
    }
</style>

<div class="clearfix"></div>
<div class="page_title3 general_title">
    <div class="container">
        <h1>
            @category.Title
            <div class="line"></div>
        </h1>
    </div>
</div>
<div class="clearfix margin_bottom5"></div>

<div class="content_fullwidth less">
    <div class="featured_section77 two">
        <div class="table-container-wrapper table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="width:70px;">Sr No</th>
                        <th>Title</th>
                        <th class="text-center" style="width:120px;">Year</th>
                        <th style="width:250px;">View / Download</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!rows.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center" style="padding: 30px 0;">
                                <h3 class="text-muted" style="margin:0;">Currently, No Data Available</h3>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in rows)
                        {
                            var fileType = GetFileType(row.File.FilePath);
                            var resolvedUrl = ResolveApiFileUrl(row.File.FilePath);
                            <tr>
                                <td class="text-center">@(count++)</td>
                                <td>@row.File.Title</td>
                                <td class="text-center">@row.Year</td>
                                <td>
                                    @if (fileType == "PDF")
                                    {
                                        <a href="javascript:void(0)" onclick="loadPdf('@resolvedUrl','@row.File.Title')">
                                            <i class="fa @IconFor(fileType)" aria-hidden="true"></i>
                                            @row.File.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@resolvedUrl" target="_blank" download>
                                            <i class="fa @IconFor(fileType)" aria-hidden="true"></i>
                                            @row.File.Title
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="clearfix margin_bottom4"></div>

<a id="lnkPopup" href="#animatedModal" class="popup-trigger hidden" data-target="#popup"></a>
<div id="popup" class="popup">
    <h2 id="newsname"></h2>
    <div id="pdfreader" style="height:550px"></div>
    <span class="popup-btn-close">&times;</span>
</div>

@section scripts {
    <script src="@Url.Content("~/js/pdfobject/pdfobject.min.js")"></script>
    <script>
        function loadPdf(path, name) {
            if (path !== '') {
                path = path.replace("~", "");
                if (PDFObject.supportsPDFs) {
                    PDFObject.embed(path, "#pdfreader");
                    $("#newsname").text(name);
                    $("#lnkPopup").click();
                } else {
                    window.location.href = path;
                }
            }
        }
    </script>


    <script>
        function popupOpenClose(popup) {

            /* Add div inside popup for layout if one doesn't exist */
            if ($(".wrapper", popup).length == 0) {
                $(popup).wrapInner("<div class='wrapper'></div>");
            }

            /* Open popup */
            $(popup).show();

            /* Close popup if user clicks on background */
            $(popup).click(function(e) {
                if (e.target == this) {
                    if ($(popup).is(':visible')) {
                        $(popup).hide();
                    }
                }
            });

            /* Close popup and remove errors if user clicks on cancel or close buttons */
            $(popup).find(".popup-btn-close").on("click", function() {
                if ($(".formElementError").is(':visible')) {
                    $(".formElementError").remove();
                }
                $(popup).hide();
            });
        }

        $(document).ready(function() {
            $(".popup-trigger").on("click", function() {
                var target = $(this).data('target');
                popupOpenClose($(target));
            });
        });
    </script>
}
<link rel="stylesheet" href="@Url.Content("~/css/popup.css")" />