@model GECPatan.Web.Models.DocumentCategoryDetailViewModel
@{
    var collection = Model.Category!;

    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || path.StartsWith("https://") || path.StartsWith("//"))
            return path;
        return string.IsNullOrEmpty(Model.ApiBaseUrl)
            ? Url.Content("~/" + path.TrimStart('~', '/'))
            : Model.ApiBaseUrl + "/" + path.TrimStart('~', '/');
    }

    string GetFileType(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "OTHER";
        return System.IO.Path.GetExtension(path).ToLowerInvariant() switch
        {
            ".pdf" => "PDF",
            ".doc" or ".docx" => "WORD",
            ".xls" or ".xlsx" => "EXCEL",
            _ => "OTHER"
        };
    }

    string IconFor(string fileType) => fileType switch
    {
        "PDF" => "fa-file-pdf-o",
        "WORD" => "fa-file-word-o",
        "EXCEL" => "fa-file-excel-o",
        _ => "fa-file-o"
    };

    var tableRows = collection.HasYearSections
        ? collection.YearSections.OrderByDescending(y => y.Year)
            .SelectMany(y => y.Files.OrderBy(f => f.DisplayOrder).Select(f => new { Year = (string?)y.Year, File = f })).ToList()
        : collection.DirectFiles.OrderBy(f => f.DisplayOrder)
            .Select(f => new { Year = (string?)null, File = f }).ToList();

    int tableCount = 1;
}

<style>
    .table-container-wrapper {
        padding: 0 15px;
        margin: 0 auto;
        max-width: 1200px;
    }

    .table {
        background-color: #fff;
    }

    @@media (max-width: 768px) {
        .table-container-wrapper {
            padding: 0 10px;
        }
    }
</style>

<div class="table-container-wrapper table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th class="text-center" style="width:70px;">Sr No</th>
                <th>Title</th>
                @if (collection.HasYearSections)
                {
                    <th class="text-center" style="width:120px;">Year</th>
                }
                <th style="width:250px;">View / Download</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in tableRows)
            {
                var fileType = GetFileType(row.File.FilePath);
                var resolvedUrl = ResolveApiFileUrl(row.File.FilePath);
                <tr>
                    <td class="text-center">@(tableCount++)</td>
                    <td>@row.File.Title</td>
                    @if (collection.HasYearSections)
                    {
                        <td class="text-center">@row.Year</td>
                    }
                    <td>
                        @if (fileType == "PDF")
                        {
                            <a href="javascript:void(0)" onclick="loadPdf('@resolvedUrl','@row.File.Title')">
                                <i class="fa @IconFor(fileType)" aria-hidden="true"></i> @row.File.Title
                            </a>
                        }
                        else
                        {
                            <a href="@resolvedUrl" target="_blank" download>
                                <i class="fa @IconFor(fileType)" aria-hidden="true"></i> @row.File.Title
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>