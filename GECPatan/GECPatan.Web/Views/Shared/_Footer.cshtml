@model GECPatan.Web.Models.FooterViewModel
<div class="clearfix"></div>


<footer class="footer2">
    <div class="full-container">

        <div class="one_fourth animate fadeInUp" data-anim-type="fadeInUp" data-anim-delay="100">
            <div class="qlinks two">

                <h5>Important Links</h5>
                <ul>
                    <li>
                        <a href="https://www.gtu.ac.in/" target="_blank">
                            <i class="fa fa-circle"></i> Gujarat Technological University (GTU)
                        </a>
                    </li>
                    <li>
                        <a href="https://www.aicte-india.org/" target="_blank">
                            <i class="fa fa-circle"></i> AICTE
                        </a>
                    </li>
                    <li>
                        <a href="https://www.nbaind.org/" target="_blank">
                            <i class="fa fa-circle"></i> NBA
                        </a>
                    </li>
                    <li>
                        <a href="https://dte.gujarat.gov.in/" target="_blank">
                            <i class="fa fa-circle"></i> Directorate of Technical Education
                        </a>
                    </li>
                    <li>
                        <a href="https://dst.gov.in/" target="_blank">
                            <i class="fa fa-circle"></i> DST
                        </a>
                    </li>
                    <li>
                        <a href="https://gpsc.gujarat.gov.in/" target="_blank">
                            <i class="fa fa-circle"></i> GPSC
                        </a>
                    </li>
                    <li>
                        <a href="https://mariyojana.gujarat.gov.in/" target="_blank">
                            <i class="fa fa-circle"></i> Mari Yojana
                        </a>
                    </li>
                </ul>

            </div>
        </div><!-- end section -->

        <div class="one_fourth animate fadeInUp" data-anim-type="fadeInUp" data-anim-delay="200">
            <div class="qlinks two">

                <h5>Quick Links</h5>

                <ul>
                    @* Driven by GET /api/menu/footer (MenuType="Footer" items configured in Admin) *@
                    @foreach (var item in Model.FooterMenu.OrderBy(m => m.Position))
                    {
                        var href = string.IsNullOrWhiteSpace(item.Link) ? "javascript:void(0)" : item.Link;
                        var target = item.OpenInNewTab ? "_blank" : "_self";
                        <li>
                            <a href="@href" target="@target"><i class="fa fa-circle"></i> @item.MenuText</a>
                        </li>
                    }
                </ul>

            </div>
        </div><!-- end section -->

        <div class="one_fourth animate fadeInUp" data-anim-type="fadeInUp" data-anim-delay="500">
            <ul class="faddress">
                <li><img src="@Url.Content("~/images/GECP_LOGO.png")" class="rimg" style="width:100px;" /></li>
                <li><i class="fa fa-map-marker fa-lg"></i> &nbsp;@Html.Raw(Model.Address ?? "Government Engineering College, PATAN<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; At &amp; Post. Katpur, Patan, Gujarat-384265")</li>
                <li><i class="fa fa-phone fa-lg"></i>&nbsp; @Model.ContactNo</li>
                <li><i class="fa fa-mail fa-lg"></i><a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a></li>
            </ul>
        </div><!-- end address -->


        <div class="one_fourth last animate fadeInUp" data-anim-type="fadeInUp" data-anim-delay="500">
            @{
                var mapSrc = string.IsNullOrWhiteSpace(Model.MapEmbedUrl)
                    ? "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d14601.041555748003!2d72.103398!3d23.809338!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395c7d0db6c534b3%3A0x34c9aef47a82f519!2sGovernment%20Engineering%20College%2C%20Patan!5e0!3m2!1sen!2sin!4v1783529594599!5m2!1sen!2sin"
                    : Model.MapEmbedUrl;
            }
            <iframe class="google-map" style="width:100%; height:250px;" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="@mapSrc" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div><!-- end address -->


    </div><!-- end footer -->

    <div class="clearfix"></div>

    <div class="copyright_info2">
        <div class="full-container">

            <div class="clearfix divider_dashed10"></div>

            <div class="one_half">

                <ul class="footer_social_links2">
                    @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                    {
                        <li class="animate zoomIn" data-anim-type="zoomIn" data-anim-delay="300"><a href="@Model.FacebookUrl" target="_blank"><i class="fa fa-facebook"></i></a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TwitterUrl))
                    {
                        <li class="animate zoomIn" data-anim-type="zoomIn" data-anim-delay="300"><a href="@Model.TwitterUrl" target="_blank"><i class="fa fa-twitter"></i></a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                    {
                        <li class="animate zoomIn" data-anim-type="zoomIn" data-anim-delay="300"><a href="@Model.LinkedInUrl" target="_blank"><i class="fa fa-linkedin"></i></a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                    {
                        <li class="animate zoomIn" data-anim-type="zoomIn" data-anim-delay="300"><a href="@Model.InstagramUrl" target="_blank"><i class="fab fa-instagram"></i></a></li>
                    }
                </ul>

            </div>

            <div class="one_half last animate fadeInLeft" data-anim-type="fadeInLeft" data-anim-delay="300">

                Copyright &copy; @DateTime.Now.Year gecpatan.ac.in. All rights reserved.

            </div>

        </div>
    </div><!-- end copyright info -->


</footer>
