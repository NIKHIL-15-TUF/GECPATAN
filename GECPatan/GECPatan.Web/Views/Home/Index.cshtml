@using System.Globalization
@using System.Text.RegularExpressions
@model GECPatan.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
    ViewData["ApiBaseUrl"] = Model.ApiBaseUrl;

    int currentYear = DateTime.Now.Year;

    // ── Helpers ────────────────────────────────────────────────────────────
    // Uploaded files/images live on GECPatan.Api's static file host, so every
    // relative path must be resolved against Api:BaseUrl.
    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//"))
        {
            return path;
        }
        if (string.IsNullOrEmpty(Model.ApiBaseUrl)) return path;
        return Model.ApiBaseUrl + "/" + path.TrimStart('~', '/');
    }

    // Shared by Marquee and Updates (same LinkType/Link/FilePath shape).
    string ResolveItemHref(string linkType, string? link, string? filePath)
        => linkType == "file" ? ResolveApiFileUrl(filePath) : (link ?? "#");

    string? OpenTarget(string linkType)
        => linkType is "external" or "file" ? "_blank" : null;

    // The API carries no icon for departments, so map ShortCode -> icon.
    string DeptIcon(string? shortCode) => (shortCode ?? string.Empty).ToUpperInvariant() switch
    {
        "AM" => "fa fa-graduation-cap",
        "EC" => "fas fa-microchip",
        "CO" or "CE" or "CSE" => "fa fa-desktop",
        "EE" or "EL" => "fa fa-bolt",
        "CI" or "CV" => "fas fa-hard-hat",
        "ME" => "fa fa-wrench",
        "SH" => "fa fa-cogs",
        _ => "fa fa-graduation-cap"
    };

    // EventDate arrives as a string; sort newest first, unparsable dates last.
    DateTime ParseEventDate(string? s)
    {
        if (DateTime.TryParseExact(s, new[] { "dd-MM-yyyy", "yyyy-MM-dd", "dd/MM/yyyy", "yyyy-MM-ddTHH:mm:ss" },
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var exact))
        {
            return exact;
        }
        return DateTime.TryParse(s, CultureInfo.InvariantCulture, DateTimeStyles.None, out var loose)
            ? loose
            : DateTime.MinValue;
    }

    // "Latest Shots" only carries a VideoUrl: turn YouTube links into embeds,
    // use <video> for direct files, otherwise embed the URL as-is.
    string ToEmbedUrl(string url)
    {
        var m = Regex.Match(url ?? string.Empty,
            @"(?:youtu\.be/|youtube\.com/(?:watch\?(?:.*&)?v=|embed/|shorts/))([A-Za-z0-9_-]{11})");
        return m.Success ? "https://www.youtube.com/embed/" + m.Groups[1].Value : (url ?? string.Empty);
    }

    bool IsDirectVideo(string url)
    {
        var clean = (url ?? string.Empty).Split('?')[0].ToLowerInvariant();
        return clean.EndsWith(".mp4") || clean.EndsWith(".webm") || clean.EndsWith(".ogg");
    }

    // ── Page data ─────────────────────────────────────────────────────────
    var vision = (Model.Settings?.Vision
        ?? "To prepare human resources with value-based competency for technical advancements and growth of society.")
        .Replace("<p>", "").Replace("</p>", "");

    var mission = (Model.Settings?.Mission ?? string.Empty)
        .Replace("<li>", "<li><i class=\"fa fa-toggle-on\" aria-hidden=\"true\"></i> ");

    var principalName = Model.Principal?.Name ?? Model.Settings?.PrincipalName;
    var principalDesignation = Model.Principal?.Designation ?? Model.Settings?.PrincipalDesignation;
    var principalMessage = (Model.Principal?.Message ?? Model.Settings?.PrincipalMessage ?? string.Empty)
        .Replace("<p>", "").Replace("</p>", "");
    var principalPhoto = Model.Principal?.PhotoPath ?? Model.Settings?.PrincipalPhoto;
    var principalInstitute = Model.Principal?.Institute ?? "Government Engineering College, Patan";

    var currentYearActivities = Model.Activities
        .Where(a => a.Year == currentYear)
        .OrderByDescending(a => ParseEventDate(a.EventDate))
        .ToList();

    var alumni = Model.NotableAlumni.OrderBy(a => a.OrderNo).ToList();
    var videos = Model.VideoCarousel.OrderBy(v => v.OrderNo).ToList();

    // The four feature tiles under the hero: icon class (optional) + text.
    var features = new[]
    {
        (Icon: Model.Stats?.Feature1Icon, Text: Model.Stats?.Feature1Text ?? "Five UG Engineering Programs",    Fallback: "icon1.jpg", Delay: 100),
        (Icon: Model.Stats?.Feature2Icon, Text: Model.Stats?.Feature2Text ?? "Well Qualified Faculties",        Fallback: "icon2.jpg", Delay: 200),
        (Icon: Model.Stats?.Feature3Icon, Text: Model.Stats?.Feature3Text ?? "Center of Excellence",            Fallback: "icon3.jpg", Delay: 300),
        (Icon: Model.Stats?.Feature4Icon, Text: Model.Stats?.Feature4Text ?? "Holistic Development of Students", Fallback: "icon4.jpg", Delay: 400)
    };
}

<div class="featured_section13">
    <div class="clearfix margin_top11"></div>

    @* ── Horizontal ticker (always rendered so spacing stays stable) ── *@
    <div class="marquee-container">
        <div class="marquee-track">
            @if (Model.Marquee.Any())
            {
                @for (int i = 0; i < Model.Marquee.Count; i++)
                {
                    var item = Model.Marquee[i];

                    if (item.LinkType != "none")
                    {
                        <a class="marquee-content"
                           href="@ResolveItemHref(item.LinkType, item.Link, item.FilePath)"
                           target="@OpenTarget(item.LinkType)">@item.Title</a>
                    }
                    else
                    {
                        <span class="marquee-content">@item.Title</span>
                    }

                    if (i < Model.Marquee.Count - 1)
                    {
                        <span class="marquee-separator"> | </span>
                    }
                }
            }
            else
            {
                <span class="marquee-content">&nbsp;</span>
            }
        </div>
    </div>

    <div class="clearfix"></div>

    @* ── Hero: slider (left) + tabbed Notice Board / Activities (right) ── *@
    <div class="full-container">
        <div class="bg-light">
            <div class="hero-split-showcase">

                <div class="hero-main-slider-pane">
                    @await Html.PartialAsync("_slider", Model.Sliders)
                </div>

                <div class="updates_section hero-notice-board-pane">

                    <div class="notice-tab-header-row">
                        <button type="button" class="notice-tab-btn active" onclick="switchNoticeTab(event, 'tab-updates')">Notice Board</button>
                        <button type="button" class="notice-tab-btn" onclick="switchNoticeTab(event, 'tab-activities')">Activities</button>
                    </div>

                    @* TAB 1: Updates *@
                    <div id="tab-updates" class="notice-tab-pane active">
                        <div class="notice-board-height">
                            <marquee scrollamount="3" direction="up" onMouseOver="this.stop()" onMouseOut="this.start()" class="notice-board-marquee-height">
                                <ul class="newssection">
                                    @if (!Model.Updates.Any())
                                    {
                                        <li><strong>NO UPDATES FOUND</strong></li>
                                    }
                                    else
                                    {
                                        foreach (var item in Model.Updates)
                                        {
                                            <li>
                                                @if (item.LinkType != "none")
                                                {
                                                    <a href="@ResolveItemHref(item.LinkType, item.Link, item.FilePath)"
                                                       target="@OpenTarget(item.LinkType)">@item.Title</a>
                                                }
                                                else
                                                {
                                                    @item.Title
                                                }
                                            </li>
                                        }
                                    }
                                </ul>
                            </marquee>
                        </div>
                    </div>

                    @* TAB 2: Activities (current year, newest first) *@
                    <div id="tab-activities" class="notice-tab-pane">
                        <div class="activity-height">
                            <marquee scrollamount="3" direction="up" onMouseOver="this.stop()" onMouseOut="this.start()" class="activity-marquee-height">
                                <ul class="newssection activity-list">
                                    @if (!currentYearActivities.Any())
                                    {
                                        <li><strong>NO ACTIVITIES FOUND</strong></li>
                                    }
                                    else
                                    {
                                        foreach (var item in currentYearActivities)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(item.Link))
                                                {
                                                    <a class="activity-link" href="@item.Link" target="_blank">@item.Title</a>
                                                }
                                                else
                                                {
                                                    <span class="activity-link">@item.Title</span>
                                                }
                                            </li>
                                        }
                                    }
                                </ul>
                            </marquee>
                            <div class="clearfix activity-viewall">
                                <a href="@Url.Action("Index", "Achievement")" class="btn btn-success">View All</a>
                            </div>
                        </div>
                    </div>

                </div><!-- end hero-notice-board-pane -->
            </div><!-- end hero-split-showcase -->
        </div>
    </div>

    <div class="clearfix"></div>

    @* ── Row: Notable Alumni | feature icons | Latest Shots ── *@
    <div class="full-container notable-alumni-section">
        <div class="New_container">

            <div class="updates_section">
                <ul style="margin-bottom:0px;">
                    <li class="tab-heading">Notable Alumni</li>
                </ul>
                <div id="AlumniCarousel" class="owl-carousel">
                    @foreach (var item in alumni)
                    {
                        if (item.IsIframe && !string.IsNullOrWhiteSpace(item.IFrame))
                        {
                            <div class="carousel-slide-item type-video">
                                @* IFrame is admin-authored markup from the API (same trust level as the legacy site). *@
                                <div class="carousel-video-wrapper">@Html.Raw(item.IFrame)</div>
                                @if (!string.IsNullOrWhiteSpace(item.Title))
                                {
                                    <div class="carousel-caption">@item.Title</div>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.Image))
                        {
                            <div class="carousel-slide-item type-image">
                                <img src="@ResolveApiFileUrl(item.Image)" alt="@item.Title" class="rimg" />
                                @if (!string.IsNullOrWhiteSpace(item.Title))
                                {
                                    <div class="carousel-caption">@item.Title</div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="center_icons_section">
                @foreach (var f in features)
                {
                    <div class="icon_grid_box">
                        @if (!string.IsNullOrWhiteSpace(f.Icon))
                        {
                            <i class="@f.Icon cirimg-icon animate" data-anim-type="zoomIn" data-anim-delay="@f.Delay" aria-hidden="true"></i>
                        }
                        else
                        {
                            <img src="@Url.Content("~/images/Home/" + f.Fallback)" alt="" class="cirimg animate" data-anim-type="zoomIn" data-anim-delay="@f.Delay" />
                        }
                        <h4 class="color2">@f.Text</h4>
                    </div>
                }
            </div>

            <div class="updates_section">
                <ul style="margin-bottom:0px;">
                    <li class="tab-heading">Latest Shots</li>
                </ul>
                <div id="VideoCarousel" class="owl-carousel">
                    @foreach (var item in videos)
                    {
                        if (string.IsNullOrWhiteSpace(item.VideoUrl)) { continue; }

                        <div class="carousel-slide-item type-video">
                            <div class="carousel-video-wrapper">
                                @if (IsDirectVideo(item.VideoUrl))
                                {
                                    <video controls preload="metadata" src="@ResolveApiFileUrl(item.VideoUrl)"></video>
                                }
                                else
                                {
                                    <iframe src="@ToEmbedUrl(item.VideoUrl)"
                                            title="@item.Title"
                                            loading="lazy"
                                            allowfullscreen
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Title))
                            {
                                <div class="carousel-caption">@item.Title</div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
<!-- end featured section 13 -->
<div class="clearfix"></div>

@* ── Principal message (left) + Vision / Mission (right) ── *@
<div class="full-container info-showcase-split-row">

    <div class="principal-message-card-pane">
        @if (!string.IsNullOrWhiteSpace(principalName))
        {
            <div class="principal-card-flex-wrapper">

                <div class="principal-meta-col">
                    @if (!string.IsNullOrWhiteSpace(principalPhoto))
                    {
                        <div class="principalimage">
                            <img src="@ResolveApiFileUrl(principalPhoto)" alt="Principal Photo" />
                        </div>
                    }
                    <h4 class="principalname">@principalName</h4>
                    <p class="principaldesignation">@(principalDesignation?.ToUpperInvariant() ?? "PRINCIPAL")</p>
                    <p class="principaldesignations">@principalInstitute</p>
                </div>

                <div class="principal-text-col">
                    <div class="principalmessage">
                        <h2 class="mb-3">Message from the Principal</h2>
                        <div class="border-left pl-3" style="border-color: #4f75ba;">
                            <p style="text-align: justify; font-size: 14px; line-height: 22px;">@principalMessage</p>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>

    <div class="vision-mission-card-pane">

        <div class="vision-segment-box stcode_title4">
            <h3><span class="text"><i class="fa fa-institution" aria-hidden="true"></i><strong> VISION</strong></span></h3>
            <p class="text-justify" style="font-size: 15px; margin-top: 8px;">@Html.Raw(vision)</p>
        </div>

        <div class="mission-segment-box stcode_title4" style="margin-top: 20px;">
            <h3><span class="text"><i class="fa fa-mortar-board" aria-hidden="true"></i><strong> MISSION</strong></span></h3>
            @if (!string.IsNullOrWhiteSpace(mission))
            {
                @Html.Raw(mission)
            }
            else
            {
                <ul class="text-justify">
                    <li><i class="fa fa-toggle-on" aria-hidden="true"></i> To deliver technical programs and services to cater the current needs of society and industry.</li>
                    <li><i class="fa fa-toggle-on" aria-hidden="true"></i> Helping industries in solving challenges by means of providing best technical human resources.</li>
                    <li><i class="fa fa-toggle-on" aria-hidden="true"></i> To contribute in sustainable growth of society.</li>
                </ul>
            }
        </div>

    </div>
</div>

<div class="clearfix"></div>

@* ── Departments ── *@
@if (Model.Departments.Any())
{
    <div class="featured_section16">
        <div class="full-container">

            <h1 class="caps text-center">Departments</h1>

            <div class="box departments-flex-row">
                @foreach (var dept in Model.Departments)
                {
                    <a href="@Url.Action("Index", "Department", new { id = dept.DeptId })">
                        <div class="hexagon one animate" data-anim-type="spinLeft" data-anim-delay="300">
                            <i class="@DeptIcon(dept.ShortCode)"></i>
                            <h6>@(string.IsNullOrWhiteSpace(dept.Name) ? dept.ShortCode : dept.Name)</h6>
                        </div>
                    </a>
                }
            </div>

        </div>
    </div>
}

@* ── Top recruiters ── *@
@if (Model.TopRecruiters.Any())
{
    <div class="clearfix"></div>
    <div class="full-container top-recruiter-section">

        <h1 class="caps text-center">TOP RECRUITERS</h1>
        <div class="clearfix"></div>

        <div class="owl-carousel owl-theme" id="owl-demo">
            @foreach (var r in Model.TopRecruiters)
            {
                <div class="item">
                    <div class="recruiter-logo-card">
                        <img src="@ResolveApiFileUrl(r.LogoPath)" alt="@r.Name" />
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="clearfix"></div>

@* ── Student testimonials ── *@
@if (Model.Testimonials.Any())
{
    <div class="parallax_section1">
        <div class="clearfix margin_bottom6"></div>
        <div class="container">

            <div class="flexslider carousel">
                <ul class="slides">
                    @foreach (var item in Model.Testimonials)
                    {
                        <li>
                            <img src="@Url.Content("~/images/Home/icon-user-90.png")" alt="" />
                            <h5>@item.StudentName <em>@item.Department - @item.PassoutYear</em></h5>
                            <p>@item.TestimonialText</p>
                        </li>
                    }
                </ul>
            </div>

        </div>
        <div class="clearfix"></div>
    </div>
    <!-- end parallax section 1 -->
}

@section tabs {
    <script src="@Url.Content("~/js/tabs2/index.js")"></script>
    <script>
        $('.accordion, .tabs').TabsAccordion({
            hashWatch: true,
            pauseMedia: true,
            responsiveSwitch: 'tablist',
            saveState: sessionStorage,
        });
    </script>
    <script defer src="@Url.Content("~/js/flexslider/jquery.flexslider.js")"></script>
    <script defer src="@Url.Content("~/js/flexslider/custom.js")"></script>
    <script src="@Url.Content("~/js/tabs/assets/js/responsive-tabs.min.js")" type="text/javascript"></script>
}

@section master_slider {
    <script src="@Url.Content("~/js/masterslider/masterslider.min.js")"></script>
    <script type="text/javascript">
        (function($) {
            "use strict";
            var slider = new MasterSlider();

            // Time bar needs the #progressBar element (rendered by the _slider partial).
            slider.control('timebar', { insertTo: '#progressBar', color: '#ffb300' });

            slider.setup('masterslider', {
                width: 1400,
                height: 680,
                space: 0,
                speed: 45,
                layout: 'fillwidth',
                loop: true,
                preload: 0,
                autoplay: true,
                view: "parallaxMask"
            });
        })(jQuery);
    </script>

    <script>
        // Notice Board / Activities tab switch.
        function switchNoticeTab(evt, paneId) {
            document.querySelectorAll('.notice-tab-pane').forEach(function(p) { p.classList.remove('active'); });
            document.querySelectorAll('.notice-tab-btn').forEach(function(b) { b.classList.remove('active'); });
            var pane = document.getElementById(paneId);
            if (pane) { pane.classList.add('active'); }
            if (evt && evt.currentTarget) { evt.currentTarget.classList.add('active'); }
        }

        // Alumni / Latest Shots carousels. Skipped if the layout already initialised them.
        $(document).ready(function() {
            ['#AlumniCarousel', '#VideoCarousel'].forEach(function(sel) {
                var $el = $(sel);
                if ($el.length && !$el.hasClass('owl-loaded')) {
                    $el.owlCarousel({
                        items: 1,
                        loop: $el.children().length > 1,
                        margin: 10,
                        nav: true,
                        dots: false,
                        autoplay: sel === '#AlumniCarousel',
                        autoplayTimeout: 4000,
                        autoplayHoverPause: true,
                        autoHeight: true
                    });
                }
            });
        });
    </script>
}

@section styles {
    <!-- flexslider -->
    <link rel="stylesheet" href="@Url.Content("~/js/flexslider/flexslider.css")" type="text/css" media="screen" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/js/flexslider/skin.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/js/tabs/assets/css/responsive-tabs3.css")">

    <link rel="stylesheet" type="text/css" href="@Url.Content("~/css/custom.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/css/custom-home.css")">
}
