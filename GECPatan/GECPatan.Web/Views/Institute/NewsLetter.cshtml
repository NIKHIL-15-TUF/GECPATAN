@model GECPatan.Web.Models.NewsLetterViewModel
@{
    ViewData["Title"] = "News Letter";
    int count = 0;
    // Uploaded PDFs are served by GECPatan.Api's static file middleware.
    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//"))
        {
            return path;
        }

        if (string.IsNullOrEmpty(Model.ApiBaseUrl))
        {
            return path;
        }

        return Model.ApiBaseUrl + "/" + path.TrimStart('~', '/');
    }
}

<div class="page_title3 placement_title">
    <div class="container">
        <h1>
            <br>
            PRAGYAANAM
            <em>Newsletter Series Government Engineering College Patan</em>
            <div class="line"></div>
            <br>
        </h1>
    </div>
</div>

<div class="clearfix"></div>

<div class="content_fullwidth less">

    @if (Model.Letters.Count > 0)
    {
        <div class="container">

            <div class="table-responsive">
                <table class="table table-bordered table-hover newsletter-table">

                    <thead>
                        <tr>
                            <th style="width: 10%;">No.</th>
                            <th>Newsletter</th>
                            <th style="width: 180px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Letters)
                        {
                            var fileUrl = ResolveApiFileUrl(item.FilePath);

                            <tr>
                                <td>
                                    @(++count)
                                </td>
                                <td>
                                    <strong>@item.Title</strong>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(fileUrl))
                                    {
                                        <button type="button"
                                                class="btn-preview-read js-read-newsletter"
                                                data-file="@fileUrl"
                                                data-title="@item.Title">
                                            <i class="fa fa-book-reader"></i>
                                            Read Newsletter
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Document not available
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    }
    else
    {
        <div class="container" style="text-align:center; padding:50px;">
            <h3>No Newsletters Found.</h3>
        </div>
    }

</div>

<div class="clearfix"></div>


@section scripts {

    <script src="@Url.Content("~/js/pdfobject/pdfobject.min.js")"></script>

    <script>
        jQuery(document).ready(function ($) {

            $('.js-read-newsletter').on('click', function () {

                var pdfPath = $(this).attr('data-file');

                if (!pdfPath) {
                    alert("Document not found.");
                    return;
                }

                openPdfPopup(pdfPath);
            });

        });


        function openPdfPopup(path) {

            if (!path) {
                return;
            }

            // Create popup only when required
            var popupHtml = `
                <div id="popupOverlay" class="popup-overlay"></div>

                <div id="popup">
                    <div class="popup-close">&times;</div>

                    <div id="pdfreader"
                         style="width:100%; height:100%;">
                    </div>
                </div>
            `;

            $('body').append(popupHtml);

            $('#popupOverlay, #popup').fadeIn();


            // Use PDFObject when available
            if (typeof PDFObject !== 'undefined') {

                if (PDFObject.supportsPDFs) {

                    PDFObject.embed(
                        path,
                        "#pdfreader"
                    );

                }
                else {

                    window.location.href = path;

                }

            }
            else {

                // Fallback iframe
                $("#pdfreader").html(
                    '<iframe src="' +
                    path +
                    '" style="width:100%; height:100%; border:none;"></iframe>'
                );

            }


            // Close popup
            $('.popup-close, #popupOverlay').on('click', function () {

                $('#popup, #popupOverlay').fadeOut(function () {

                    $('#popup, #popupOverlay').remove();

                });

            });

        }
    </script>
}


<style>

    /* =========================================
       NEWSLETTER TABLE
       ========================================= */

    .newsletter-table {
        width: 100%;
        margin-top: 20px;
        background: #fff;
    }

    .newsletter-table th {
        font-weight: 600;
        vertical-align: middle;
    }

    .newsletter-table td {
        vertical-align: middle;
    }

    .newsletter-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .newsletter-table tbody tr:hover {
        background-color: #f8f9fa;
    }


    /* =========================================
       READ NEWSLETTER BUTTON
       ========================================= */

    .btn-preview-read {
        display: inline-block;
        padding: 8px 18px;
        background-color: #5076bb;
        color: white !important;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .btn-preview-read:hover {
        background-color: #0056b3;
        color: white !important;
    }


    /* =========================================
       PDF POPUP OVERLAY
       ========================================= */

    .popup-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        z-index: 9998;
    }


    /* =========================================
       PDF POPUP
       ========================================= */

    #popup {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);

        width: 85%;
        height: 90%;

        background: #fff;

        z-index: 9999;

        padding: 10px;

        border-radius: 8px;
    }


    /* =========================================
       POPUP CLOSE BUTTON
       ========================================= */

    .popup-close {
        position: absolute;

        top: -15px;
        right: -15px;

        background: red;
        color: white;

        width: 30px;
        height: 30px;

        border-radius: 50%;

        text-align: center;
        line-height: 30px;

        cursor: pointer;

        font-weight: bold;

        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);

        z-index: 10000;
    }


    /* =========================================
       MOBILE RESPONSIVE
       ========================================= */

    @@media (max-width: 768px) {

        .newsletter-table {
            font-size: 13px;
        }

        .newsletter-table th,
        .newsletter-table td {
            padding: 8px;
        }

        .btn-preview-read {
            padding: 6px 10px;
            font-size: 12px;
        }

        #popup {
            width: 95%;
            height: 85%;
        }

        .popup-close {
            top: -10px;
            right: -5px;
        }
    }

</style>