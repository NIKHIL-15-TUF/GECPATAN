@model GECPatan.Web.Models.AchievementsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Achievements";
}
<div class="page_title3 placement_title">
    <div class="full-container">

        <h1>
            <br> Achievements
            <div class="line"></div>
            <br>
        </h1>

    </div>
</div>
<div class="margin_top10"></div>

<div class="full-container">
    @{
        void RenderYearButtons()
        {
            <button class="tablinks active" data-tab="All" data-url="@Url.Action("ByYear", "Achievement", new { year = 0 })" onclick="loadAchievements(event)">All</button>
            @foreach (var year in Model.Years)
            {
                <button class="tablinks" data-tab="@year" data-url="@Url.Action("ByYear", "Achievement", new { year })" onclick="loadAchievements(event)">@year</button>
            }
        }
    }
    <div class="tab hidden-xs">
        @{
            RenderYearButtons();
        }
    </div>
    <div class="tab-xs visible-xs">
        @{
            RenderYearButtons();
        }
    </div>

    <div id="achDiv" class="tabcontent">
    </div>
    <!-- end works section -->
</div>

<div class="clearfix margin_top2"></div>

@section Scripts {
    <script type="text/javascript" src="@Url.Content("~/js/cubeportfolio/gecp_cubeportfolio_custom.js")"></script>
    <script type="text/javascript">
        // Year tabs. URL hash = tab label:  /Achievement#2024  (or #All)
        function showAchievementTab(name, byUser) {
            var btn = $('.tablinks').filter(function() { return $(this).data('tab') == name; }).first();
            if (!btn.length) { btn = $('.tablinks').first(); }      // unknown hash -> "All"
            name = btn.data('tab');

            // highlight in both the desktop and mobile bars
            $('.tablinks').removeClass('active')
                .filter(function() { return $(this).data('tab') == name; }).addClass('active');

            if (byUser) { TabHash.set(String(name)); }

            $('#achDiv').load(btn.data('url'), function() {
                if ($('#grid-container').data('cubeportfolio')) {
                    destroyGrid(); // external helper from gecp_cubeportfolio_custom.js
                }
                reInit();
            });
        }

        // Called by the year buttons above.
        function loadAchievements(evt) {
            evt.preventDefault();
            // custom.js auto-clicks #defaultOpen on load; ignore that fake click
            // (the ready handler below loads the tab from the URL hash instead).
            if (!evt.isTrusted) return;
            showAchievementTab($(evt.currentTarget).data('tab'), true);
        }

        $(document).ready(function() {
            // first load: tab from URL hash, else "All"
            showAchievementTab(TabHash.getName() || 'All', false);
        });

        // back/forward or manually edited hash
        $(window).on('hashchange', function() {
            showAchievementTab(TabHash.getName() || 'All', false);
        });
    </script>
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/js/timeline/timeline.css")">
}