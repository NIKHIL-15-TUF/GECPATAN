 @model GECPatan.Web.Models.ActivityDetailViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var activity = Model.Activity;

    ViewBag.Title = activity.Title;

    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "";

        if (Uri.TryCreate(path, UriKind.Absolute, out var absolute))
            return absolute.ToString();

        return $"{Model.ApiBaseUrl.TrimEnd('/')}/{path.TrimStart('/')}";
    }
}

<div class="page_title3 engg_title">
    <div class="container">
        <h1>
            Activities
            <div class="line"></div>
        </h1>
    </div>
</div>

<div class="margin_top10"></div>
<div class="clearfix"></div>

<div class="full-container activity-detail-page">
    <div class="blog_post">
        <div class="blog_postcontent">

            <h2 class="color3 fw-bold mb-2">
                @activity.Title
            </h2>

            @if (activity.Images != null && activity.Images.Any())
            {
                <div class="owl-carousel owl-theme text-center"
                     id="activity-carousel">

                    @foreach (var img in activity.Images.OrderBy(x => x.DisplayOrder))
                    {
                        <div class="item">
                            <img src="@ResolveApiFileUrl(img.ImagePath)"
                                 alt="@activity.Title"
                                 class="img-fluid rounded shadow-sm" />
                        </div>
                    }
                </div>
            }

            <div class="clearfix margin_bottom3"></div>

            <ul class="post_meta_links mb-3 meta-info">
                @if (!string.IsNullOrWhiteSpace(activity.EventDate)
                    && DateTime.TryParse(activity.EventDate, out var eventDate))
                {
                    <li>
                        <strong>Date:</strong>
                        @eventDate.ToString("dd-MM-yyyy")
                    </li>
                }

                @if (!string.IsNullOrWhiteSpace(activity.EventTime))
                {
                    <li>
                        <strong>Time:</strong>
                        @activity.EventTime
                    </li>
                }
            </ul>

            <div class="clearfix margin_bottom3"></div>

            @if (!string.IsNullOrWhiteSpace(activity.Description))
            {
                <div class="description">
                    @Html.Raw(activity.Description)
                </div>
            }

            <div class="clearfix margin_bottom3"></div>

            @if (activity.Files != null && activity.Files.Any())
            {
                <div class="mt-4 pt-3 border-top">
                    <h4 class="color3 fw-semibold mb-3 related-files">
                        Related Files
                    </h4>

                    <ul class="list-unstyled">
                        @foreach (var file in activity.Files.OrderBy(x => x.DisplayOrder))
                        {
                            <li class="mb-2">
                                <a href="@ResolveApiFileUrl(file.FilePath)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="text-decoration-none text-dark">

                                    <i class="fa fa-file-pdf-o text-danger me-2"></i>

                                    <strong>@file.Title</strong>

                                    <span class="text-muted">
                                        (@file.FileType)
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(activity.ExternalLink))
            {
                <div class="mt-3">
                    <a href="@activity.ExternalLink"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-primary">
                        Visit Related Link
                        <i class="fa fa-external-link ml-1"></i>
                    </a>
                </div>
            }

        </div>
    </div>

    <div class="clearfix"></div>
    <div class="margin_bottom4"></div>
    <div class="clearfix"></div>
</div>

@section styles {
    <style>
        .activity-detail-page {
            padding-bottom: 35px;
        }

        .description {
            line-height: 1.7;
            font-size: 1.05rem;
            color: #333;
        }

        .related-files {
            border-bottom: 2px solid #ccc;
            padding-bottom: 5px;
        }

        .meta-info {
            font-size: 0.95rem;
            color: #555;
            list-style: none;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        #activity-carousel .item img {
            width: 100%;
            max-height: 420px;
            object-fit: contain;
            padding: 0 5px;
        }
    </style>
}

@section scripts {
    <script>
        $(document).ready(function () {
            if ($('#activity-carousel').length && $.fn.owlCarousel) {
                $('#activity-carousel').owlCarousel({
                    items: 1,
                    loop: true,
                    margin: 10,
                    nav: true,
                    dots: true,
                    autoplay: true,
                    autoplayTimeout: 5000,
                    autoplayHoverPause: true
                });
            }
        });
    </script>
}