@model GECPatan.Web.Models.ActivityListViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Activities";

    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "";

        if (Uri.TryCreate(path, UriKind.Absolute, out var absolute))
            return absolute.ToString();

        return $"{Model.ApiBaseUrl.TrimEnd('/')}/{path.TrimStart('/')}";
    }
}

<div class="page_title3 engg_title">
    <div class="container">
        <h1>
            Activities
            <div class="line"></div>
        </h1>
    </div>
</div>

<div class="margin_top10"></div>
<div class="clearfix"></div>

<div class="full-container activity-list-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
        <h3 class="mb-2">All Activities</h3>

        <form method="get" action="/Activities" class="form-inline mb-2">
            <label for="yearFilter" class="mr-2">Filter by Year:</label>

            <select id="yearFilter"
                    name="year"
                    class="form-control"
                    onchange="this.form.submit()">

                <option value="">All Years</option>

                @foreach (var year in Model.Years)
                {
                    <option value="@year"
                            selected="@(Model.SelectedYear == year)">
                        @year
                    </option>
                }
            </select>
        </form>
    </div>

    @if (Model.Activities != null && Model.Activities.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="activitiesTable">
                <thead>
                    <tr>
                        <th class="text-center" style="width:70px;">Sr. No.</th>
                        <th>Activities</th>
                        <th class="text-center" style="width:160px;">Date</th>
                        <th class="text-center" style="width:100px;">View</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        var count = ((Model.Page - 1) * Model.PageSize) + 1;
                    }

                    @foreach (var item in Model.Activities)
                    {
                        <tr>
                            <td class="text-center">@count</td>

                            <td>
                                <a href="/activity/@item.Id"
                                   class="activity-title-link">
                                    @item.Title
                                </a>
                            </td>

                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(item.EventDate)
                                    && DateTime.TryParse(item.EventDate, out var eventDate))
                                {
                                    @eventDate.ToString("dd-MM-yyyy")
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>

                            <td class="text-center">
                                <a href="/activity/@item.Id"
                                   class="btn btn-success btn-sm"
                                   title="View Activity">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>
                        </tr>

                        count++;
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Activities pagination" class="mt-3">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="/Activities?page=@(Model.Page - 1)&year=@Model.SelectedYear">
                            Previous
                        </a>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link"
                               href="/Activities?page=@p&year=@Model.SelectedYear">
                                @p
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="/Activities?page=@(Model.Page + 1)&year=@Model.SelectedYear">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info">
            No activities available.
        </div>
    }
</div>

@section styles {
    <style>
        .activity-list-page {
            padding-bottom: 35px;
        }

        .activity-title-link {
            color: #333;
            font-weight: 600;
            text-decoration: none;
        }

            .activity-title-link:hover {
                color: #007bff;
                text-decoration: underline;
            }

        #activitiesTable th {
            background: #f5f5f5;
        }

        #activitiesTable td {
            vertical-align: middle;
        }
    </style>
}