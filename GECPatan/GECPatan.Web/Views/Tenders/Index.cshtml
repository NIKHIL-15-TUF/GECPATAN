@model GECPatan.Web.Models.TenderViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Tenders";
 
    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//"))
        {
            return path;
        }
        if (string.IsNullOrEmpty(Model.ApiBaseUrl))
        {
            return Url.Content("~/" + path.TrimStart('~', '/'));
        }
        return Model.ApiBaseUrl + "/" + path.TrimStart('~', '/');
    }
}
 
<div class="clearfix"></div>
 
<div class="page_title3 general_title">
    <div class="container">
        <h1>
            Tenders
            <div class="line"></div>
        </h1>
    </div>
</div>
<div class="clearfix margin_bottom6"></div>
 
<div class="content_fullwidth less">
    <div class="featured_section77 two">
        <div class="full-container table-responsive">
            <table class="table table-responsive table-striped table-bordered">
                <thead>
                    <tr>
                        <td class="text-center">Sr No</td>
                        <td>Title</td>
                        <td>Document Title</td>
                        <td class="text-center">Month/Year</td>
                        <td>View</td>
                    </tr>
                </thead>
                <tbody>
                    @{ var srNo = 0; }
                    @foreach (var group in Model.Groups)
                    {
                        srNo++;
                        var firstRow = true;
                        var rowspan = group.Documents.Count;
                        @foreach (var doc in group.Documents)
                        {
                            <tr>
                                @if (firstRow)
                                {
                                    <td rowspan="@rowspan" class="text-center vcenter">@srNo</td>
                                    <td rowspan="@rowspan" class="vcenter">@group.Title</td>
                                    firstRow = false; 
                                }
                                <td>@doc.DocTitle</td>
                                <td class="text-center">@doc.MonthYear</td>
                                <td>
                                    <a href="javascript:void(0)" onclick="loadPdf('@ResolveApiFileUrl(doc.FilePath)','@doc.DocTitle')">
                                        <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                                        @doc.DocTitle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="clearfix margin_bottom6"></div>
 
<a id="lnkPopup" href="#animatedModal" class="popup-trigger hidden" data-target="#popup"></a>
<div id="popup" class="popup">
    <h2 id="newsname"></h2>
    <div id="pdfreader" style="height:600px"></div>
    <span class="popup-btn-close">&times;</span>
</div>
 
@section scripts {
    <script src="@Url.Content("~/js/pdfobject/pdfobject.min.js")"></script>
    <script>
        function loadPdf(path, name) {
        if (path !== '') {
        path = path.replace("~", "");
        if (PDFObject.supportsPDFs) {
        PDFObject.embed(path, "#pdfreader");
        $("#newsname").text(name);
        $("#lnkPopup").click();
        } else {
        window.location.href = path;
        }
        }
        }
    </script>


    <script>
        function popupOpenClose(popup) {

        /* Add div inside popup for layout if one doesn't exist */
        if ($(".wrapper", popup).length == 0) {
        $(popup).wrapInner("<div class='wrapper'></div>");
        }

        /* Open popup */
        $(popup).show();

        /* Close popup if user clicks on background */
        $(popup).click(function (e) {
        if (e.target == this) {
        if ($(popup).is(':visible')) {
        $(popup).hide();
        }
        }
        });

        /* Close popup and remove errors if user clicks on cancel or close buttons */
        $(popup).find(".popup-btn-close").on("click", function () {
        if ($(".formElementError").is(':visible')) {
        $(".formElementError").remove();
        }
        $(popup).hide();
        });
        }

        $(document).ready(function () {
        $(".popup-trigger").on("click", function () {
        var target = $(this).data('target');
        popupOpenClose($(target));
        });
        });
    </script>
}
<link rel="stylesheet" href="@Url.Content("~/css/graph.css")" />