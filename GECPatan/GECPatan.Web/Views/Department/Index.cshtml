@model GECPatan.Web.Models.DepartmentViewModel
@using GECPatan.Web.Models.Dtos
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.Title;

    // Dynamic sections replace the old hard-coded Achievements / NewsLetter /
    // AcademicCalender tabs. Group them by SectionType so the CMS can add new
    // tab types without any front-end change.
    var dynamicSections = Model.DynamicSections
     .Where(s => !string.IsNullOrWhiteSpace(s.Title))
     .OrderBy(s => s.DisplayOrder)
     .ToList();

    string SafeId(string title)
    {
        return "Sec_" + System.Text.RegularExpressions.Regex
            .Replace(title ?? "", @"[^a-zA-Z0-9]", "");
    }

    // The API sometimes returns paths as "images/Faculty/1.jpg", sometimes as
    // "/uploads/timetables/xxx.pdf", and occasionally a full URL. These are
    // files served by GECPatan.Api's static file middleware, not by this Web
    // app, so they must be resolved against Model.ApiBaseUrl -- resolving
    // them with Url.Content("~/...") (as the old view did) points at this
    // app's own host instead and 404s.
    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//"))
        {
            return path;
        }
        if (string.IsNullOrEmpty(Model.ApiBaseUrl))
        {
            // Fall back to this app's own host rather than throwing, so a
            // missing config value degrades to "broken image" instead of a
            // server error.
            return Url.Content("~/" + path.TrimStart('~', '/'));
        }
        return Model.ApiBaseUrl + "/" + path.TrimStart('~', '/');
    }
}

<div class="clearfix"></div>

<div class="page_title3 general_title">
    <div class="full-container">
        <h1>
            @Model.Title
            <div class="line"></div>
        </h1>
    </div>
</div>
<div class="clearfix"></div>

<div class="margin_top10"></div>
<div class="full-container">

    @{
        void RenderTabButtons()
        {
            <button class="tablinks" onclick="openTab(event, 'About')" id="defaultOpen">About</button>
            @if (Model.Vision.Any() && Model.Mission.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'VisionMission')">Vision &amp; Mission</button>
            }
            @if (Model.PEOs.Any() && Model.PSOs.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'PeoPso')">PEOs &amp; PSOs</button>
            }
            @if (Model.Labs.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'Labs')">Labs</button>
            }
            @if (Model.FacultyList.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'Staff')">Faculties And Staff</button>
            }
            @if (Model.TimeTable.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'TimeTable')">Time Table</button>
            }
            @if (Model.NoticeBoard.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'NoticeBoard')">Notice Board</button>
            }
            @if (Model.Activities.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'Activities')">Activities</button>
            }
            @foreach (var sec in dynamicSections)
            {
                var sid = SafeId(sec.Title);

                <button class="tablinks"
                        onclick="openTab(event,'@sid')">
                    @sec.Title
                </button>
            }
        }
    }

    <div class="tab hidden-xs">
        @{ RenderTabButtons(); }
    </div>
    <div class="tab-xs visible-xs">
        @{ RenderTabButtons(); }
    </div>

    <!-- ABOUT -->
    <div id="About" class="tabcontent">
        <div class="full-container">
            <div class="one_half">
                @{ var bannerImages = Model.BannerImages.Where(b => !string.IsNullOrWhiteSpace(b)).ToList(); }
                @if (bannerImages.Any())
                {
                    <div id="owl-demo2" class="owl-carousel">
                        @foreach (var img in bannerImages)
                        {
                            <div><img src="@ResolveApiFileUrl(img)" alt="" class="rimg" onerror="this.parentElement.style.display='none'"></div>
                        }
                    </div>
                }
            </div>
            <!-- end section -->

            <div class="one_half last text-justify">
                <div class="stcode_title5">
                    <h3 class="nmb"><strong>@Model.Title</strong></h3>
                </div>
                <p class="text-justify">@Model.About</p>
                <div class="clearfix marb12"></div>
            </div>
            <!-- end section -->
        </div>

        @if (Model.ShowIntake)
        {
            <div class="margin_top2"></div>
            <div class="parallax_section12">
                <div class="full-container">
                    <div class="counters7 animate" data-anim-type="fadeIn" data-anim-delay="300">
                        <div class="one_fourth">
                            <i class="fa fa-user"></i> <span id="target21">@Model.Intake</span>
                            <h4>Total Intake</h4>
                        </div>
                        <div class="one_fourth">
                            <i class="fa fa-users"></i> <span id="target22">@Model.FacultyList.Count(m => m.IsTeaching)</span>
                            <h4>Faculties Member</h4>
                        </div>
                        <div class="one_fourth last">
                            <i class="fa fa-building"></i> <span id="target25">@Model.Labs.Count</span>
                            <h4>Labs And Workshops</h4>
                        </div>
                        <div class="one_fourth">
                            <i class="fa fa-paper-plane"></i> <span id="target24">@Model.AnnualPlacementCount</span>
                            <h4>Annual Placement</h4>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- VISION & MISSION -->
    <div id="VisionMission" class="tabcontent">
        <div class="featured_section106" style="background-color:white">
            <div style="padding-left:10px;">
                <div class="margin_top2"></div>
                <h2 class="roboto thin">Vision</h2>
                <div class="hsmline7"></div>
                <br><br>
                @foreach (var v in Model.Vision)
                {
                    <h4 class="roboto thin text-justify">@v</h4>
                }

                <div class="clearfix margin_top2"></div>

                <div class="margin_top2"></div>
                <h2 class="roboto thin">Mission</h2>
                <div class="hsmline7"></div>
                <br><br>
                @foreach (var m in Model.Mission)
                {
                    <h4 class="roboto thin text-justify"><i class="fa fa-check"></i> @Html.Raw(m)</h4>
                }
                <div class="margin_top2"></div>
            </div>
        </div>
    </div>

    <!-- PEOs & PSOs -->
    <div id="PeoPso" class="tabcontent">
        @if (Model.PEOs.Any())
        {
            <div class="featured_section106" style="background-color:white">
                <div style="padding-left:10px;">
                    <div class="margin_top2"></div>
                    <h2 class="roboto thin">PROGRAM EDUCATIONAL OBJECTIVES (PEOs)</h2>
                    <div class="hsmline7"></div>
                    <br><br>
                    @foreach (var p in Model.PEOs)
                    {
                        <h4 class="roboto thin text-justify"><i class="fa fa-check"></i> @p</h4>
                    }

                    <div class="clearfix margin_top2"></div>

                    <div class="margin_top2"></div>
                    <h2 class="roboto thin">PROGRAM SPECIFIC OUTCOMES (PSOs)</h2>
                    <div class="hsmline7"></div>
                    <br><br>
                    @foreach (var p in Model.PSOs)
                    {
                        <h4 class="roboto thin text-justify"><i class="fa fa-check"></i> @Html.Raw(p)</h4>
                    }
                    <div class="margin_top2"></div>
                </div>
            </div>
        }
    </div>

    <!-- LABS -->
    <div id="Labs" class="tabcontent">
        @foreach (var lab in Model.Labs.OrderBy(l => l.DisplayOrder))
        {
            var mainImg = lab.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault(); 
            <div class="boxdetail">
                <h2 class="boxtitle">@lab.LabName</h2>

                @if (mainImg != null)
                {
                    <div class="one_third">
                        <img src="@ResolveApiFileUrl(mainImg.ImagePath)" alt="@lab.LabName"
                             onerror="this.style.display='none'" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(lab.About))
                {
                    <div class="two_third last table-responsive">
                        @Html.Raw(lab.About)
                    </div>
                }
                <div class="clearfix"></div>
            </div>
        }
    </div>

    <!-- STAFF -->
    <div id="Staff" class="tabcontent">
        @{
            var teaching = Model.FacultyList.Where(f => f.IsTeaching).OrderBy(f => f.SeniorityOrder).ToList();
            var nonTeaching = Model.FacultyList.Where(f => !f.IsTeaching).OrderBy(f => f.SeniorityOrder).ToList();
        }

        @if (teaching.Any())
        {
            <div class="boxdetails">
                <h3 class="boxtitle" style="font-size:2rem">Teaching Staff</h3>
                <div class="line"></div>
            </div>

            int i = 1;
            foreach (var data in teaching)
            {
                <div class="one_half @(i % 2 == 0 ? "last" : "") animate" data-anim-type="fadeIn" data-anim-delay="300">
                    <div class="faculties_img_div">
                        <img src="@ResolveApiFileUrl(data.ImagePath)" alt="@data.Name" onerror="this.style.display='none'" />
                    </div>
                    <div class="b-portfolio_info col-sm-6">
                        <div class="b-portfolio_info_title f-primary-b f-portfolio_info_title">
                            <a href="#">@data.Name</a>
                        </div>
                        <hr>
                        <div class="b-portfolio_info_description f-portfolio_info_description">
                            <div class="b-information-box f-information-box f-primary-b">
                                <ul>
                                    @if (!string.IsNullOrEmpty(data.Designation))
                                    {
                                        <li><strong>Designation:</strong> @data.Designation</li>
                                    }
                                    @if (!string.IsNullOrEmpty(data.AreaOfInterest))
                                    {
                                        <li><strong>Area Of Interest:</strong> @data.AreaOfInterest</li>
                                    }
                                </ul>
                                @* NOTE: the old "KNOW MORE" faculty-detail popup called a
                                   FacultyDatas API that isn't in the current swagger list.
                                   Re-add it here once a GET /api/faculty/{id}/details
                                   endpoint exists. *@
                            </div>
                        </div>
                    </div>
                </div>
                if (i % 2 == 0)
                {
                    <div class="clearfix margin_top5"></div>
                }
                i++;
            }
            <div class="clearfix margin_top4"></div>
            <div class="clearfix"></div>
        }

        @if (nonTeaching.Any())
        {
            <div class="boxdetails">
                <h3 class="boxtitle" style="font-size:2rem">Non-Teaching Staff</h3>
                <div class="line"></div>
            </div>

            int j = 1;
            foreach (var data in nonTeaching)
            {
                <div class="one_half @(j % 2 == 0 ? "last" : "") animate" data-anim-type="fadeIn" data-anim-delay="300">
                    <div class="faculties_img_div">
                        <img src="@ResolveApiFileUrl(data.ImagePath)" alt="@data.Name" onerror="this.style.display='none'" />
                    </div>
                    <div class="b-portfolio_info col-sm-6">
                        <div class="b-portfolio_info_title f-primary-b f-portfolio_info_title">
                            <a href="#">@data.Name</a>
                        </div>
                        <hr>
                        <div class="b-portfolio_info_description f-portfolio_info_description">
                            <div class="b-information-box f-information-box f-primary-b">
                                <ul>
                                    @if (!string.IsNullOrEmpty(data.Designation))
                                    {
                                        <li><strong>Designation:</strong> @data.Designation</li>
                                    }
                                    @if (!string.IsNullOrEmpty(data.AreaOfInterest))
                                    {
                                        <li><strong>Area Of Interest:</strong> @data.AreaOfInterest</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                if (j % 2 == 0)
                {
                    <div class="clearfix margin_top5"></div>
                }
                j++;
            }
        }
    </div>

    <!-- TIME TABLE -->
    <div id="TimeTable" class="tabcontent">
        <div class="client_logos3 animate fadeIn" data-anim-type="fadeIn" data-anim-delay="300">
            <ul>
                @foreach (var item in Model.TimeTable.Where(t => !string.IsNullOrEmpty(t.FilePath)))
                {
                    var title = $"{item.SemesterType} Sem {item.Semester} ({item.Year})";
                    <li class="minheight">
                        <a href="javascript:void(0)" onclick="loadPdf('@ResolveApiFileUrl(item.FilePath)','@title')">
                            <i class="fa fa-file-pdf-o fabig" aria-hidden="true"></i>
                            @title
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- NOTICE BOARD -->
    <div id="NoticeBoard" class="tabcontent">
        @if (Model.NoticeBoard.Any())
        {
            foreach (var item in Model.NoticeBoard)
            {
                <div class="box">
                    <h2 class="boxtitle">@item.Title</h2>
                    <div class="boxinfo">
                        @if (!string.IsNullOrEmpty(item.PostedBy))
                        {
                            <ul class="post_meta_links">
                                <li class="post_categoty">@item.PostedBy</li>
                            </ul>
                        }
                        <div class="clearfix margin_top1"></div>
                        @Html.Raw(item.Description)
                    </div>
                    <div class="clearfix margin_top1"></div>

                    @if (!string.IsNullOrEmpty(item.FilePath))
                    {
                        <ul class="Activitesfile">
                            <li>
                                @if ((item.FileType ?? "").ToUpper() == "PDF")
                                {
                                    <a href="javascript:void(0)" onclick="loadPdf('@ResolveApiFileUrl(item.FilePath)','@item.Title')">
                                        <i class="fa fa-file-pdf-o" aria-hidden="true"></i> @item.Title
                                    </a>
                                }
                                else
                                {
                                    <a href="@ResolveApiFileUrl(item.FilePath)" download>
                                        <i class="fa @((item.FileType ?? "").ToUpper() == "WORD" ? "fa-file-word-o" : "fa-file-excel-o")" aria-hidden="true"></i>
                                        @item.Title
                                    </a>
                                }
                            </li>
                        </ul>
                    }
                    <div class="clearfix margin_bottom1"></div>

                    @if (!string.IsNullOrWhiteSpace(item.ExternalLink))
                    {
                        <a href="@item.ExternalLink" class="read-more-button" target="_blank">KNOW MORE</a>
                    }
                </div>
                <div class="clearfix margin_bottom1"></div>
            }
        }
        else
        {
            <h2>No Notices Available</h2>
        }
    </div>

    <!-- ACTIVITIES -->
    <div id="Activities" class="tabcontent">
        @if (Model.Activities.Any())
        {
            foreach (var item in Model.Activities.OrderByDescending(m => m.Year))
            {
                <div class="box">
                    <h2 class="boxtitle">@item.Title</h2>
                    <div class="boxinfo">
                        <ul class="post_meta_links">
                            <li class="post_categoty">@item.EventDate</li>
                            <li class="post_categoty">@item.EventTime</li>
                            @if (!string.IsNullOrWhiteSpace(item.Keywords))
                            {
                                foreach (var key in item.Keywords.Split(','))
                                {
                                    <li class="post_categoty">@key</li>
                                }
                            }
                        </ul>
                        <div class="clearfix margin_top1"></div>
                        @Html.Raw(item.Description)
                    </div>

                    @if (item.Images.Count > 1 && !string.IsNullOrEmpty(item.Link))
                    {
                        <a href="@item.Link" target="_blank">
                            <button class="btn btn-outline-primary">More..</button>
                        </a>
                    }

                    <div class="clearfix margin_top1"></div>
                    <ul class="Activitesfile">
                        @foreach (var file in item.Files.Where(f => !string.IsNullOrEmpty(f.FilePath)))
                        {
                            <li>
                                @if ((file.FileType ?? "").ToUpper() == "PDF")
                                {
                                    <a href="javascript:void(0)" onclick="loadPdf('@ResolveApiFileUrl(file.FilePath)','@file.Title')">
                                        <i class="fa fa-file-pdf-o" aria-hidden="true"></i> @file.Title
                                    </a>
                                }
                                else
                                {
                                    <a href="@ResolveApiFileUrl(file.FilePath)" download>
                                        <i class="fa @((file.FileType ?? "").ToUpper() == "WORD" ? "fa-file-word-o" : "fa-file-excel-o")" aria-hidden="true"></i>
                                        @file.Title
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                </div>
                <div class="clearfix margin_bottom1"></div>
            }
        }
        else
        {
            <h2>No Activities Available</h2>
        }
    </div>

    <!-- DYNAMIC SECTIONS (Achievements / Newsletter / Calendar / anything else the CMS adds) -->
    @foreach (var sec in dynamicSections)
    {
        var sid = SafeId(sec.Title);
        <div id="@sid" class="tabcontent">
            <div class="box">
                    @* @if (!string.IsNullOrWhiteSpace(sec.Title))
                    {
                        <h2 class="boxtitle">@Html.Raw(sec.Title)</h2>
                    } *@
                    <div class="boxinfo">
                        @if (!string.IsNullOrWhiteSpace(sec.HtmlContent))
                        {
                            @Html.Raw(sec.HtmlContent)
                        }
                    </div>

                    @{ var secFiles = sec.Files.Where(f => !string.IsNullOrEmpty(f.FilePath)).OrderBy(f => f.DisplayOrder).ToList(); }
                    @if (secFiles.Any())
                    {
                        <ul class="Activitesfile">
                            @foreach (var file in secFiles)
                            {
                                <li>
                                    @if ((file.FileType ?? "").ToUpper() == "PDF")
                                    {
                                        <a href="javascript:void(0)" onclick="loadPdf('@ResolveApiFileUrl(file.FilePath)','@file.Title')">
                                            <i class="fa fa-file-pdf-o" aria-hidden="true"></i> @file.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@ResolveApiFileUrl(file.FilePath)" download>
                                            <i class="fa @((file.FileType ?? "").ToUpper() == "WORD" ? "fa-file-word-o" : "fa-file-excel-o")" aria-hidden="true"></i>
                                            @file.Title
                                        </a>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else if (!string.IsNullOrEmpty(sec.FilePath))
                    {
                         <ul>
                            <li class="minheight">
                                <a href="javascript:void(0)" onclick="loadPdf('@ResolveApiFileUrl(sec.FilePath)','@sec.FileName')">
                                    <i class="fa fa-file-pdf-o fabig" aria-hidden="true"></i>
                                    @sec.FileName
                                </a>
                            </li>
                        </ul>
                    }
                </div>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Tagline))
{
    <div class="clearfix margin_top2"></div>
    <div class="featured_section38">
        <div class="full-container">
            @Html.Raw(Model.Tagline)
        </div>
    </div>
}

<a id="lnkPopup" href="#animatedModal" class="popup-trigger hidden" data-target="#popup"></a>
<div id="popup" class="popup">
    <h2 id="newsname"></h2>
    <div id="pdfreader" style="height:600px"></div>
    <span class="popup-btn-close">&times;</span>
</div>

@section scripts {
    <script src="@Url.Content("~/js/loopslider/jquery.loopslider.js")"></script>
    <script src="@Url.Content("~/js/pdfobject/pdfobject.min.js")"></script>

    <script>
        $(function () {
            $('#slider').loopSlider({
                autoMove: true,
                mouseOnStop: true,
                turn: 9000,
                motion: 'swing',
                delay: 500,
                width: 750,
                height: 400,
                marginLR: 10,
                viewSize: 100,
                viewOverflow: 'visible',
                navPositionBottom: 30,
                navibotton: true,
                navbtnImage: ''
            });
        });
    </script>

    <script>
        (function ($) {
            "use strict";
            function animateCounter(id) {
                var target = $(id).text();
                $(id).animateNumber({
                    number: target,
                    numberStep: function (now, tween) {
                        $(tween.elem).text(Math.floor(now));
                    }
                }, 5000);
            }
            animateCounter('#target21');
            animateCounter('#target22');
            animateCounter('#target24');
            animateCounter('#target25');
        })(jQuery);
    </script>

    <script>
        function loadPdf(path, name) {
        if (path && path.trim() !== '') {

        $("#newsname").text(name);

        popupOpenClose($("#popup"));

        PDFObject.embed(path, "#pdfreader");
        }
        }

        function popupOpenClose(popup) {
            if ($(".wrapper", popup).length == 0) {
                $(popup).wrapInner("<div class='wrapper'></div>");
            }
            $(popup).show();
            $(popup).click(function (e) {
                if (e.target == this && $(popup).is(':visible')) {
                    $(popup).hide();
                    resetPopUpScroll();
                }
            });
            $(popup).find(".popup-btn-close").on("click", function () {
                if ($(".formElementError").is(':visible')) {
                    $(".formElementError").remove();
                }
                $(popup).hide();
                resetPopUpScroll();
            });
        }

        function resetPopUpScroll() {
            $("#pdfreader").scrollTop(0);
        }

        $(document).ready(function () {
            $(".popup-trigger").on("click", function () {
                popupOpenClose($($(this).data('target')));
                resetPopUpScroll();
            });
        });
    </script>
}

@section styles {
    <style>

        .faculties_img_div img {
            margin-right: 0;
            width: 100%;
            margin-bottom: 20px;
            border-radius: 15px;
        }

        #pdfreader {
            max-height: 600px;
            overflow-y: scroll;
            scrollbar-width: thin;
        }

        .read-more-button {
            display: inline-block;
            background-color: #5076bb;
            color: white !important;
            text-align: center;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: bold;
            text-decoration: none;
            border-radius: 5px;
            transition: background 0.3s ease-in-out;
        }

            .read-more-button:hover {
                background-color: #0056b3;
            }

        .Activitesfile > li {
            display: block;
            margin: auto;
            float: left;
            margin-right: 15px;
        }

        /* Labs tab: stacked layout (title bar, full-width image, spec table)
           replacing the old side-by-side one_third/two_third floats, which
           overlapped in print/PDF output. */
        .lab-card {
            border: 1px solid #e5e5e5;
            border-radius: 6px;
            padding: 20px;
            margin-bottom: 20px;
        }

            .lab-card .boxtitle {
                border-left: 5px solid #5076bb;
                padding-left: 12px;
                margin-bottom: 15px;
            }

        .lab-card_image {
            width: 100%;
            margin-bottom: 15px;
        }

            .lab-card_image img {
                width: 100%;
                height: auto;
                display: block;
                border-radius: 4px;
            }

        .lab-card_details table {
            width: 100%;
        }

            .lab-card_details table th,
            .lab-card_details table td {
                padding: 6px 10px;
                border: 1px solid #e5e5e5;
            }
    </style>

    <link rel="stylesheet" href="~/css/graph.css" />
    <link type="text/css" rel="stylesheet" href="@Url.Content("~/js/loopslider/style.css")">
    <link rel="stylesheet" href="@Url.Content("~/css/reset.css")" />
}
