@model GECPatan.Web.Models.ClubDetailsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.Title;
    int count = 1;

    // Uploaded images/files are served by GECPatan.Api's own static file
    // middleware, not by this Web app -- same reasoning as
    // DepartmentViewModel.ApiBaseUrl / ResolveApiFileUrl in Department/Index.cshtml.
    string ResolveApiFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//"))
        {
            return path;
        }
        if (string.IsNullOrEmpty(Model.ApiBaseUrl))
        {
            return Url.Content("~/" + path.TrimStart('~', '/'));
        }
        return Model.ApiBaseUrl + "/" + path.TrimStart('~', '/');
    }
}

<div class="clearfix"></div>

<div class="page_title3 ssip_title" style="background: #999 url('@Url.Content("~/images/ssip_banner.jpg")') no-repeat center top;background-size: cover;">
    <div class="container">
        <h1>
            @Model.Title
            <div class="line"></div>
        </h1>
    </div>
</div>
<div class="clearfix"></div>

<div class="margin_top10"></div>

<div class="full-container">
    @{
        void RenderTabButtons()
        {
            <button class="tablinks" onclick="openTab(event, 'About')" id="defaultOpen">About</button>

            @if (Model.SubObjectives.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'SubObjectives')">Sub Objectives</button>
            }
            @if (Model.Members.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'Members')">Members</button>
            }
            @if (Model.Activities.Any())
            {
                <button class="tablinks" onclick="openTab(event, 'Activities')">Activities</button>
            }
            @if (!string.IsNullOrWhiteSpace(Model.BlogLink))
            {
                <a href="@Model.BlogLink" target="_blank"><button class="tablinks">Blogspot</button></a>
            }
        }
    }

    <div class="tab hidden-xs">
        @{ RenderTabButtons(); }
    </div>
    <div class="tab-xs visible-xs">
        @{ RenderTabButtons(); }
    </div>

    <!-- ABOUT -->
    <div id="About" class="tabcontent">
        <div class="featured_section55 animate" data-anim-type="fadeIn" data-anim-delay="100">
            <div class="full-container">
                @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
                {
                    <div class="container center-block">
                        <img src="@ResolveApiFileUrl(Model.CoverImage)" alt="@Model.Title" class="center-block">
                    </div>
                }
                <div class="clearfix margin_top1"></div>
                <div class="text-justify">
                    <h4 class="color3 margin_bottom2">About @Model.Title</h4>
                    <p class="bigtfont text-justify overflowCommittes">
                        @Html.Raw(Model.About)
                    </p>
                    <div class="clearfix margin_top3"></div>
                </div>
                <!-- end section -->
            </div>
        </div>
    </div>

    <!-- SUB OBJECTIVES -->
    <div id="SubObjectives" class="tabcontent">
        <div class="featured_section106">
            <div class="full-container">
                <div class="margin_top2"></div>
                <h2 class="roboto thin">Sub-Objectives</h2>
                <div class="hsmline7"></div>
                <br><br>
                @foreach (var obj in Model.SubObjectives)
                {
                    <h4 class="roboto thin text-justify"><i class="fa fa-check"></i> @Html.Raw(obj)</h4>
                }
                <div class="margin_top2"></div>
            </div>
        </div>
    </div>

    <!-- MEMBERS -->
    <div id="Members" class="tabcontent">
        <div class="featured_section30">
            <div class="full-container">
                <h1 class="title22 animate" data-anim-type="fadeIn" data-anim-delay="100" style="color: black !important;">
                    Committee Members
                </h1>
                @foreach (var item in Model.Members.OrderBy(m => m.DisplayOrder))
                {
                    <div class="one_half animate @(count % 2 == 0 ? "last" : "")" data-anim-type="fadeIn" data-anim-delay="400">
                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                        {
                            <img src="@ResolveApiFileUrl(item.ImagePath)" alt="@item.Name">
                        }
                        <h5>@item.Name <em>@item.Position</em></h5>
                        <text>@item.Department</text>
                    </div>
                    <!-- end section -->
                    <div class="@(count % 2 == 0 ? "clearfix margin_top5" : "")"></div>
                    count++;
                }
            </div>
        </div>
    </div>

    <!-- ACTIVITIES -->
    <div id="Activities" class="tabcontent">
        @if (Model.Activities.Any())
        {
            foreach (var item in Model.Activities)
            {
                <div class="box">
                    <h2 class="boxtitle">@item.Title</h2>
                    <div class="boxinfo">
                        <ul class="post_meta_links">
                            <li class="post_categoty">@item.EventDate</li>
                            <li class="post_categoty">@item.EventTime</li>
                        </ul>
                        <div class="clearfix margin_top1"></div>
                        @Html.Raw(item.Description)
                    </div>
                    <div class="clearfix margin_top1"></div>
                    <ul class="Activitesfile">
                        @foreach (var file in item.Files)
                        {
                            <li>
                                @if (string.Equals(file.FileType, "PDF", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="javascript:void(0)" onclick="loadPdf('@ResolveApiFileUrl(file.FilePath)','@file.Title')">
                                        <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                                        @file.Title
                                    </a>
                                }
                                else
                                {
                                    <a href="@ResolveApiFileUrl(file.FilePath)" target="_blank" download>
                                        <i class="fa @(string.Equals(file.FileType, "WORD", StringComparison.OrdinalIgnoreCase) ? "fa-file-word-o" : "fa-file-excel-o")" aria-hidden="true"></i>
                                        @file.Title
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                </div>
                <div class="clearfix margin_bottom1"></div>
            }
        }
        else
        {
            <h2>No Activities Available</h2>
        }
    </div>

    @{
        var dynamicSections = Model.DynamicSections
            .Where(s => !string.IsNullOrWhiteSpace(s.HtmlContent) || !string.IsNullOrWhiteSpace(s.FilePath))
            .OrderBy(s => s.DisplayOrder)
            .ToList();
    }
    @foreach (var sec in dynamicSections)
    {
        <div id="@("Sec_" + System.Text.RegularExpressions.Regex.Replace(sec.Title ?? "", @"[^a-zA-Z0-9]", ""))" class="tabcontent">
            <div class="full-container">
                <h2 class="roboto thin">@sec.Title</h2>
                <div class="hsmline7"></div>
                @if (!string.IsNullOrWhiteSpace(sec.HtmlContent))
                {
                    <div class="text-justify">@Html.Raw(sec.HtmlContent)</div>
                }
                @if (!string.IsNullOrWhiteSpace(sec.FilePath))
                {
                    <a href="@ResolveApiFileUrl(sec.FilePath)" target="_blank" download>@(sec.FileName ?? sec.Title)</a>
                }
            </div>
        </div>
    }
</div>

<a id="lnkPopup" href="#animatedModal" class="popup-trigger hidden" data-target="#popup"></a>
<div id="popup" class="popup">
    <div id="pdfreader" style="height:600px"></div>
    <span class="popup-btn-close">&times;</span>
</div>

@section scripts {
    <script src="@Url.Content("~/js/pdfobject/pdfobject.min.js")"></script>
    <script>
        function loadPdf(path, name) {
            if (path !== '') {
                if (PDFObject.supportsPDFs) {
                    PDFObject.embed(path, "#pdfreader");
                    $("#newsname").text(name);
                    $("#lnkPopup").click();
                } else {
                    window.location.href = path;
                }
            }
        }
        function popupOpenClose(popup) {
            if ($(".wrapper", popup).length == 0) {
                $(popup).wrapInner("<div class='wrapper'></div>");
            }
            $(popup).show();
            $(popup).click(function (e) {
                if (e.target == this) {
                    if ($(popup).is(':visible')) {
                        $(popup).hide();
                        resetPopUpScroll();
                    }
                }
            });
            $(popup).find(".popup-btn-close").on("click", function () {
                if ($(".formElementError").is(':visible')) {
                    $(".formElementError").remove();
                }
                $(popup).hide();
                resetPopUpScroll();
            });
        }

        $(document).ready(function () {
            $(".popup-trigger").on("click", function () {
                var target = $(this).data('target');
                popupOpenClose($(target));
                resetPopUpScroll();
            });
        });

        function resetPopUpScroll() {
            $("#pdfreader").scrollTop(0);
        }
    </script>
}

@section styles {
    <style>
        .Activitesfile > li {
            display: block;
            margin: auto;
            float: left;
            margin-right: 15px;
        }
    </style>
    <link rel="stylesheet" href="@Url.Content("~/images/CampusCommittee/Placement/graph.css")" />
}
