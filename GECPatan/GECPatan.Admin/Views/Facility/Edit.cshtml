@model GECPatan.Admin.Models.ViewModels.FacilityVM
@{
    ViewData["Title"] = $"Edit {Model.FacilityType} Page";
    int facilityId = ViewBag.FacilityId;
    int sectionCount = ViewBag.SectionCount;
}
<form asp-action="Edit" asp-route-type="@Model.FacilityType"
      method="post" enctype="multipart/form-data">
 
    <input asp-for="FacilityType" type="hidden" />
 
    <ul class="nav nav-tabs mb-0" id="facilityTabs">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#basic">
                <i class="fas fa-info-circle mr-1"></i>Basic Info
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#vision">
                <i class="fas fa-eye mr-1"></i>Vision & Mission
            </a>
        </li>
    </ul>
 
    <div class="tab-content card" style="border-top:none;border-radius:0 0 8px 8px;">
        <div class="card-body">
 
            <!-- TAB 1: BASIC INFO -->
            <div class="tab-pane fade show active" id="basic">
                <div class="form-group">
                    <label asp-for="Title" class="font-weight-bold"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Tagline" class="font-weight-bold"></label>
                    <input asp-for="Tagline" class="form-control"
                           placeholder="Short tagline..." />
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">About</label>
                    <textarea asp-for="About" class="form-control" rows="6"
                              placeholder="About this facility..."></textarea>
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">Title / Banner Image</label>
                    @if (!string.IsNullOrEmpty(Model.ExistingTitleImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ExistingTitleImagePath" class="img-thumbnail"
                                 style="max-height:100px;" />
                            <small class="text-muted d-block">Current image</small>
                        </div>
                    }
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" name="TitleImage"
                               accept="image/*"
                               onchange="this.nextElementSibling.textContent=this.files[0]?.name||'Choose...'" />
                        <label class="custom-file-label">
                            @(string.IsNullOrEmpty(Model.ExistingTitleImagePath)
                                ? "Choose image..." : "Replace image...")
                        </label>
                    </div>
                </div>
            </div>
 
            <!-- TAB 2: VISION & MISSION -->
            <div class="tab-pane fade" id="vision">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">
                                <i class="fas fa-eye mr-1 text-primary"></i>Vision Statements
                            </label>
                            <small class="text-muted d-block mb-2">One per line</small>
                            <textarea asp-for="VisionItems" class="form-control" rows="8"
                                          placeholder="Vision statement 1&#10;Vision statement 2">
                            </textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">
                                    <i class="fas fa-rocket mr-1 text-success"></i>Mission Statements
                                </label>
                                <small class="text-muted d-block mb-2">One per line</small>
                                <textarea asp-for="MissionItems" class="form-control" rows="8"
                                              placeholder="Mission statement 1&#10;Mission statement 2">
                            </textarea>
                                </div>
                            </div>
                        </div>
                    </div>
 
                </div>
 
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
        <!-- Dynamic Sections -->
        <div class="card mt-3">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0">
                    <i class="fas fa-layer-group mr-2"></i>
                    Custom Sections
                    <span class="badge badge-info ml-2">@sectionCount</span>
                </h6>
                <a asp-controller="DynamicSection" asp-action="Index"
                       asp-route-pageType="3" asp-route-pageId="@facilityId"
                       class="btn btn-primary btn-sm">
                    <i class="fas fa-layer-group mr-2"></i>Manage Sections
                </a>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-0">
                    Add custom sections (Rich Text, PDFs, Image Galleries, File Lists)
                    to this facility page. Sections can be reordered and shown/hidden anytime.
                </p>
            </div>
        </div>
 
        @section Scripts {
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
            <script>
                const activeTab = localStorage.getItem('facilityTab_@Model.FacilityType');
                if (activeTab) $(`a[href="${activeTab}"]`).tab('show');
                $('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
                localStorage.setItem('facilityTab_@Model.FacilityType', $(e.target).attr('href'));
                });
            </script>
        }