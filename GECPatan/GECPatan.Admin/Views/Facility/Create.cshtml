@model GECPatan.Admin.Models.ViewModels.FacilityCreateVM
@{
    ViewData["Title"] = "Add Facility";
}
<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-building mr-2"></i>Add Facility
                </h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <input asp-for="Title" class="form-control"
                               placeholder="e.g. Hostel, Library, Canteen" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Tagline" class="font-weight-bold"></label>
                        <input asp-for="Tagline" class="form-control"
                               placeholder="Short tagline..." />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">About</label>
                        <textarea asp-for="About" class="form-control" rows="4"
                                  placeholder="About this facility..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Title Image</label>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input"
                                           name="TitleImage" accept="image/*"
                                           onchange="this.nextElementSibling.textContent=this.files[0]?.name||'Choose...'" />
                                    <label class="custom-file-label">Choose image...</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                                <input asp-for="DisplayOrder" class="form-control"
                                       type="number" min="0" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save Facility
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-info"></i>Next Steps
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-1">After creating, go to Edit to add:</p>
                <ul class="small text-muted pl-3 mb-0">
                    <li>Vision & Mission statements</li>
                    <li>Members (staff managing facility)</li>
                    <li>Custom Sections (RTE, PDF, Gallery)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
