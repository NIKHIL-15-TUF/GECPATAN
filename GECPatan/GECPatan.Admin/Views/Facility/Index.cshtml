@model List<GECPatan.Admin.Models.ViewModels.FacilityListVM>
@{
    ViewData["Title"] = "Facilities";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count @(Model.Count == 1 ? "Facility" : "Facilities")
        </span>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus mr-2"></i>Add Facility
            </a>
        }
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th width="60">Order</th>
                    <th width="60">Image</th>
                    <th>Name</th>
                    <th width="80">Members</th>
                    <th width="80">Sections</th>
                    <th width="80">Status</th>
                    <th width="260">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fas fa-building fa-2x mb-2 d-block"></i>
                            No facilities yet.
                        </td>
                    </tr>
                }
                @foreach (var f in Model)
                {
                    <tr>
                        <td>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <div class="d-flex flex-column" style="gap:2px;">
                                    <form asp-action="Reorder" method="post">
                                        <input type="hidden" name="id" value="@f.Id" />
                                        <input type="hidden" name="direction" value="up" />
                                        <button type="submit" class="btn btn-xs btn-light border px-2 py-1" title="Move up">
                                            <i class="fas fa-chevron-up" style="font-size:10px;"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Reorder" method="post">
                                        <input type="hidden" name="id" value="@f.Id" />
                                        <input type="hidden" name="direction" value="down" />
                                        <button type="submit" class="btn btn-xs btn-light border px-2 py-1" title="Move down">
                                            <i class="fas fa-chevron-down" style="font-size:10px;"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(f.TitleImagePath))
                            {
                                <img src="@f.TitleImagePath" class="img-thumbnail" alt="@f.Title"
                                     style="width:45px;height:45px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="width:45px;height:45px;border-radius:4px;">
                                    <i class="fas fa-building text-muted"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <strong>@f.Title</strong>
                            @if (!string.IsNullOrEmpty(f.BlogspotLink))
                            {
                                <a href="@f.BlogspotLink" target="_blank" rel="noopener noreferrer"
                                   class="ml-1" title="Open blog">
                                    <i class="fas fa-external-link-alt small"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(f.Tagline))
                            {
                                <small class="text-muted d-block">@f.Tagline</small>
                            }
                        </td>
                        <td>
                            <span class="badge badge-secondary">@f.MemberCount</span>
                        </td>
                        <td>
                            <span class="badge badge-info">@f.SectionCount</span>
                        </td>
                        <td>
                            @if (f.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@f.Id"
                               class="btn btn-sm btn-info mb-1">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Members" asp-route-id="@f.Id"
                               class="btn btn-sm btn-secondary mb-1" title="Members">
                                <i class="fas fa-users"></i>
                            </a>
                            <a asp-controller="DynamicSection" asp-action="Index"
                               asp-route-pageType="3" asp-route-pageId="@f.Id"
                               class="btn btn-sm btn-primary mb-1" title="Sections">
                                <i class="fas fa-layer-group"></i>
                            </a>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(f.IsActive ? "btn-warning" : "btn-success") mb-1"
                                            onclick="return confirm('Toggle status?')">
                                        <i class="fas @(f.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger mb-1"
                                            onclick="return confirm('Delete?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
