@model List<GECPatan.Admin.Models.ViewModels.FacilityListVM>
@{
    ViewData["Title"] = "Facilities";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Facilit(ies)
        </span>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus mr-2"></i>Add Facility
            </a>
        }
    </div>
</div>
<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5 text-muted">
                    <i class="fas fa-building fa-3x mb-3 d-block"></i>
                    No facilities yet.
                </div>
            </div>
        </div>
    }
    @foreach (var f in Model)
    {
        <div class="col-md-4 col-6 mb-3">
            <div class="card h-100 @(!f.IsActive ? "border-secondary" : "")">
                @if (!string.IsNullOrEmpty(f.TitleImagePath))
                {
                    <img src="@f.TitleImagePath" class="card-img-top"
                         style="height:120px;object-fit:cover;" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center"
                         style="height:120px;">
                        <i class="fas fa-building fa-3x text-muted"></i>
                    </div>
                }
                <div class="card-body py-2">
                    <h6 class="card-title mb-1">@f.Title</h6>
                    @if (!string.IsNullOrEmpty(f.Tagline))
                    {
                        <small class="text-muted d-block">@f.Tagline</small>
                    }
                    <div class="mt-1" style="gap:4px;display:flex;flex-wrap:wrap;">
                        <span class="badge badge-secondary">
                            @f.MemberCount members
                        </span>
                        <span class="badge badge-info">
                            @f.SectionCount sections
                        </span>
                        @if (!f.IsActive)
                        {
                            <span class="badge badge-danger">Inactive</span>
                        }
                    </div>
                </div>
                <div class="card-footer py-2">
                    <div class="row" style="gap:4px;margin:0;">
                        <a asp-action="Edit" asp-route-id="@f.Id"
                               class="btn btn-xs btn-info flex-fill">
                            <i class="fas fa-edit mr-1"></i>Edit
                        </a>
                        <a asp-action="Members" asp-route-id="@f.Id"
                               class="btn btn-xs btn-secondary flex-fill">
                            <i class="fas fa-users mr-1"></i>Members
                        </a>
                        <a asp-controller="DynamicSection" asp-action="Index"
                               asp-route-pageType="3" asp-route-pageId="@f.Id"
                               class="btn btn-xs btn-primary flex-fill">
                            <i class="fas fa-layer-group mr-1"></i>Sections
                        </a>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <form asp-action="ToggleActive" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@f.Id" />
                                <button type="submit"
                                        class="btn btn-xs @(f.IsActive ? "btn-warning" : "btn-success")">
                                    <i class="fas @(f.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@f.Id" />
                                <button type="submit" class="btn btn-xs btn-danger"
                                        onclick="return confirm('Delete?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>