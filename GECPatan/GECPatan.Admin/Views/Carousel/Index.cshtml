@model List<GECPatan.Core.Models.Domain.CarouselItem>
@using GECPatan.Core.Models.Domain
@{
    var type = (CarouselType)ViewData["CarouselType"]!;
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h3 style="margin:0;">@ViewData["Title"]</h3>
    <a class="btn btn-primary" asp-action="Create" asp-route-type="@type">Add item</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th style="width:90px;">Order</th>
            <th>Title</th>
            <th>Kind</th>
            <th>Upload date</th>
            <th>Visible</th>
            <th style="width:260px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center">No items yet.</td></tr>
        }
        @foreach (var c in Model)
        {
            <tr>
                <td>
                    <form asp-action="Reorder" asp-route-id="@c.Id" method="post" style="display:inline;">
                        <input type="hidden" name="direction" value="up" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move up">&uarr;</button>
                    </form>
                    <form asp-action="Reorder" asp-route-id="@c.Id" method="post" style="display:inline;">
                        <input type="hidden" name="direction" value="down" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move down">&darr;</button>
                    </form>
                </td>
                <td>@c.Title</td>
                <td>@(c.IsVideo ? "Video" : "Image")</td>
                <td>@(c.UploadDate?.ToString("dd-MM-yyyy"))</td>
                <td>@(c.IsVisible ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    <form asp-action="ToggleVisible" asp-route-id="@c.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(c.IsVisible ? "Hide" : "Show")</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline;"
                          onsubmit="return confirm('Delete this item?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
