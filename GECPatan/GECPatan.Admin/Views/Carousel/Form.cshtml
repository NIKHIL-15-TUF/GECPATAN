@model GECPatan.Admin.Models.ViewModels.CarouselVM
@{
    var isEdit = Model.Id > 0;
}
 
<h3>@ViewData["Title"]</h3>
 
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)"
      method="post" enctype="multipart/form-data" style="max-width:640px;">
 
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
 
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="ExistingImagePath" />
 
    <div class="form-group mb-3">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
 
    <div class="form-group mb-3">
        <label asp-for="UploadDate"></label>
        <input asp-for="UploadDate" class="form-control" type="date" />
    </div>
 
    <div class="form-group mb-3">
        <label>
            <input asp-for="IsVideo" id="IsVideo" /> @Html.DisplayNameFor(m => m.IsVideo)
        </label>
    </div>
 
    <div class="form-group mb-3" id="videoBox">
        <label asp-for="VideoUrl"></label>
        <input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
        <span asp-validation-for="VideoUrl" class="text-danger"></span>
    </div>
 
    <div class="form-group mb-3" id="imageBox">
        <label>Image</label>
        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
        @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
        {
            <small class="text-muted">Current image: @Model.ExistingImagePath (upload a new one to replace it)</small>
        }
        <span class="text-danger field-validation-valid" data-valmsg-for="ImageFile" data-valmsg-replace="true">
            @Html.ValidationMessage("ImageFile")
        </span>
    </div>
 
    <div class="form-group mb-3">
        <label>
            <input asp-for="IsVisible" /> @Html.DisplayNameFor(m => m.IsVisible)
        </label>
    </div>
 
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index" asp-route-type="@Model.Type">Cancel</a>
</form>
 
@section Scripts {
    <script>
        (function () {
            var cb = document.getElementById('IsVideo');
            function sync() {
                document.getElementById('videoBox').style.display = cb.checked ? '' : 'none';
                document.getElementById('imageBox').style.display = cb.checked ? 'none' : '';
            }
            cb.addEventListener('change', sync);
            sync();
        })();
    </script>
}
