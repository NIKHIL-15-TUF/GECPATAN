<!-- ══════════════════════════════════════════════════════════
     SECTION 9 — INFRASTRUCTURE
═══════════════════════════════════════════════════════════ -->
<div class="page-break"></div>
<h3 class="section-title">@Sec(). Infrastructural Information</h3>
 
@{
    void InfraTable(string label,
        List<GECPatan.Admin.Models.ViewModels.InfrastructureRowVM> rows)
    {
        <h4 class="sub-section-title">@label</h4>
        if (rows.Any())
        {
            <table class="disc-table">
                <thead>
                    <tr>
                        <th>Sr.</th>
                        <th>Room Type</th>
                        <th>Area (sq.m)</th>
                        <th>Building Name</th>
                        <th>Department</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int r = 1;
                    }
                    @foreach (var i in rows)
                    {
                        <tr>
                            <td>@r</td>
                            <td>@i.RoomType</td>
                            <td>@i.AreaSqm</td>
                            <td>@i.BuildingName</td>
                            <td>@i.DeptName</td>
                        </tr>
                        r++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty-note">No @label.ToLower() records added.</p>
        }
    }
}
 
@{ InfraTable("Classroom Details", Model.Classrooms); }
@{ InfraTable("Tutorial Rooms", Model.TutorialRooms); }
@{ InfraTable("Laboratories", Model.Laboratories); }
@{ InfraTable("Drawing Halls", Model.DrawingHalls); }
@if (Model.OtherInfra.Any())
{
    InfraTable("Other Infrastructure", Model.OtherInfra);
}
 
@if (!string.IsNullOrWhiteSpace(Model.InfrastructureInfoHtml))
