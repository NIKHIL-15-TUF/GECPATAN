@model GECPatan.Admin.Models.ViewModels.DisclosureDataVM
@{
    Layout = "_DisclosureLayout";
    int secNum = 0;

    string Sec() { secNum++; return secNum.ToString(); }
}
 
@* ── Helper: render one infra sub-table ─────────────────── *@
@functions
{
    string RenderEmpty(string msg)
        => $"<p class=\"empty-note\">{msg}</p>";
}
 
<!-- ══════════════════════════════════════════════════════════
     DOCUMENT HEADER
═══════════════════════════════════════════════════════════ -->
<div class="doc-header">
    <h1>@Model.Institute.Name</h1>
    <h2>Mandatory Disclosure — Academic Year @Model.AcademicYear</h2>
    <div class="meta">
        @Model.Institute.Address<br />
        @if (!string.IsNullOrEmpty(Model.Institute.Phone))
        {
            <text>Phone: @Model.Institute.Phone &nbsp;|&nbsp;</text>
        }
        Email: @Model.Institute.Email<br />
        Affiliated to: @(Model.Institute.AffiliatedTo ?? "—")
        &nbsp;|&nbsp; Approved by: @(Model.Institute.ApprovedBy ?? "—")
    </div>
</div>
 
<!-- ══════════════════════════════════════════════════════════
     SECTION 1 — ABOUT THE INSTITUTE
═══════════════════════════════════════════════════════════ -->
<h3 class="section-title">@Sec(). About the Institute</h3>
@if (!string.IsNullOrWhiteSpace(Model.AboutInstitute))
{
    <div class="narrative-content">@Html.Raw(Model.AboutInstitute)</div>
}
else
{
    <p class="empty-note">About Institute content not added yet.</p>
}
 
<!-- Basic info grid -->
<div class="info-grid">
    <div class="info-row">
        <div class="info-label">Institute Name</div>
        <div class="info-value">@Model.Institute.Name</div>
    </div>
    <div class="info-row">
        <div class="info-label">Established Year</div>
        <div class="info-value">@(Model.Institute.EstablishedYear ?? "—")</div>
    </div>
    <div class="info-row">
        <div class="info-label">Affiliated University</div>
        <div class="info-value">@(Model.Institute.AffiliatedTo ?? "—")</div>
    </div>
    <div class="info-row">
        <div class="info-label">Approved By</div>
        <div class="info-value">@(Model.Institute.ApprovedBy ?? "—")</div>
    </div>
    <div class="info-row">
        <div class="info-label">Address</div>
        <div class="info-value">@(Model.Institute.Address ?? "—")</div>
    </div>
    <div class="info-row">
        <div class="info-label">Phone</div>
        <div class="info-value">@(Model.Institute.Phone ?? "—")</div>
    </div>
    <div class="info-row">
        <div class="info-label">Email</div>
        <div class="info-value">@(Model.Institute.Email ?? "—")</div>
    </div>
</div>
 
<!-- ══════════════════════════════════════════════════════════
     SECTION 2 — GOVERNANCE
═══════════════════════════════════════════════════════════ -->
<div class="page-break"></div>
<h3 class="section-title">@Sec(). Governance</h3>
@foreach (var n in Model.GovernanceNarratives)
{
    <h4 class="sub-section-title">@n.SectionTitle</h4>
    @if (!string.IsNullOrWhiteSpace(n.HtmlContent))
    {
        <div class="narrative-content">@Html.Raw(n.HtmlContent)</div>
    }
    else
    {
        <p class="empty-note">Content not added yet.</p>
    }
}
 
<!-- ══════════════════════════════════════════════════════════
     SECTION 3 — PROGRAMS
═══════════════════════════════════════════════════════════ -->
<div class="page-break"></div>
<h3 class="section-title">@Sec(). Programs</h3>
 
<h4 class="sub-section-title">AICTE Approved Programs</h4>
@if (Model.Programs.Any())
{
    <table class="disc-table">
        <thead>
            <tr>
                <th>Sr.</th>
                <th>Program Name</th>
                <th>Level</th>
                <th>Duration</th>
                <th>Intake (@Model.Programs.First().IntakeYear)</th>
            </tr>
        </thead>
        <tbody>
            @{ int psr = 1; }
            @foreach (var p in Model.Programs)
            {
                <tr>
                    <td>@psr</td>
                    <td>@p.DeptName @(!string.IsNullOrEmpty(p.ShortCode) ? $"({p.ShortCode})" : "")</td>
                    <td>@p.Level</td>
                    <td>@p.Duration</td>
                    <td>@p.Intake</td>
                </tr>
                psr++;
            }
        </tbody>
    </table>
}
else
{
    <p class="empty-note">No programs found.</p>
}
 
<h4 class="sub-section-title">NBA Accreditation Status</h4>
@if (Model.NBAAccreditations.Any())
{
    <table class="disc-table">
        <thead>
            <tr>
                <th>Sr.</th>
                <th>Program Name</th>
                <th>Accredited By</th>
                <th>Valid From</th>
                <th>Valid To</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{ int nsr = 1; }
            @foreach (var n in Model.NBAAccreditations)
            {
                <tr>
                    <td>@nsr</td>
                    <td>@n.ProgramName</td>
                    <td>@(n.AccreditedBy ?? "NBA")</td>
                    <td>@(n.ValidFrom ?? "—")</td>
                    <td>@(n.ValidTo ?? "—")</td>
                    <td>@(n.Status ?? "—")</td>
                </tr>
                nsr++;
            }
        </tbody>
    </table>
}
else
{
    <p class="empty-note">No NBA accreditation records added.</p>
}
@if (!string.IsNullOrWhiteSpace(Model.StudentToFacultyRatioHtml))
{
    <h4 class="sub-section-title">Student to Faculty Ratio Details</h4>
    <div class="narrative-content">@Html.Raw(Model.StudentToFacultyRatioHtml)</div>
}
 
@if (!string.IsNullOrWhiteSpace(Model.AccreditationStatusHtml))
{
    <h4 class="sub-section-title">Additional Accreditation Information</h4>
    <div class="narrative-content">@Html.Raw(Model.AccreditationStatusHtml)</div>
}
 
<!-- ══════════════════════════════════════════════════════════
     SECTION 4 — CUTOFF RANKS
═══════════════════════════════════════════════════════════ -->
<div class="page-break"></div>
<h3 class="section-title">@Sec(). Admission Cutoff (Closing Ranks)</h3>
@foreach (var dept in Model.DeptCutoffs)
{
    <h4 class="dept-title">
        @dept.Name @(!string.IsNullOrEmpty(dept.ShortCode) ? $"({dept.ShortCode})" : "")
    </h4>
    @if (dept.CutoffHistory.Any())
    {
        <table class="disc-table">
            <thead>
                <tr>
                    <th>Academic Year</th>
                    <th>General</th>
                    <th>SEBC</th>
                    <th>SC</th>
                    <th>ST</th>
                    <th>EWS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in dept.CutoffHistory)
                {
                    <tr>
                        <td>@c.AcademicYear</td>
                        <td>@c.General</td>
                        <td>@c.SEBC</td>
                        <td>@c.SC</td>
                        <td>@c.ST</td>
                        <td>@c.EWS</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty-note">No cutoff records for this department.</p>
    }
}
 
<!-- ══════════════════════════════════════════════════════════
     SECTION 5 — PLACEMENT
═══════════════════════════════════════════════════════════ -->
<div class="page-break"></div>
<h3 class="section-title">@Sec(). Placement</h3>
 
<h4 class="sub-section-title">Placement Facilities</h4>
@if (!string.IsNullOrWhiteSpace(Model.PlacementFacilitiesHtml))
{
    <div class="narrative-content">@Html.Raw(Model.PlacementFacilitiesHtml)</div>
}
else
{
    <p class="empty-note">Placement facilities content not added yet.</p>
}
 
<h4 class="sub-section-title">Placement Statistics</h4>
@if (Model.PlacementData.Any())
{
    <table class="disc-table">
        <thead>
            <tr>
                <th>Sr. No.</th>
                <th>Department</th>
                <th>Academic Year</th>
                <th>No. of Companies</th>
                <th>No. of Students Placed</th>
                <th>Maximum Salary Offered</th>
                <th>Minimum Salary Offered</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sr = 1;
                var grouped = Model.PlacementData
                    .GroupBy(x => x.DepartmentName);
            }

            @foreach (var dept in grouped)
            {
                var rows = dept.ToList();

                for (int i = 0; i < rows.Count; i++)
                {
                    <tr>
                        @if (i == 0)
                        {
                            <td rowspan="@rows.Count">@sr</td>
                            <td rowspan="@rows.Count">@dept.Key</td>
                        }

                        <td>@rows[i].AcademicYear</td>
                        <td>@rows[i].NoOfCompanies</td>
                        <td>@rows[i].TotalPlaced</td>
                        <td>@(rows[i].MaximumSalary ?? "NA")</td>
                        <td>@(rows[i].MinimumSalary ?? "NA")</td>
                    </tr>
                }

                sr++;
            }
        </tbody>
    </table>
}
else
{
    <p class="empty-note">No placement data added yet.</p>
}
 
<h4 class="sub-section-title">Foreign Collaboration Details</h4>
@if (!string.IsNullOrWhiteSpace(Model.ForeignCollaborationHtml))
{
    <div class="narrative-content">@Html.Raw(Model.ForeignCollaborationHtml)</div>
}
else
{
    <p class="empty-note">Foreign collaboration content not added yet.</p>
}
 
<!-- ══════════════════════════════════════════════════════════
     SECTION 6 — FACULTY
═══════════════════════════════════════════════════════════ -->
<div class="page-break"></div>
<h3 class="section-title">@Sec(). Faculty Details</h3>
 
@* Principal First *@
@if (Model.Principal != null)
{
    <h4 class="sub-section-title">Principal</h4>
    <div class="info-grid">
        <div class="info-row">
            <div class="info-label">Name</div>
            <div class="info-value">@Model.Principal.Name</div>
        </div>
        <div class="info-row">
            <div class="info-label">Designation</div>
            <div class="info-value">@(Model.Principal.Designation ?? "—")</div>
        </div>
        <div class="info-row">
            <div class="info-label">Qualifications</div>
            <div class="info-value">
                @(Model.Principal.Qualifications.Any()
                    ? string.Join(", ", Model.Principal.Qualifications)
                    : "—")
            </div>
        </div>
        <div class="info-row">
            <div class="info-label">Email</div>
            <div class="info-value">@(Model.Principal.Email ?? "—")</div>
        </div>
        <div class="info-row">
            <div class="info-label">Contact</div>
            <div class="info-value">@(Model.Principal.Contact ?? "—")</div>
        </div>
    </div>
}
 
@* Department-wise Faculty *@
@foreach (var dept in Model.DeptFaculty)
{
    <div class="page-break"></div>
    <h4 class="dept-title">@dept.DeptName — Faculty</h4>
 
    @* Summary Table *@
    <strong style="font-size:11pt;">Faculty List</strong>
    <table class="disc-table" style="margin-top:6px;">
        <thead>
            <tr>
                <th>Sr. No.</th>
                <th>Name</th>
                <th>Post</th>
                <th>Approval Status</th>
                <th>Letter Number</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in dept.SummaryTable)
            {
                <tr>
                    <td>@row.SrNo</td>
                    <td>@row.Name</td>
                    <td>@row.Post</td>
                    <td>@(row.ApprovalStatus ?? "Approved")</td>
                    <td>@(row.LetterNumber ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
 
    @* Individual Profile Cards *@
    @foreach (var f in dept.Faculty)
    {
        <div style="border:1px solid #999;margin:16px 0;
                    page-break-inside:avoid;">
            <table class="disc-table mb-0"
                   style="font-size:10.5pt;">
                <colgroup>
                    <col style="width:30px;" />
                    <col style="width:180px;" />
                    <col />
                </colgroup>
                <tbody>
                    <tr>
                        <td class="text-center font-weight-bold">1</td>
                        <td class="font-weight-bold">Name</td>
                        <td>
                            <div style="display:flex;justify-content:space-between;">
                                <strong>@f.Name</strong>
                                @if (!string.IsNullOrEmpty(f.ImagePath))
                                {
                                    <img src="@f.ImagePath"
                                         style="width:70px;height:85px;
                                                object-fit:cover;border:1px solid #ccc;" />
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">2</td>
                        <td class="font-weight-bold">Post</td>
                        <td>@f.Designation</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">3</td>
                        <td class="font-weight-bold">Email</td>
                        <td>@(f.Email ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">4</td>
                        <td class="font-weight-bold">Date of Birth</td>
                        <td>@(f.DateOfBirth ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">5</td>
                        <td class="font-weight-bold">Educational Qualification</td>
                        <td>@(string.IsNullOrEmpty(f.Qualifications) ? "—" : f.Qualifications)</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">6</td>
                        <td class="font-weight-bold">Webpage</td>
                        <td>@(f.Website ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">7</td>
                        <td class="font-weight-bold">Work Experience</td>
                        <td>
                            <table class="disc-table mb-2" style="font-size:10pt;">
                                <tr><td style="width:100px;">Teaching</td>
                                    <td>@f.TeachingYears Years</td></tr>
                                <tr><td>Research</td><td>—</td></tr>
                                <tr><td>Industry</td><td>—</td></tr>
                                <tr><td>Others</td><td>—</td></tr>
                            </table>
                            @if (f.Experiences.Any())
                            {
                                <strong>Details:</strong>
                                <table class="disc-table mt-1" style="font-size:10pt;">
                                    <thead>
                                        <tr>
                                            <th>Sr.</th>
                                            <th>Institute</th>
                                            <th>Period</th>
                                            <th>Experience</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int esr = 1; }
                                        @foreach (var e in f.Experiences)
                                        {
                                            <tr>
                                                <td>@esr</td>
                                                <td>@e.Organization</td>
                                                <td>@e.Period</td>
                                                <td>@e.Duration</td>
                                            </tr>
                                            esr++;
                                        }
                                    </tbody>
                                </table>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">8</td>
                        <td class="font-weight-bold">Area of Specializations</td>
                        <td>@(f.AreaOfInterest ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">9</td>
                        <td class="font-weight-bold">Subjects at UG Level</td>
                        <td>@(f.UGSubjects.Any() ? string.Join(", ", f.UGSubjects) : "—")</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">10</td>
                        <td class="font-weight-bold">Subjects at PG Level</td>
                        <td>@(f.PGSubjects.Any() ? string.Join(", ", f.PGSubjects) : "—")</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">11</td>
                        <td class="font-weight-bold">Research Guidance</td>
                        <td>
                            <table class="disc-table" style="font-size:10pt;">
                                <thead>
                                    <tr><th></th><th>Ongoing</th><th>Completed</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Master's Degree</td>
                                        <td>@f.MastersOngoing</td>
                                        <td>@f.MastersCompleted</td>
                                    </tr>
                                    <tr>
                                        <td>Ph.D.</td>
                                        <td>@f.PhDOngoing</td>
                                        <td>@f.PhDCompleted</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">12</td>
                        <td class="font-weight-bold">Research Papers Published</td>
                        <td>
                            @{
                                var intl = f.Publications.Where(p => p.Type == "International").ToList();
                                var natl = f.Publications.Where(p => p.Type == "National").ToList();
                                var conf = f.Publications.Where(p => p.Type == "Conference").ToList();
                            }
                            <table class="disc-table mb-2" style="font-size:10pt;">
                                <thead>
                                    <tr><th>Category</th><th>Total</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>National Journals</td><td>@natl.Count</td></tr>
                                    <tr><td>International Journals</td><td>@intl.Count</td></tr>
                                    <tr><td>Conferences</td><td>@conf.Count</td></tr>
                                </tbody>
                            </table>
                            @if (intl.Any())
                            {
                                <strong>Published in International Journal</strong>
                                <table class="disc-table mt-1" style="font-size:9.5pt;">
                                    <thead>
                                        <tr>
                                            <th>Sr.</th>
                                            <th>Paper Title</th>
                                            <th>Journal</th>
                                            <th>Year</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in intl)
                                        {
                                            <tr>
                                                <td>@p.SrNo</td>
                                                <td>
                                                    @p.Title
                                                    @if (!string.IsNullOrEmpty(p.CoAuthors))
                                                    {
                                                        <br />
                                                        <small class="text-muted">Co-Authors: @p.CoAuthors</small>
                                                    }
                                                </td>
                                                <td>@(p.Journal ?? "—")</td>
                                                <td>@(p.Year ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (natl.Any())
                            {
                                <strong>Published in National Journal</strong>
                                <table class="disc-table mt-1" style="font-size:9.5pt;">
                                    <thead>
                                        <tr><th>Sr.</th><th>Paper Title</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in natl)
                                        {
                                            <tr><td>@p.SrNo</td><td>@p.Title</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (conf.Any())
                            {
                                <strong>Conference Papers</strong>
                                <table class="disc-table mt-1" style="font-size:9.5pt;">
                                    <thead>
                                        <tr><th>Sr.</th><th>Paper Title</th><th>Conference</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in conf)
                                        {
                                            <tr>
                                                <td>@p.SrNo</td>
                                                <td>@p.Title</td>
                                                <td>@(p.Journal ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">13</td>
                        <td class="font-weight-bold">No. of Consultancy Projects</td>
                        <td>@f.ConsultancyCount</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">14</td>
                        <td class="font-weight-bold">Patents</td>
                        <td>
                            @if (f.Patents.Any())
                            {
                                <table class="disc-table" style="font-size:10pt;">
                                    <thead>
                                        <tr>
                                            <th>Title</th>
                                            <th>Application No.</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in f.Patents)
                                        {
                                            <tr>
                                                <td>@p.Title</td>
                                                <td>@(p.ApplicationNo ?? "—")</td>
                                                <td>@p.Status</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else { <span>—</span> }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">15</td>
                        <td class="font-weight-bold">Books Published</td>
                        <td>
                            @if (f.Books.Any())
                            {
                                <table class="disc-table" style="font-size:10pt;">
                                    <thead>
                                        <tr>
                                            <th>Sr.</th>
                                            <th>Title</th>
                                            <th>Publisher</th>
                                            <th>Year</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var b in f.Books)
                                        {
                                            <tr>
                                                <td>@b.SrNo</td>
                                                <td>@b.Title</td>
                                                <td>@(b.Publisher ?? "—")</td>
                                                <td>@(b.Year ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <table class="disc-table" style="font-size:10pt;">
                                    <tr>
                                        <td>Sr. No.</td><td>Title</td>
                                        <td>Publisher</td><td>Year</td>
                                    </tr>
                                    <tr><td>—</td><td>—</td><td>—</td><td>—</td></tr>
                                </table>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">16</td>
                        <td class="font-weight-bold">Training</td>
                        <td>
                            @if (f.Trainings.Any())
                            {
                                <table class="disc-table" style="font-size:10pt;">
                                    <thead>
                                        <tr><th>Sr.</th><th>Training Title</th></tr>
                                    </thead>
                                    <tbody>
                                        @{ int tsr = 1; }
                                        @foreach (var t in f.Trainings)
                                        {
                                            <tr><td>@tsr</td><td>@t</td></tr>
                                            tsr++;
                                        }
                                    </tbody>
                                </table>
                            }
                            else { <span>—</span> }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">17</td>
                        <td class="font-weight-bold">Seminars / Workshops</td>
                        <td>
                            @if (f.Seminars.Any())
                            {
                                <table class="disc-table" style="font-size:10pt;">
                                    <thead>
                                        <tr><th>Sr.</th><th>Title</th></tr>
                                    </thead>
                                    <tbody>
                                        @{ int ssr = 1; }
                                        @foreach (var s in f.Seminars)
                                        {
                                            <tr><td>@ssr</td><td>@s</td></tr>
                                            ssr++;
                                        }
                                    </tbody>
                                </table>
                            }
                            else { <span>—</span> }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">18</td>
                        <td class="font-weight-bold">Membership</td>
                        <td>
                            @if (f.Memberships.Any())
                            {
                                <table class="disc-table" style="font-size:10pt;">
                                    <thead>
                                        <tr>
                                            <th>Sr.</th>
                                            <th>Community / Body</th>
                                            <th>Type</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int msr = 1; }
                                        @foreach (var m in f.Memberships)
                                        {
                                            <tr>
                                                <td>@msr</td>
                                                <td>@m.Community</td>
                                                <td>@m.MembershipType</td>
                                            </tr>
                                            msr++;
                                        }
                                    </tbody>
                                </table>
                            }
                            else { <span>—</span> }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
}
 
