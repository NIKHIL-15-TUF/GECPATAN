@model GECPatan.Admin.Models.ViewModels.UserEditVM
@{
    ViewData["Title"] = "Edit User";
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title mb-0">
                    <i class="fas fa-user-edit mr-2"></i>Edit User
                </h3>
            </div>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input asp-for="Id" type="hidden" />
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
 
                    <!-- View only fields -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Email</label>
                                <input value="@Model.Email" class="form-control bg-light"
                                       readonly />
                                <small class="text-muted">
                                    <i class="fas fa-lock mr-1"></i>Cannot be changed
                                </small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Role</label>
                                <input value="@Model.Role" class="form-control bg-light"
                                       readonly />
                                <small class="text-muted">
                                    <i class="fas fa-lock mr-1"></i>Cannot be changed
                                </small>
                            </div>
                        </div>
                    </div>
 
                    <div class="form-group">
                        <label asp-for="FullName" class="font-weight-bold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
 
                    <!-- Assignment dropdowns based on role -->
                    @if (Model.Role == "HOD")
                    {
                        <div class="form-group">
                            <label class="font-weight-bold">Department</label>
                            <select asp-for="DeptId" asp-items="Model.Departments"
                                    class="form-control">
                                <option value="">-- Select Department --</option>
                            </select>
                        </div>
                    }
                    @if (Model.Role == "CommitteeHead")
                    {
                        <div class="form-group">
                            <label class="font-weight-bold">Committee</label>
                            <select asp-for="CommitteeId" asp-items="Model.Committees"
                                    class="form-control">
                                <option value="">-- Select Committee --</option>
                            </select>
                        </div>
                    }
                    @if (Model.Role == "Faculty")
                    {
                        <div class="form-group">
                            <label class="font-weight-bold">Faculty Profile</label>
                            <select asp-for="FacultyId" asp-items="Model.Faculties"
                                    class="form-control">
                                <option value="">-- Select Faculty Profile --</option>
                            </select>
                        </div>
                    }
 
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <div class="custom-control custom-switch">
                                    <input asp-for="IsActive" type="checkbox"
                                           class="custom-control-input" id="isActive" />
                                    <label class="custom-control-label" for="isActive">
                                        Account Active
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <div class="custom-control custom-switch">
                                    <input asp-for="MustChangePassword" type="checkbox"
                                           class="custom-control-input"
                                           id="mustChange" />
                                    <label class="custom-control-label" for="mustChange">
                                        Force Password Change on Next Login
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}