@model List<GECPatan.Admin.Models.ViewModels.ProgramIntakeIndexVM>
@{
    ViewData["Title"] = "Program Intake";
}
 
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge badge-info px-3 py-2" style="font-size:13px;">
                @Model.Count Department(s)
            </span>
            <span class="badge badge-success ml-2 px-2 py-1">
                Total Intake: @Model.Sum(d => d.LatestIntake) seats
            </span>
        </div>
    </div>
</div>
 
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th>Department</th>
                    <th width="150" class="text-center">
                        Latest Year
                    </th>
                    <th width="150" class="text-center">
                        Current Intake
                    </th>
                    <th width="150" class="text-center">
                        History
                    </th>
                    <th width="150">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td>
                            <strong>@dept.DeptName</strong>
                        </td>
                        <td class="text-center">
                            @if (dept.LatestYear > 0)
                            {
                                <span class="badge badge-secondary px-2 py-1">
                                    @dept.LatestYear
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Not set</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (dept.LatestIntake > 0)
                            {
                                <span class="badge badge-success px-3 py-1"
                                      style="font-size:14px;">
                                    @dept.LatestIntake
                                    <small style="font-size:10px;">seats</small>
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-warning px-2 py-1">
                                    Not configured
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge badge-light border">
                                @dept.Intakes.Count year(s)
                            </span>
                        </td>
                        <td>
                            <a asp-action="Department"
                                   asp-route-deptId="@dept.DeptId"
                                   class="btn btn-sm btn-primary">
                                <i class="fas fa-edit mr-1"></i>
                                Manage Intake
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>