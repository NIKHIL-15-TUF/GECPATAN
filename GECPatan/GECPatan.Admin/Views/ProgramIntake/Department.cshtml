@model GECPatan.Admin.Models.ViewModels.ProgramIntakeIndexVM
@{
    ViewData["Title"] = "Intake — " + Model.DeptName;
    var addVM = ViewBag.AddVM as GECPatan.Admin.Models.ViewModels.ProgramIntakeFormVM;
}
 
<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Program Intake</h5>
        <small class="text-muted">@Model.DeptName</small>
    </div>
</div>
 
<div class="row">
 
    <!-- Add New Intake -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add New Year
                </h6>
            </div>
            <form asp-action="Add" method="post">
                <div class="card-body">
                    <input type="hidden" name="DeptId" value="@Model.DeptId" />
 
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Academic Year <span class="text-danger">*</span>
                        </label>
                        <input name="IntakeYear" class="form-control"
                               type="number" min="2000" max="2100"
                               value="@(addVM?.IntakeYear ?? DateTime.Now.Year)"
                               placeholder="e.g. 2025" />
                        <small class="text-muted">
                            Enter the year intake starts
                            (e.g. 2025 for 2025-26 batch)
                        </small>
                    </div>
 
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Intake (Seats) <span class="text-danger">*</span>
                        </label>
                        <input name="Intake" class="form-control"
                               type="number" min="1" max="1000"
                               value="@(addVM?.Intake ?? 60)"
                               placeholder="e.g. 60" />
                    </div>
 
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" name="IsVisible"
                                   value="true"
                                   class="custom-control-input"
                                   id="isVisible" checked />
                            <label class="custom-control-label"
                                   for="isVisible">
                                Show on website
                            </label>
                        </div>
                    </div>
 
                    <div class="alert alert-info py-2 mb-0">
                        <small>
                            <i class="fas fa-info-circle mr-1"></i>
                            Only the <strong>most recent year</strong>
                            is shown on the website. Older entries
                            are kept as history.
                        </small>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add Intake Year
                    </button>
                </div>
            </form>
        </div>
    </div>
 
    <!-- Intake History -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-light d-flex
                justify-content-between align-items-center">
                <h6 class="card-title mb-0">
                    <i class="fas fa-history mr-2"></i>
                    Intake History (@Model.Intakes.Count records)
                </h6>
                @if (Model.LatestIntake > 0)
                {
                    <div>
                        <span class="badge badge-success px-2 py-1"
                              style="font-size:12px;">
                            Current: @Model.LatestIntake seats
                            (@Model.LatestYear)
                        </span>
                    </div>
                }
            </div>
            <div class="card-body p-0">
                @if (!Model.Intakes.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-graduation-cap fa-2x mb-2 d-block"></i>
                        No intake data yet.
                        Add your first entry using the form.
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Academic Year</th>
                                <th class="text-center" width="120">
                                    Intake
                                </th>
                                <th width="100" class="text-center">
                                    Status
                                </th>
                                <th width="80" class="text-center">
                                    Visible
                                </th>
                                <th width="160">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Intakes)
                            {
                                <tr class="@(row.IsLatest ? "table-success" : "")">
                                    <td>
                                        <strong>@row.IntakeYear</strong>
                                        <small class="text-muted">
                                            (@row.IntakeYear - @(row.IntakeYear + 1))
                                        </small>
                                        @if (row.IsLatest)
                                        {
                                            <span class="badge badge-success ml-1"
                                                  style="font-size:9px;">
                                                Current
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (row.IsLatest)
                                        {
                                            <!-- Inline edit for latest only -->
                                            <form asp-action="Edit"
                                                  method="post"
                                                  class="d-flex"
                                                  style="gap:4px;
                                                justify-content:center;">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@row.Id" />
                                                <input type="number"
                                                       name="intake"
                                                       class="form-control
                                                form-control-sm"
                                                       style="width:80px;"
                                                       value="@row.Intake"
                                                       min="1" max="1000" />
                                                <button type="submit"
                                                        class="btn btn-xs
                                                    btn-success"
                                                        title="Save">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="font-weight-bold">
                                                @row.Intake
                                            </span>
                                            <small class="text-muted">seats</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (row.IsLatest)
                                        {
                                            <span class="badge badge-success"
                                                  style="font-size:9px;">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary"
                                                  style="font-size:9px;">
                                                History
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleVisible"
                                              method="post" class="d-inline">
                                            <input type="hidden"
                                                   name="id"
                                                   value="@row.Id" />
                                            <button type="submit"
                                                    class="btn btn-xs @(row.IsVisible ? "btn-success" : "btn-secondary")"
                                                    title="@(row.IsVisible ? "Visible" : "Hidden")">
                                                <i class="fas @(row.IsVisible ? "fa-eye" : "fa-eye-slash")"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td>
                                        @if (row.IsLatest)
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-pencil-alt mr-1"></i>
                                                Edit inline above
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-lock mr-1"></i>
                                                History — read only
                                            </small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
 
        <!-- Info card -->
        <div class="card mt-3 border-info">
            <div class="card-body py-2">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1 text-info"></i>
                    <strong>Rules:</strong>
                    Only the latest year is shown on the public website.
                    Older entries cannot be edited — they are kept as
                    historical records. To correct a mistake in the
                    latest entry, use the inline edit above.
                </small>
            </div>
        </div>
    </div>
</div>