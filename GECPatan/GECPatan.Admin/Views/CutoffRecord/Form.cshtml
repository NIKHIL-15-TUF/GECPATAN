@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Cutoff Record" : "Add Cutoff Record";
}
@model GECPatan.Admin.Models.ViewModels.CutoffRecordVM
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h3 class="card-title mb-0">
            <i class="fas fa-graduation-cap mr-2"></i>@ViewData["Title"]
        </h3>
    </div>
    <form asp-action="@(isEdit?"Edit":"Create")" method="post">
        @if (isEdit)
        {
            <input asp-for="Id" type="hidden" />
        }
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    @Html.ValidationSummary(false)
                </div>
            }
 
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DeptId" class="font-weight-bold"></label>
                        <select asp-for="DeptId" asp-items="Model.Departments"
                                class="form-control">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DeptId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AcademicYear" class="font-weight-bold"></label>
                        <input asp-for="AcademicYear" class="form-control"
                               placeholder="e.g. 2025-26" />
                        <span asp-validation-for="AcademicYear" class="text-danger small"></span>
                    </div>
                </div>
            </div>
 
            <hr />
            <p class="text-muted small mb-2">
                Leave blank if no admission happened in that category for this year.
            </p>
 
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="GeneralRank" class="font-weight-bold"></label>
                        <input asp-for="GeneralRank" class="form-control" type="number" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="SEBCRank" class="font-weight-bold"></label>
                        <input asp-for="SEBCRank" class="form-control" type="number" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="SCRank" class="font-weight-bold"></label>
                        <input asp-for="SCRank" class="form-control" type="number" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="STRank" class="font-weight-bold"></label>
                        <input asp-for="STRank" class="form-control" type="number" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="EWSRank" class="font-weight-bold"></label>
                        <input asp-for="EWSRank" class="form-control" type="number" />
                    </div>
                </div>
            </div>
 
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group mt-4">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">Visible</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left mr-2"></i>Back
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>Save
            </button>
        </div>
    </form>
</div>
