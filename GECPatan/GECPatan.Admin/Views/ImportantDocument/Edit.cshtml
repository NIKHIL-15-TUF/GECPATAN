@model DocumentPageVM
@{
    ViewData["Title"] = ViewData["Title"] ?? "Edit Document Page";
}
<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-folder-open mr-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="ExistingBannerPath" type="hidden" />
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <input asp-for="Title" class="form-control" placeholder="Page title, e.g. AICTE Approvals" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Title Banner Image</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingBannerPath))
                        {
                            <div class="mb-2">
                                <img src="@Url.Content(Model.ExistingBannerPath)" alt="Current banner"
                                     style="max-height:120px;border:1px solid #ddd;border-radius:4px;" />
                                <div class="custom-control custom-checkbox mt-1">
                                    <input asp-for="RemoveBanner" type="checkbox" class="custom-control-input" id="removeBanner" />
                                    <label class="custom-control-label text-danger" for="removeBanner">Remove current banner</label>
                                </div>
                            </div>
                        }
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="titleBannerImage"
                                   name="TitleBannerImage" accept=".jpg,.jpeg,.png,.webp" />
                            <label class="custom-file-label" for="titleBannerImage">
                                @(string.IsNullOrEmpty(Model.ExistingBannerPath) ? "Choose banner image..." : "Replace banner image...")
                            </label>
                        </div>
                        <small class="form-text text-muted">Uploading a new image replaces the current banner (the remove checkbox is ignored in that case).</small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold d-block">Display Layout</label>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="layoutList" name="TableView" value="false"
                                   class="custom-control-input" checked="@(!Model.TableView)" />
                            <label class="custom-control-label" for="layoutList">List View</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="layoutTable" name="TableView" value="true"
                                   class="custom-control-input" checked="@Model.TableView" />
                            <label class="custom-control-label" for="layoutTable">Table View</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold d-block">
                            Group documents by year?
                            <span class="badge badge-warning ml-1"><i class="fas fa-lock mr-1"></i>Locked</span>
                        </label>
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="hasYearSectionsDisplay"
                                   checked="@Model.HasYearSections" disabled />
                            <label class="custom-control-label" for="hasYearSectionsDisplay">
                                @(Model.HasYearSections ? "Yes — Year-Grouped" : "No — Direct Uploads")
                            </label>
                        </div>
                        <small class="form-text text-muted">
                            Year grouping mode is permanently set at creation and cannot be modified.
                        </small>
                    </div>

                    <div class="form-group">
                        <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">Visible on website</label>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).on('change', '#titleBannerImage', function () {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').text(fileName || 'Choose banner image...');
            // Uploading a replacement supersedes the "remove" checkbox — uncheck it for clarity.
            if (fileName) { $('#removeBanner').prop('checked', false); }
        });
    </script>
}
