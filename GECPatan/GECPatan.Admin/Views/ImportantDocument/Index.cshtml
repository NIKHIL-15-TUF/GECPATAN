@model List<DocumentCategoryVM>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Documents";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Categor@(Model.Count == 1 ? "y" : "ies")
        </span>
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#addCategoryModal">
            <i class="fas fa-plus mr-2"></i>Add Category
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th width="60">Order</th>
                    <th>Title</th>
                    <th class="text-center" width="90">Years</th>
                    <th class="text-center" width="90">Files</th>
                    <th class="text-center" width="90">Status</th>
                    <th class="text-center" width="220">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                            No document categories yet.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var cat in Model.OrderBy(c => c.DisplayOrder))
                    {
                        <tr>
                            <td>@cat.DisplayOrder</td>
                            <td>
                                <a asp-action="YearSections" asp-route-categoryId="@cat.Id"><strong>@cat.Title</strong></a>
                            </td>
                            <td class="text-center"><span class="badge badge-secondary">@cat.YearCount</span></td>
                            <td class="text-center"><span class="badge badge-secondary">@cat.FileCount</span></td>
                            <td class="text-center">
                                <form asp-action="ToggleVisible" asp-route-id="@cat.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(cat.IsVisible ? "btn-success" : "btn-secondary")">
                                        <i class="fas @(cat.IsVisible ? "fa-eye" : "fa-eye-slash")"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                <a asp-action="YearSections" asp-route-categoryId="@cat.Id" class="btn btn-sm btn-secondary mb-1" title="Manage Years">
                                    <i class="fas fa-folder-open"></i> Years
                                </a>
                                <button type="button" class="btn btn-sm btn-info mb-1 edit-category-btn"
                                        data-id="@cat.Id" data-title="@cat.Title" data-order="@cat.DisplayOrder" data-visible="@cat.IsVisible.ToString().ToLower()"
                                        title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete category \'@cat.Title\'? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger mb-1" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header" style="background:#1a237e;color:#fff;">
                    <h5 class="modal-title">Add Document Category</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Title</label>
                        <input type="text" name="Title" class="form-control" maxlength="200" required />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control" value="0" />
                    </div>
                    <div class="custom-control custom-switch">
                        <input type="checkbox" name="IsVisible" value="true" class="custom-control-input" id="addCatVisible" checked />
                        <label class="custom-control-label" for="addCatVisible">Visible</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Edit Category Modal (populated via JS from edit-category-btn data-* attrs) -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Edit" method="post" id="editCategoryForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editCatId" />
            <div class="modal-content">
                <div class="modal-header" style="background:#1a237e;color:#fff;">
                    <h5 class="modal-title">Edit Document Category</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Title</label>
                        <input type="text" name="Title" id="editCatTitle" class="form-control" maxlength="200" required />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Display Order</label>
                        <input type="number" name="DisplayOrder" id="editCatOrder" class="form-control" />
                    </div>
                    <div class="custom-control custom-switch">
                        <input type="checkbox" name="IsVisible" value="true" class="custom-control-input" id="editCatVisible" />
                        <label class="custom-control-label" for="editCatVisible">Visible</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
        $(document).on('click', '.edit-category-btn', function() {
            $('#editCategoryForm').attr('action', '@Url.Action("Edit")/' + $(this).data('id'));
            $('#editCatId').val($(this).data('id'));
            $('#editCatTitle').val($(this).data('title'));
            $('#editCatOrder').val($(this).data('order'));
            $('#editCatVisible').prop('checked', $(this).data('visible') === true || $(this).data('visible') === 'true');
            $('#editCategoryModal').modal('show');
        });
    </script>
}