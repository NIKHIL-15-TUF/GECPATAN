@model List<DocumentPageVM>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Documents";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Document Page@(Model.Count == 1 ? "" : "s")
        </span>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Add Document Page
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th width="60">Order</th>
                    <th width="80">Banner</th>
                    <th>Title</th>
                    <th class="text-center" width="100">Layout</th>
                    <th class="text-center" width="110">Grouping</th>
                    <th class="text-center" width="90">Files</th>
                    <th class="text-center" width="90">Status</th>
                    <th class="text-center" width="220">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                            No document pages yet.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var docPage in Model.OrderBy(p => p.DisplayOrder))
                    {
                        <tr>
                            <td>@docPage.DisplayOrder</td>
                            <td>
                                @if (!string.IsNullOrEmpty(docPage.ExistingBannerPath))
                                {
                                    <img src="@Url.Content(docPage.ExistingBannerPath)" alt="@docPage.Title"
                                         style="width:56px;height:40px;object-fit:cover;border-radius:3px;" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <strong>@docPage.Title</strong>
                            </td>
                            <td class="text-center">
                                <span class="badge @(docPage.TableView ? "badge-primary" : "badge-secondary")">
                                    @(docPage.TableView ? "Table" : "List")
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(docPage.HasYearSections ? "badge-info" : "badge-secondary")">
                                    @(docPage.HasYearSections ? "Year-Grouped" : "Direct")
                                </span>
                            </td>
                            <td class="text-center"><span class="badge badge-secondary">@docPage.FileCount</span></td>
                            <td class="text-center">
                                <form asp-action="ToggleVisible" asp-route-id="@docPage.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(docPage.IsVisible ? "btn-success" : "btn-secondary")">
                                        <i class="fas @(docPage.IsVisible ? "fa-eye" : "fa-eye-slash")"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                @if (docPage.HasYearSections)
                                {
                                    <a asp-action="YearSections" asp-route-pageId="@docPage.Id" class="btn btn-sm btn-secondary mb-1" title="Manage Years">
                                        <i class="fas fa-folder-open"></i> Manage Years
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Files" asp-route-pageId="@docPage.Id" class="btn btn-sm btn-secondary mb-1" title="Manage Documents">
                                        <i class="fas fa-file"></i> Manage Documents
                                    </a>
                                }
                                <a asp-action="Edit" asp-route-id="@docPage.Id" class="btn btn-sm btn-info mb-1" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@docPage.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete document page \'@docPage.Title\'? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger mb-1" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>