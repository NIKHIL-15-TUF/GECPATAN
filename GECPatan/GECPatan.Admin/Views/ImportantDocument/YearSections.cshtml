@model List<DocumentYearSectionVM>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Years";
    int categoryId = ViewBag.CategoryId;
    string categoryTitle = ViewBag.CategoryTitle;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Document Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">@categoryTitle</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@categoryTitle — Years</h3>
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#addYearModal">
        <i class="fa fa-plus"></i> Add Year
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card">
    <div class="card-body table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th style="width:60px;">Order</th>
                    <th>Year</th>
                    <th class="text-center" style="width:100px;">Files</th>
                    <th class="text-center" style="width:180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center">No year sections yet. Click "Add Year" to create one.</td>
                    </tr>
                }
                else
                {
                    foreach (var y in Model.OrderByDescending(x => x.Year))
                    {
                        <tr>
                            <td>@y.DisplayOrder</td>
                            <td>
                                <a asp-action="Files" asp-route-yearSectionId="@y.Id">@y.Year</a>
                            </td>
                            <td class="text-center">@y.FileCount</td>
                            <td class="text-center">
                                <a asp-action="Files"
                                   asp-route-yearSectionId="@y.Id"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Manage Files">
                                    <i class="fa fa-file"></i> Files
                                </a>

                                <form asp-action="DeleteYearSection"
                                      asp-route-id="@y.Id"
                                      asp-route-categoryId="@categoryId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete year \'@y.Year\'? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Year Modal -->
<div class="modal fade" id="addYearModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AddYearSection" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CategoryId" value="@categoryId" />

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Year Section</h5>
                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="form-label">Year (e.g. 2023-24)</label>
                        <input type="text"
                               name="Year"
                               class="form-control"
                               maxlength="20"
                               required />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Display Order</label>
                        <input type="number"
                               name="DisplayOrder"
                               class="form-control"
                               value="0" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>