@model List<DocumentFileVM>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Files";
    int pageId = ViewBag.PageId;
    string pageTitle = ViewBag.PageTitle;
    int? yearSectionId = ViewBag.YearSectionId;
    string? year = ViewBag.Year;
    bool isYearBound = yearSectionId.HasValue;
}

<ol class="breadcrumb bg-white shadow-sm px-3 py-2 mb-3">
    <li class="breadcrumb-item"><a asp-action="Index">Document Pages</a></li>
    @if (isYearBound)
    {
        <li class="breadcrumb-item"><a asp-action="YearSections" asp-route-pageId="@pageId">@pageTitle</a></li>
        <li class="breadcrumb-item active" aria-current="page">@year</li>
    }
    else
    {
        <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
    }
</ol>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h5><i class="icon fas fa-check"></i> Success</h5>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h5><i class="icon fas fa-ban"></i> Error</h5>
        @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h3 class="card-title">
            <i class="fas fa-file-alt mr-2"></i>@pageTitle @(isYearBound ? $"— {year}" : "") — Files
        </h3>
        <div class="card-tools">
            <button type="button" class="btn btn-sm btn-light" data-toggle="modal" data-target="#addFileModal">
                <i class="fas fa-plus mr-1"></i>Add File
            </button>
        </div>
    </div>

    <div class="card-body table-responsive p-0">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:70px;">Order</th>
                    <th>Title</th>
                    <th class="text-center" style="width:120px;">File</th>
                    <th class="text-center" style="width:110px;">Visible</th>
                    <th class="text-center" style="width:100px;">Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="fas fa-file-upload mr-1"></i>
                            No documents yet. Click "Add File" to upload one.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var f in Model.OrderBy(x => x.DisplayOrder))
                    {
                        <tr>
                            <td class="align-middle">@f.DisplayOrder</td>
                            <td class="align-middle">@f.Title</td>
                            <td class="text-center align-middle">
                                @if (!string.IsNullOrEmpty(f.ExistingFilePath))
                                {
                                    <a href="@Url.Content(f.ExistingFilePath)" target="_blank"
                                       class="btn btn-sm btn-info" title="View / Download">
                                        <i class="far fa-file-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <form asp-action="ToggleFileVisible" asp-route-id="@f.Id"
                                      asp-route-yearSectionId="@yearSectionId" asp-route-pageId="@pageId"
                                      method="post" class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm @(f.IsVisible ? "btn-success" : "btn-secondary")"
                                            title="Click to @(f.IsVisible ? "hide" : "show")">
                                        <i class="fas @(f.IsVisible ? "fa-eye" : "fa-eye-slash") mr-1"></i>@(f.IsVisible ? "Visible" : "Hidden")
                                    </button>
                                </form>
                            </td>
                            <td class="text-center align-middle">
                                <form asp-action="DeleteFile" asp-route-id="@f.Id"
                                      asp-route-yearSectionId="@yearSectionId" asp-route-pageId="@pageId"
                                      method="post" class="d-inline js-delete-form"
                                      data-confirm-name="@f.Title"
                                      data-confirm-kind="document">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add File Modal -->
<div class="modal fade" id="addFileModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AddFile" method="post" enctype="multipart/form-data">
            @if (isYearBound)
            {
                <input type="hidden" name="YearSectionId" value="@yearSectionId" />
            }
            <input type="hidden" name="PageId" value="@pageId" />

            <div class="modal-content">
                <div class="modal-header" style="background:#1a237e;color:#fff;">
                    <h5 class="modal-title">
                        <i class="fas fa-file-upload mr-2"></i>Add Document
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold" for="addFileTitle">Title</label>
                        <input type="text" id="addFileTitle" name="Title" class="form-control"
                               maxlength="300" required />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" for="addFileInput">File</label>
                        <div class="custom-file">
                            <input type="file" id="addFileInput" name="DocFile" class="custom-file-input"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx" />
                            <label class="custom-file-label" for="addFileInput">Choose file...</label>
                        </div>
                        <small class="form-text text-muted">PDF, Word or Excel.</small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" for="addFileOrder">Display Order</label>
                        <input type="number" id="addFileOrder" name="DisplayOrder" class="form-control"
                               value="0" min="0" />
                    </div>

                    <div class="form-group mb-0">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" name="IsVisible" value="true"
                                   class="custom-control-input" id="addFileVisible" checked />
                            <label class="custom-control-label" for="addFileVisible">Visible on website</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload mr-1"></i>Upload
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Show the chosen filename in the custom-file label.
        $(document).on('change', '#addFileInput', function() {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').text(fileName || 'Choose file...');
        });

        // The title is read from a data attribute (not pasted into inline JavaScript),
        // so a quote or special character in it cannot break or inject script.
        $(document).on('submit', '.js-delete-form', function() {
            var name = $(this).data('confirm-name');
            var kind = $(this).data('confirm-kind');
            return confirm('Delete ' + kind + ' "' + name + '"? This cannot be undone.');
        });
    </script>
}
