@model List<DocumentFileVM>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Files";
    int pageId = ViewBag.PageId;
    string pageTitle = ViewBag.PageTitle;
    int? yearSectionId = ViewBag.YearSectionId;
    string? year = ViewBag.Year;
    bool isYearBound = yearSectionId.HasValue;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Document Pages</a></li>
        @if (isYearBound)
        {
            <li class="breadcrumb-item"><a asp-action="YearSections" asp-route-pageId="@pageId">@pageTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">@year</li>
        }
        else
        {
            <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
        }
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@pageTitle @(isYearBound ? $"— {year}" : "") — Files</h3>
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#addFileModal">
        <i class="fa fa-plus"></i> Add File
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card">
    <div class="card-body table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th style="width:60px;">Order</th>
                    <th>Title</th>
                    <th class="text-center" style="width:120px;">File</th>
                    <th class="text-center" style="width:100px;">Visible</th>
                    <th class="text-center" style="width:100px;">Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center">No documents yet. Click "Add File" to upload one.</td>
                    </tr>
                }
                else
                {
                    foreach (var f in Model.OrderBy(x => x.DisplayOrder))
                    {
                        <tr>
                            <td>@f.DisplayOrder</td>
                            <td>@f.Title</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(f.ExistingFilePath))
                                {
                                    <a href="@Url.Content(f.ExistingFilePath)" target="_blank" title="View / Download">
                                        <i class="fa fa-file-o"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleFileVisible" asp-route-id="@f.Id"
                                      asp-route-yearSectionId="@yearSectionId" asp-route-pageId="@pageId"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(f.IsVisible ? "btn-success" : "btn-secondary")">
                                        @(f.IsVisible ? "Visible" : "Hidden")
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                <form asp-action="DeleteFile" asp-route-id="@f.Id"
                                      asp-route-yearSectionId="@yearSectionId" asp-route-pageId="@pageId"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete document \'@f.Title\'? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add File Modal -->
<div class="modal fade" id="addFileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AddFile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (isYearBound)
            {
                <input type="hidden" name="YearSectionId" value="@yearSectionId" />
            }
            <input type="hidden" name="PageId" value="@pageId" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Document</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" name="Title" class="form-control" maxlength="300" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">File</label>
                        <input type="file" name="DocFile" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control" value="0" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsVisible" value="true" class="form-check-input" id="addFileVisible" checked />
                        <label class="form-check-label" for="addFileVisible">Visible</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </div>
        </form>
    </div>
</div>
