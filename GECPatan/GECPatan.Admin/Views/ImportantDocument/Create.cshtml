@model DocumentPageVM
@{
    ViewData["Title"] = ViewData["Title"] ?? "Add Document Page";
}
<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-folder-open mr-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <input asp-for="Title" class="form-control" placeholder="Page title, e.g. AICTE Approvals" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Title Banner Image</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="titleBannerImage"
                                   name="TitleBannerImage" accept=".jpg,.jpeg,.png,.webp" />
                            <label class="custom-file-label" for="titleBannerImage">Choose banner image...</label>
                        </div>
                        <small class="form-text text-muted">Optional. Used as the page header background.</small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold d-block">Display Layout</label>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="layoutList" name="TableView" value="false"
                                   class="custom-control-input" checked />
                            <label class="custom-control-label" for="layoutList">List View</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="layoutTable" name="TableView" value="true"
                                   class="custom-control-input" />
                            <label class="custom-control-label" for="layoutTable">Table View</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="HasYearSections" type="checkbox"
                                   class="custom-control-input" id="hasYearSections" />
                            <label class="custom-control-label" for="hasYearSections">Group documents by year?</label>
                        </div>
                        <small class="form-text text-danger">
                            <i class="fas fa-exclamation-triangle mr-1"></i>
                            This setting cannot be changed after the page is created — choose carefully.
                        </small>
                    </div>

                    <div class="form-group">
                        <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">Visible on website</label>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Show the chosen filename in the Bootstrap custom-file label.
        $(document).on('change', '#titleBannerImage', function () {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').text(fileName || 'Choose banner image...');
        });
    </script>
}
