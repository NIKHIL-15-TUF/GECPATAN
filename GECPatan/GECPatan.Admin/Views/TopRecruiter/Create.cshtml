@model GECPatan.Admin.Models.ViewModels.TopRecruiterVM
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Recruiter" : "Add Recruiter";
    string action = isEdit ? "Edit" : "Create";
}
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-briefcase mr-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <form asp-action="@action" method="post" enctype="multipart/form-data">
                @if (isEdit)
                {
                    <input asp-for="Id" type="hidden" />
                }
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
 
                    <div class="form-group">
                        <label asp-for="Name" class="font-weight-bold"></label>
                        <input asp-for="Name" class="form-control"
                               placeholder="e.g. TCS, Infosys, Google" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
 
                    <div class="form-group">
                        <label class="font-weight-bold">Company Logo</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingLogoPath))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingLogoPath" class="img-thumbnail"
                                     style="max-height:80px;" />
                                <small class="text-muted d-block">Current logo</small>
                            </div>
                        }
                        <div class="row align-items-center">
                            <div class="col-8">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" name="Logo"
                                           accept="image/*" onchange="previewLogo(this)" />
                                    <label class="custom-file-label">
                                        @(string.IsNullOrEmpty(Model.ExistingLogoPath)
                                            ? "Choose logo..." : "Replace logo...")
                                    </label>
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <img id="logoPreview" src="#"
                                     class="img-thumbnail d-none"
                                     style="max-height:60px;" />
                            </div>
                        </div>
                        <small class="text-muted">PNG with transparent background recommended</small>
                    </div>
 
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">
                                Visible on website
                            </label>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-info"></i>Tips
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-2">
                    <i class="fas fa-check text-success mr-1"></i>
                    Use PNG format with transparent background for best results.
                </p>
                <p class="small text-muted mb-2">
                    <i class="fas fa-check text-success mr-1"></i>
                    Logo dimensions: roughly <strong>200x100px</strong> (landscape).
                </p>
                <p class="small text-muted mb-0">
                    <i class="fas fa-check text-success mr-1"></i>
                    Use reorder arrows on the list to change display order.
                </p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function previewLogo(input) {
        const preview = document.getElementById('logoPreview');
        if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
        preview.src = e.target.result;
        preview.classList.remove('d-none');
        };
        reader.readAsDataURL(input.files[0]);
        input.nextElementSibling.textContent = input.files[0].name;
        }
        }
    </script>
}