@using  GECPatan.Core.Models.Domain
@model List<TopRecruiter>
@{
    ViewData["Title"] = "Top Recruiters";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">@Model.Count Recruiter(s)</span>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Add Recruiter
        </a>
    </div>
</div>
<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5 text-muted">
                    <i class="fas fa-briefcase fa-3x mb-3 d-block"></i>
                    No recruiters yet.
                </div>
            </div>
        </div>
    }
    @foreach (var r in Model)
    {
        <div class="col-md-2 col-4 mb-3">
            <div class="card text-center @(!r.IsVisible ? "border-secondary opacity-50" : "")">
                <div class="card-body p-2">
                    @if (!string.IsNullOrEmpty(r.LogoPath))
                    {
                        <img src="@r.LogoPath" class="img-fluid mb-2"
                             style="max-height:60px;object-fit:contain;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center mb-2"
                             style="height:60px;">
                            <i class="fas fa-building text-muted"></i>
                        </div>
                    }
                    <small class="d-block font-weight-bold" style="font-size:11px;">@r.Name</small>
                </div>
                <div class="card-footer p-1 d-flex justify-content-center" style="gap:3px;">
                    <form asp-action="Reorder" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@r.Id" />
                        <input type="hidden" name="direction" value="up" />
                        <button type="submit" class="btn btn-xs btn-light border px-1">
                            <i class="fas fa-chevron-left" style="font-size:9px;"></i>
                        </button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-xs btn-info px-1">
                        <i class="fas fa-edit" style="font-size:9px;"></i>
                    </a>
                    <form asp-action="ToggleVisible" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="btn btn-xs @(r.IsVisible ? "btn-warning" : "btn-success") px-1">
                            <i class="fas @(r.IsVisible ? "fa-eye-slash" : "fa-eye")" style="font-size:9px;"></i>
                        </button>
                    </form>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="btn btn-xs btn-danger px-1"
                                onclick="return confirm('Delete?')">
                            <i class="fas fa-trash" style="font-size:9px;"></i>
                        </button>
                    </form>
                    <form asp-action="Reorder" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@r.Id" />
                        <input type="hidden" name="direction" value="down" />
                        <button type="submit" class="btn btn-xs btn-light border px-1">
                            <i class="fas fa-chevron-right" style="font-size:9px;"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>