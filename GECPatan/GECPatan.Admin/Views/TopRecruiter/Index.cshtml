@using GECPatan.Core.Models.Domain
@model List<TopRecruiter>

@{
    ViewData["Title"] = "Top Recruiters";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Recruiter(s)
        </span>

        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-2"></i>Add Recruiter
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th style="width:70px;">ID</th>
                    <th style="width:100px;">Logo</th>
                    <th>Recruiter Name</th>
                    <th style="width:100px;">Status</th>
                    <th style="width:180px;" class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fas fa-briefcase fa-2x mb-2 d-block"></i>
                            No recruiters yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr class="@(!r.IsVisible ? "text-muted" : "")">
                            <td class="align-middle">@r.Id</td>

                            <td class="align-middle">
                                @if (!string.IsNullOrEmpty(r.LogoPath))
                                {
                                    <img src="@r.LogoPath"
                                         alt="@r.Name"
                                         style="max-width:80px;max-height:45px;object-fit:contain;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light"
                                         style="width:70px;height:40px;">
                                        <i class="fas fa-building text-muted"></i>
                                    </div>
                                }
                            </td>

                            <td class="align-middle">
                                <strong>@r.Name</strong>
                            </td>

                            <td class="align-middle">
                                @if (r.IsVisible)
                                {
                                    <span class="badge badge-success">Visible</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Hidden</span>
                                }
                            </td>

                            <td class="align-middle text-center">
                                <div class="d-flex justify-content-center align-items-center"
                                     style="gap:4px;">

                                    <a asp-action="Edit" asp-route-id="@r.Id"
                                       class="btn btn-xs btn-info" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="ToggleVisible" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit"
                                                class="btn btn-xs @(r.IsVisible ? "btn-warning" : "btn-success")"
                                                title="@(r.IsVisible ? "Hide" : "Show")">
                                            <i class="fas @(r.IsVisible ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Delete" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-xs btn-danger"
                                                title="Delete"
                                                onclick="return confirm('Delete this recruiter?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>