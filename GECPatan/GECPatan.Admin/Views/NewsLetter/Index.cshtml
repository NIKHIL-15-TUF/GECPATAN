@using GECPatan.Core.Models.Domain
@model List<NewsLetter>
@{
    ViewData["Title"] = "News Letters";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">@Model.Count Newsletter(s)</span>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Add Newsletter
        </a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-file-pdf fa-3x mb-3 d-block"></i>
                No newsletters yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead style="background:#1a237e;color:#fff;">
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>PDF</th>
                            <th style="width:180px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var n in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@n.Title</strong>
                                </td>

                                <td>
                                    @if (n.IsVisible)
                                    {
                                        <span class="badge badge-success">Visible</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Hidden</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(n.FilePath))
                                    {
                                        <a href="@n.FilePath"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-file-pdf mr-1"></i>
                                            View PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No file</span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@n.Id"
                                       class="btn btn-sm btn-info">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="ToggleVisible"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden"
                                               name="id"
                                               value="@n.Id" />

                                        <button type="submit"
                                                class="btn btn-sm @(n.IsVisible ? "btn-warning" : "btn-success")">
                                            <i class="fas @(n.IsVisible ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Delete"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden"
                                               name="id"
                                               value="@n.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Delete?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>