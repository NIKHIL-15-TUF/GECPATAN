@model GECPatan.Admin.Models.ViewModels.ContentEditorDashboardVM
@{
    ViewData["Title"] = "My Content Page";
}
 
@if (Model.PageId == 0)
{
    <!-- No page assigned -->
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-file-alt fa-4x text-warning mb-3 d-block"></i>
            <h4>No Content Page Assigned</h4>
            <p class="text-muted">
                Your account is not linked to any content page yet.
                <br />
                Please contact the SuperAdmin to assign your page.
            </p>
        </div>
    </div>
}
else
{
    <!-- Page assigned — show it -->
    <div class="row">
 
        <!-- Page Info Card -->
        <div class="col-md-8">
            <div class="card"
                 style="border-left:4px solid #1a237e;">
                <div class="card-body">
                    <div class="d-flex justify-content-between
                        align-items-start">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-file-alt mr-2
                                text-primary"></i>
                                @Model.PageTitle
                            </h5>
                            <p class="text-muted mb-2">
                                <i class="fas fa-link mr-1"></i>
                                <code>/page/@Model.PageSlug</code>
                            </p>
                            <div>
                                @if (Model.IsPublished)
                                {
                                    <span class="badge badge-success px-2 py-1">
                                        <i class="fas fa-check-circle mr-1"></i>
                                        Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-warning px-2 py-1">
                                        <i class="fas fa-clock mr-1"></i>
                                        Draft
                                    </span>
                                }
                                @if (Model.LastUpdated.HasValue)
                                {
                                    <small class="text-muted ml-2">
                                        Last updated:
                                        @Model.LastUpdated.Value
                                        .ToString("dd MMM yyyy, hh:mm tt")
                                    </small>
                                }
                            </div>
                        </div>
                        <div class="d-flex flex-column"
                             style="gap:8px;">
                            <a asp-controller="ContentPage"
                                   asp-action="Edit"
                                   asp-route-id="@Model.PageId"
                                   class="btn btn-primary btn-sm">
                                <i class="fas fa-edit mr-1"></i>
                                Edit Page
                            </a>
                            <a asp-controller="ContentPage"
                                   asp-action="Preview"
                                   asp-route-id="@Model.PageId"
                                   target="_blank"
                                   class="btn btn-secondary btn-sm">
                                <i class="fas fa-eye mr-1"></i>
                                Preview
                            </a>
                        </div>
                    </div>
                </div>
            </div>
 
            <!-- Page Content Preview -->
            @if (!string.IsNullOrEmpty(Model.ContentPreview))
            {
                <div class="card mt-3">
                    <div class="card-header bg-light">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-align-left mr-2"></i>
                            Content Preview
                        </h6>
                    </div>
                    <div class="card-body"
                         style="max-height:300px;
                        overflow-y:auto;
                        font-size:13px;">
                        @Html.Raw(Model.ContentPreview)
                    </div>
                    <div class="card-footer text-right py-2">
                        <a asp-controller="ContentPage"
                               asp-action="Edit"
                               asp-route-id="@Model.PageId"
                               class="btn btn-sm btn-primary">
                            <i class="fas fa-edit mr-1"></i>
                            Edit Full Content
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card mt-3 border-dashed">
                    <div class="card-body text-center py-4 text-muted">
                        <i class="fas fa-pencil-alt fa-2x mb-2 d-block"></i>
                        <p class="mb-2">This page has no content yet.</p>
                        <a asp-controller="ContentPage"
                               asp-action="Edit"
                               asp-route-id="@Model.PageId"
                               class="btn btn-primary btn-sm">
                            <i class="fas fa-edit mr-1"></i>
                            Start Writing
                        </a>
                    </div>
                </div>
            }
        </div>
 
        <!-- Right: Info + Actions -->
        <div class="col-md-4">
 
            <!-- Page URL box -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-link mr-2"></i>
                        Public URL
                    </h6>
                </div>
                <div class="card-body py-2">
                    <div class="input-group input-group-sm">
                        <input type="text"
                               class="form-control form-control-sm"
                               value="/page/@Model.PageSlug"
                               readonly id="pageUrl" />
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary btn-sm"
                                    onclick="copyUrl()"
                                    title="Copy URL">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-1">
                        Share this URL to let people view the page.
                    </small>
                </div>
            </div>
 
            <!-- Quick Help -->
            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-info-circle mr-2 text-info"></i>
                        Your Role
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="p-2 border-bottom">
                        <strong class="small d-block">
                            <i class="fas fa-check-circle text-success mr-1"></i>
                            You Can
                        </strong>
                        <ul class="small text-muted mb-0 pl-3 mt-1">
                            <li>Edit content of your assigned page</li>
                            <li>Format text with the editor</li>
                            <li>Add images and links</li>
                            <li>Preview before publishing</li>
                        </ul>
                    </div>
                    <div class="p-2">
                        <strong class="small d-block">
                            <i class="fas fa-times-circle text-danger mr-1"></i>
                            Contact Admin For
                        </strong>
                        <ul class="small text-muted mb-0 pl-3 mt-1">
                            <li>Publishing / unpublishing page</li>
                            <li>Changing page title or URL</li>
                            <li>Getting assigned to a different page</li>
                        </ul>
                    </div>
                </div>
            </div>
 
        </div>
    </div>
}
 
@section Scripts {
    <script>
        function copyUrl() {
            const url = document.getElementById('pageUrl').value;
            navigator.clipboard.writeText(
                window.location.origin + url)
                .then(() => {
                    const btn = event.target.closest('button');
                    btn.innerHTML = '<i class="fas fa-check text-success"></i>';
                    setTimeout(() => {
                        btn.innerHTML = '<i class="fas fa-copy"></i>';
                    }, 2000);
                });
        }
    </script>
}