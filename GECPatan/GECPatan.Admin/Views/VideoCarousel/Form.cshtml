@model GECPatan.Admin.Models.ViewModels.VideoCarouselVM
@{
    bool isEdit = Model.ID > 0;
    ViewData["Title"] = isEdit ? "Edit Video Carousel" : "Add Video Carousel";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title mb-0">
                    <i class="fas fa-video mr-2"></i>@ViewData["Title"]
                </h3>
            </div>

            <form asp-action="@(isEdit ? "Edit" : "Create")"
                  asp-route-id="@(isEdit ? Model.ID : null)"
                  method="post">
                @if (isEdit)
                {
                    <input asp-for="ID" type="hidden" />
                }

                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <textarea asp-for="Title" class="form-control" rows="3"
                                  placeholder="Enter video title or event details"
                                  autofocus></textarea>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="VideoUrl" class="font-weight-bold"></label>
                        <input asp-for="VideoUrl" class="form-control"
                               id="videoUrl"
                               placeholder="https://www.youtube.com/shorts/VIDEO_ID"
                               oninput="updateVideoPreview()" />
                        <span asp-validation-for="VideoUrl" class="text-danger small"></span>
                        <small class="text-muted">
                            Paste a YouTube Shorts or regular YouTube video URL.
                        </small>
                    </div>

                    <div id="videoPreviewContainer" class="card border-info mb-3">
                        <div class="card-header bg-info text-white py-1">
                            <small class="font-weight-bold">
                                <i class="fas fa-play-circle mr-1"></i>Video Preview
                            </small>
                        </div>
                        <div class="card-body text-center py-2">
                            <div id="videoPreviewMessage" class="text-muted small">
                                Enter a valid YouTube URL to preview the video.
                            </div>
                            <div id="videoFrameWrapper" class="d-none">
                                <div class="embed-responsive embed-responsive-16by9">
                                    <iframe id="videoPreviewFrame"
                                            class="embed-responsive-item"
                                            title="YouTube video preview"
                                            src=""
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            allowfullscreen
                                            referrerpolicy="strict-origin-when-cross-origin">
                                    </iframe>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="OrderNo" class="font-weight-bold"></label>
                                <input asp-for="OrderNo" class="form-control"
                                       type="number" min="0" />
                                <span asp-validation-for="OrderNo" class="text-danger small"></span>
                                <small class="text-muted">Lower values appear first.</small>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <div class="form-group mt-4">
                                <div class="custom-control custom-switch">
                                    <input asp-for="IsShow" type="checkbox"
                                           class="custom-control-input" id="isShow" />
                                    <label class="custom-control-label" for="isShow">
                                        Show on Website
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>
                        @(isEdit ? "Save Changes" : "Add Video")
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-info"></i>About Video Carousel
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    Add a YouTube video or Shorts URL for the homepage video carousel.
                </p>
                <hr />
                <strong class="small">Supported URLs</strong>
                <p class="small text-muted">
                    You can use youtube.com/watch, youtube.com/shorts, youtu.be,
                    or youtube.com/embed links.
                </p>
                <hr />
                <strong class="small">Display Order</strong>
                <p class="small text-muted">
                    Lower order numbers appear before higher numbers.
                </p>
                <hr />
                <strong class="small">Show on Website</strong>
                <p class="small text-muted mb-0">
                    Turn this off to hide the video without deleting its record.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function getYouTubeVideoId(value) {
            if (!value) return null;

            try {
                const url = new URL(value.trim());
                const host = url.hostname.toLowerCase().replace(/^www\./, '');

                if (host === "youtu.be") {
                    return url.pathname.split('/').filter(Boolean)[0] || null;
                }

                if (host === "youtube.com" || host === "m.youtube.com" || host === "youtube-nocookie.com") {
                    if (url.pathname === "/watch") {
                        return url.searchParams.get("v");
                    }

                    const segments = url.pathname.split('/').filter(Boolean);
                    if (segments.length >= 2 &&
                        ["shorts", "embed", "live"].includes(segments[0])) {
                        return segments[1];
                    }
                }
            } catch {
                return null;
            }

            return null;
        }

        function updateVideoPreview() {
            const videoUrl = document.getElementById("videoUrl").value;
            const videoId = getYouTubeVideoId(videoUrl);
            const frame = document.getElementById("videoPreviewFrame");
            const wrapper = document.getElementById("videoFrameWrapper");
            const message = document.getElementById("videoPreviewMessage");

            if (videoId && /^[a-zA-Z0-9_-]{11}$/.test(videoId)) {
                frame.src = "https://www.youtube.com/embed/" + videoId;
                wrapper.classList.remove("d-none");
                message.classList.add("d-none");
            } else {
                frame.src = "";
                wrapper.classList.add("d-none");
                message.textContent = "Enter a valid YouTube URL to preview the video.";
                message.classList.remove("d-none");
            }
        }

        document.addEventListener("DOMContentLoaded", updateVideoPreview);
    </script>
}
