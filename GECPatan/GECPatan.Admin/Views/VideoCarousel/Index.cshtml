@model List<GECPatan.Core.Models.Domain.VideoCarousel>
@{
    ViewData["Title"] = "Video Carousel";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge badge-info px-3 py-2" style="font-size:13px;">
                @Model.Count Item(s)
            </span>
            <span class="badge badge-success ml-2 px-2 py-1">
                @Model.Count(x => x.IsShow) Visible
            </span>
            <span class="badge badge-secondary ml-1 px-2 py-1">
                @Model.Count(x => !x.IsShow) Hidden
            </span>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-2"></i>Add Video
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead style="background:#1a237e;color:#fff;">
                    <tr>
                        <th width="70">Order</th>
                        <th>Video Title</th>
                        <th width="180">Video URL</th>
                        <th width="100">Status</th>
                        <th width="150">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-video fa-2x mb-2 d-block"></i>
                                No video carousel records yet.
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.IsShow ? "table-secondary" : "")">
                            <td>
                                <span class="badge badge-light border">
                                    @item.OrderNo
                                </span>
                            </td>
                            <td>
                                <strong style="font-size:13px;">@item.Title</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.VideoUrl))
                                {
                                    <a href="@item.VideoUrl" target="_blank" rel="noopener noreferrer"
                                       class="btn btn-xs btn-outline-info" title="Open YouTube video">
                                        <i class="fab fa-youtube mr-1"></i>Open video
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">No URL</span>
                                }
                            </td>
                            <td>
                                @if (item.IsShow)
                                {
                                    <span class="badge badge-success" style="font-size:9px;">
                                        Visible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" style="font-size:9px;">
                                        Hidden
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.ID"
                                   class="btn btn-xs btn-info" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <form asp-action="ToggleVisible" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ID" />
                                    <button type="submit"
                                            class="btn btn-xs @(item.IsShow ? "btn-warning" : "btn-success")"
                                            title="@(item.IsShow ? "Hide" : "Show")">
                                        <i class="fas @(item.IsShow ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                </form>

                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ID" />
                                    <button type="submit" class="btn btn-xs btn-danger"
                                            title="Soft delete"
                                            onclick="return confirm('Delete this video carousel record?');">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
