@model GECPatan.Admin.Models.ViewModels.TimetableCreateVM
@{
    ViewData["Title"] = "Upload Timetable";
}
<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-upload mr-2"></i>Upload Timetable
                </h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
 
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DeptId" class="font-weight-bold"></label>
                                <select asp-for="DeptId" asp-items="Model.Departments"
                                        class="form-control">
                                    <option value="">-- Select Department --</option>
                                </select>
                                <span asp-validation-for="DeptId"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Year" class="font-weight-bold"></label>
                                <input asp-for="Year" class="form-control"
                                       type="number" min="2020" max="2035"
                                       placeholder="e.g. 2025" />
                                <span asp-validation-for="Year"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
 
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SemesterType"
                                       class="font-weight-bold"></label>
                                <select asp-for="SemesterType"
                                        class="form-control"
                                        id="semTypeSelect"
                                        onchange="updateSemOptions(this.value)">
                                    <option value="1">Odd Semester</option>
                                    <option value="2">Even Semester</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Semester"
                                       class="font-weight-bold"></label>
                                <select asp-for="Semester"
                                        class="form-control"
                                        id="semSelect">
                                    <!-- Populated by JS -->
                                </select>
                                <span asp-validation-for="Semester"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
 
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Timetable File (PDF or Image)
                            <span class="text-danger">*</span>
                        </label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input"
                                   name="TimetableFile"
                                   accept=".pdf,image/*"
                                   onchange="this.nextElementSibling.textContent=
                            this.files[0]?.name||'Choose file...'" />
                            <label class="custom-file-label">Choose file...</label>
                        </div>
                        <small class="text-muted">
                            Accepted: PDF or Image (PNG/JPG)
                        </small>
                    </div>
 
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">
                                Visible on website
                            </label>
                        </div>
                    </div>
 
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle mr-2"></i>
                        Uploading a new timetable for the same dept + semester
                        automatically replaces the current one as <strong>Latest</strong>.
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload mr-2"></i>Upload
                    </button>
                </div>
            </form>
        </div>
    </div>
 
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-info"></i>Semester Guide
                </h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Type</th>
                            <th>Semesters</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <span class="badge badge-primary">Odd</span>
                            </td>
                            <td>1, 3, 5, 7</td>
                        </tr>
                        <tr>
                            <td>
                                <span class="badge badge-info">Even</span>
                            </td>
                            <td>2, 4, 6, 8</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
 
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const oddSems  = [1, 3, 5, 7];
        const evenSems = [2, 4, 6, 8];
 
        function updateSemOptions(type) {
        const select = document.getElementById('semSelect');
        const sems   = type == '1' ? oddSems : evenSems;
        select.innerHTML = sems.map(s =>
        `<option value="${s}">Semester ${s}</option>`
        ).join('');
        }
 
        // Init on page load
        updateSemOptions(
        document.getElementById('semTypeSelect').value
        );
    </script>
}