@model GECPatan.Admin.Models.ViewModels.DynamicSectionVM
@using GECPatan.Admin.Models.Domain
@{
    ViewData["Title"] = "Edit Section";
    var existingFiles = ViewBag.ExistingFiles as List<GECPatan.Admin.Models.Domain.DynamicSectionFile>
                        ?? new List<GECPatan.Admin.Models.Domain.DynamicSectionFile>();
}
 
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-edit mr-2"></i>Edit Section: @Model.Title
                </h3>
            </div>
 
            <form asp-action="Edit" asp-route-id="@Model.Id"
                  method="post" enctype="multipart/form-data">
 
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
 
                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
 
                    <!-- Section type badge (read-only on edit) -->
                    <div class="form-group">
                        <label class="font-weight-bold">Section Type</label>
                        <div>
                            <span class="badge badge-primary px-3 py-2" style="font-size:13px;">
                                @Model.SectionType.ToString()
                            </span>
                            <small class="text-muted ml-2">
                                (Section type cannot be changed after creation)
                            </small>
                        </div>
                    </div>
 
                    <!-- RICHTEXT -->
                    @if (Model.SectionType == SectionType.RichText || Model.SectionType == SectionType.Table)
                    {
                        <div class="form-group">
                            <label class="font-weight-bold">Content</label>
                            <textarea asp-for="HtmlContent" id="richTextEditor"
                                      class="form-control" rows="12"></textarea>
                        </div>
                    }
 
                    <!-- PDF -->
                    @if (Model.SectionType == SectionType.PDFViewer ||
                                             Model.SectionType == SectionType.PDFDownload)
                    {
                        <div class="form-group">
                            <label class="font-weight-bold">PDF File</label>
                            @if (!string.IsNullOrEmpty(Model.FilePath))
                            {
                                <div class="mb-2 p-2 bg-light border rounded d-flex align-items-center">
                                    <i class="fas fa-file-pdf text-danger mr-2 fa-lg"></i>
                                    <div>
                                        <strong>@Model.FileName</strong>
                                        <small class="text-muted d-block">Current file</small>
                                    </div>
                                    <a href="@Model.FilePath" target="_blank"
                                           class="btn btn-sm btn-outline-primary ml-auto">
                                        <i class="fas fa-eye mr-1"></i>View
                                    </a>
                                </div>
                            }
                            <div class="custom-file">
                                <input type="file" class="custom-file-input"
                                       id="UploadFile" name="UploadFile"
                                       accept=".pdf"
                                       onchange="this.nextElementSibling.textContent = this.files[0]?.name || 'Choose file...'" />
                                <label class="custom-file-label" for="UploadFile">
                                    Replace PDF file...
                                </label>
                            </div>
                        </div>
                    }
 
                    <!-- GALLERY / FILELIST -->
                    @if (Model.SectionType == SectionType.ImageGallery ||
                                             Model.SectionType == SectionType.FileList)
                    {
                        <label class="font-weight-bold">
                            @(Model.SectionType == SectionType.ImageGallery ? "Images" : "Files")
                            (@existingFiles.Count)
                        </label>
 
                        @if (existingFiles.Any())
                        {
                            <div class="row mb-3">
                                @foreach (var f in existingFiles)
                                {
                                    <div class="col-md-3 col-6 mb-2 text-center">
                                        @if (Model.SectionType == SectionType.ImageGallery)
                                        {
                                            <img src="@f.FilePath" class="img-thumbnail"
                                                 style="height:80px;object-fit:cover;width:100%;" />
                                        }
                                        else
                                        {
                                            <div class="border rounded p-2 bg-light">
                                                <i class="fas fa-file fa-2x text-muted d-block mb-1"></i>
                                                <small style="font-size:11px;">@f.Title</small>
                                            </div>
                                        }
                                        <form asp-action="DeleteFile" method="post" class="mt-1">
                                            <input type="hidden" name="fileId" value="@f.Id" />
                                            <button type="submit" class="btn btn-xs btn-danger btn-block"
                                                    onclick="return confirm('Remove?')">
                                                <i class="fas fa-times mr-1"></i>Remove
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
 
                        <!-- Add more files -->
                        <form asp-action="AddFiles" method="post"
                              enctype="multipart/form-data" class="border p-3 bg-light rounded">
                            <input type="hidden" name="sectionId" value="@Model.Id" />
                            <label class="font-weight-bold small mb-2">Add More Files</label>
                            <div class="custom-file">
                                <input type="file" class="custom-file-input"
                                       name="@(Model.SectionType == SectionType.ImageGallery ? "GalleryFiles" : "FileListFiles")"
                                       multiple
                                       accept="@(Model.SectionType == SectionType.ImageGallery ? "image/*" : "*")"
                                       onchange="this.nextElementSibling.textContent = this.files.length + ' file(s) selected'" />
                                <label class="custom-file-label">Add files...</label>
                            </div>
                            <button type="submit" class="btn btn-success btn-sm mt-2">
                                <i class="fas fa-upload mr-1"></i>Upload
                            </button>
                        </form>
                    }
 
                    <hr />
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">
                                Show this section on the website
                            </label>
                        </div>
                    </div>
                </div>
 
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index"
                           asp-route-pageType="@Model.PageType"
                           asp-route-pageId="@Model.PageId"
                           class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
 
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-eye mr-2 text-info"></i>Preview Info
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-1">
                    <strong>Type:</strong> @Model.SectionType
                </p>
                <p class="small text-muted mb-1">
                    <strong>Order:</strong> @Model.DisplayOrder
                </p>
                <p class="small text-muted mb-0">
                    <strong>Visible:</strong>
                    @if (Model.IsVisible)
                    {
                        <span class="text-success">Yes</span>
                    }
                    else
                    {
                        <span class="text-danger">No (Hidden)</span>
                    }
                </p>
            </div>
        </div>
    </div>
</div>
 
@section Scripts {
    @if (Model.SectionType == GECPatan.Admin.Models.Domain.SectionType.RichText ||
             Model.SectionType == GECPatan.Admin.Models.Domain.SectionType.Table)
    {
        <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
        <script>
            tinymce.init({
            selector: '#richTextEditor',
            plugins: 'link lists table image code',
            toolbar: 'undo redo | formatselect | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image table | code',
            height: 400,
            menubar: false,
            promotion: false,
            branding: false,
            setup: function (editor) {
            editor.on('submit', function () { tinymce.triggerSave(); });
            }
            });
            document.querySelector('form').addEventListener('submit', function () {
            tinymce.triggerSave();
            });
        </script>
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}