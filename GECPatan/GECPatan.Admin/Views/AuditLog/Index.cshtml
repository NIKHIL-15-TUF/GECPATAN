@model GECPatan.Admin.Models.ViewModels.AuditLogFilterVM
@{
    ViewData["Title"] = "Audit Logs";
}
 
<!-- Filter Bar -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form asp-action="Index" method="get">
            <div class="row align-items-end">
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-bold">User</label>
                    <input asp-for="UserName" class="form-control form-control-sm"
                           placeholder="Search by user..." />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-bold">Module</label>
                    <select asp-for="Module" class="form-control form-control-sm">
                        <option value="">All Modules</option>
                        @foreach (var m in Model.Modules)
                        {
                            <option value="@m" selected="@(Model.Module == m)">@m</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-bold">Action</label>
                    <select asp-for="Action" class="form-control form-control-sm">
                        <option value="">All Actions</option>
                        @foreach (var a in Model.Actions)
                        {
                            <option value="@a" selected="@(Model.Action == a)">@a</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-bold">From Date</label>
                    <input asp-for="DateFrom" class="form-control form-control-sm"
                           type="date" />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-bold">To Date</label>
                    <input asp-for="DateTo" class="form-control form-control-sm"
                           type="date" />
                </div>
                <div class="col-md-1 mb-2">
                    <button type="submit" class="btn btn-primary btn-sm btn-block">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.UserName) ||
                             !string.IsNullOrEmpty(Model.Module) ||
                             !string.IsNullOrEmpty(Model.Action) ||
                             Model.DateFrom.HasValue || Model.DateTo.HasValue)
            {
                <div class="mt-1">
                    <a asp-action="Index" class="btn btn-link btn-sm text-danger p-0">
                        <i class="fas fa-times mr-1"></i>Clear Filters
                    </a>
                </div>
            }
        </form>
    </div>
</div>
 
<div class="card">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0">
            <i class="fas fa-history mr-2"></i>
            @Model.Logs.Count Log(s)
            <small class="text-muted">(showing latest 500)</small>
        </h6>
        <small class="text-muted">
            <i class="fas fa-lock mr-1"></i>Audit logs cannot be deleted
        </small>
    </div>
    <div class="card-body p-0">
        @if (!Model.Logs.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-history fa-3x mb-3 d-block"></i>
                No audit logs found for the selected filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead style="background:#1a237e;color:#fff;">
                        <tr>
                            <th width="150">When</th>
                            <th width="130">User</th>
                            <th width="100">Role</th>
                            <th width="80">Action</th>
                            <th width="120">Module</th>
                            <th>Record</th>
                            <th width="100">IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td>
                                    <small class="text-muted">@log.Timestamp</small>
                                </td>
                                <td>
                                    <small><strong>@log.UserName</strong></small>
                                </td>
                                <td>
                                    <span class="badge badge-secondary"
                                          style="font-size:9px;">
                                        @log.UserRole
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var badgeColor = log.Action switch
                                        {
                                            "Created" => "badge-success",
                                            "Updated" => "badge-info",
                                            "Deleted" => "badge-danger",
                                            "Login" => "badge-primary",
                                            _ => "badge-secondary"
                                        };
                                    }
                                    <span class="badge @badgeColor"
                                          style="font-size:9px;">
                                        @log.Action
                                    </span>
                                </td>
                                <td>
                                    <small>@log.Module</small>
                                </td>
                                <td>
                                    <small>@log.RecordName</small>
                                    @if (!string.IsNullOrEmpty(log.Details))
                                    {
                                        <i class="fas fa-info-circle text-muted ml-1"
                                           title="@log.Details"
                                           style="cursor:pointer;font-size:10px;"></i>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@log.IpAddress</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>