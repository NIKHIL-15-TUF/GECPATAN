@model GECPatan.Admin.Models.ViewModels.FacultyDashboardVM
@{
    ViewData["Title"] = "My Profile";
}
<div class="row">
    <!-- Profile Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center py-4">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath"
                         class="img-thumbnail rounded-circle mb-3"
                         style="width:120px;height:120px;object-fit:cover;" />
                }
                else
                {
                    <div class="bg-secondary rounded-circle
                                d-inline-flex align-items-center
                                justify-content-center mb-3"
                         style="width:120px;height:120px;">
                        <i class="fas fa-user fa-4x text-white"></i>
                    </div>
                }
                <h5 class="mb-1">@Model.Name</h5>
                <p class="text-muted mb-1">@Model.Designation</p>
                <span class="badge @(Model.IsTeaching?"badge-primary":"badge-secondary")">
                    @(Model.IsTeaching ? "Teaching Staff" : "Non-Teaching Staff")
                </span>
                <p class="text-muted mt-2 mb-0">
                    <i class="fas fa-building mr-1"></i>@Model.DeptName
                </p>
            </div>
            <div class="card-footer text-center">
                <a asp-controller="Faculty" asp-action="Edit"
                   asp-route-id="@Model.FacultyId"
                   class="btn btn-primary btn-sm btn-block">
                    <i class="fas fa-edit mr-2"></i>Edit My Profile
                </a>
            </div>
        </div>
    </div>
 
    <!-- Sub-sections -->
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-list mr-2"></i>My Profile Sections
                </h6>
            </div>
            <div class="card-body p-2">
                <div class="row">
                    @{
                        var secs = new[]
                        {
                            ("Qualifications", "fa-graduation-cap", Model.QualificationCount, "primary"),
                            ("Experience",     "fa-briefcase",      Model.ExperienceCount,    "success"),
                            ("Training",       "fa-chalkboard",     Model.TrainingCount,      "warning"),
                            ("Publications",   "fa-book-open",      Model.PublicationCount,   "info")
                        };
                    }
                    @foreach (var (action, icon, count, color) in secs)
                    {
                        <div class="col-md-6 mb-2">
                            <a asp-controller="Faculty"
                               asp-action="@action"
                               asp-route-id="@Model.FacultyId"
                               class="btn btn-outline-@color btn-block btn-sm
                                      d-flex justify-content-between
                                      align-items-center px-3">
                                <span>
                                    <i class="fas @icon mr-2"></i>@action
                                </span>
                                <span class="badge badge-@color">
                                    @count
                                </span>
                            </a>
                        </div>
                    }
                    <div class="col-md-6 mb-2">
                        <a asp-controller="Faculty"
                           asp-action="PersonalDetails"
                           asp-route-id="@Model.FacultyId"
                           class="btn btn-outline-secondary btn-block btn-sm">
                            <i class="fas fa-id-card mr-2"></i>
                            Personal Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
 
        <!-- Dept Notices -->
        <div class="card">
            <div class="card-header bg-light d-flex
                         justify-content-between align-items-center">
                <h6 class="card-title mb-0">
                    <i class="fas fa-clipboard mr-2"></i>
                    Department Notices
                </h6>
                <a asp-controller="DeptNotice" asp-action="Create"
                   class="btn btn-xs btn-primary">
                    <i class="fas fa-plus mr-1"></i>Post Notice
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.DeptNotices.Any())
                {
                    <p class="text-muted text-center py-3 small">
                        No active notices.
                    </p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var n in Model.DeptNotices)
                        {
                            <li class="list-group-item py-2 d-flex
                                        justify-content-between">
                                <span class="small font-weight-bold">
                                    @n.Title
                                </span>
                                <small class="text-muted">@n.Date</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>