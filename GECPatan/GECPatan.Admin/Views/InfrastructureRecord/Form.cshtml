@model GECPatan.Admin.Models.ViewModels.InfrastructureRecordVM
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Infrastructure Record" : "Add Infrastructure Record";
}
 
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h3 class="card-title mb-0">
            <i class="fas fa-building mr-2"></i>@ViewData["Title"]
        </h3>
    </div>
    <form asp-action="@(isEdit?"Edit":"Create")" method="post">
        @if (isEdit)
        {
            <input asp-for="Id" type="hidden" />
        }
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    @Html.ValidationSummary(false)
                </div>
            }
 
            <div class="form-group">
                <label asp-for="RoomType" class="font-weight-bold"></label>
                <select asp-for="RoomType" class="form-control">
                    <option value="">-- Select Room Type --</option>
                    <option value="Classroom">Classroom</option>
                    <option value="Tutorial Room">Tutorial Room</option>
                    <option value="Laboratory">Laboratory</option>
                    <option value="Drawing Hall">Drawing Hall</option>
                    <option value="Computer Center">Computer Center</option>
                    <option value="Library & Reading Room">Library &amp; Reading Room</option>
                    <option value="Seminar Hall">Seminar Hall</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="RoomType" class="text-danger small"></span>
            </div>
 
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="AreaSqm" class="font-weight-bold"></label>
                        <input asp-for="AreaSqm" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="AreaSqm" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="BuildingName" class="font-weight-bold"></label>
                        <input asp-for="BuildingName" class="form-control"
                               placeholder="e.g. Civil Engineering Block" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DeptId" class="font-weight-bold"></label>
                        <select asp-for="DeptId" asp-items="Model.Departments"
                                class="form-control">
                            <option value="">-- Institute-wide --</option>
                        </select>
                    </div>
                </div>
            </div>
 
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group mt-4">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">Visible</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left mr-2"></i>Back
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>Save
            </button>
        </div>
    </form>
</div>
