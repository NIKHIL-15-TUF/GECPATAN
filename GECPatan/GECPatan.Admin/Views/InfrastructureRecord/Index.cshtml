@model List<GECPatan.Core.Models.Domain.InfrastructureRecord>
@{
    ViewData["Title"] = "Infrastructure Records — Mandatory Disclosure";
}
 
<div class="text-right mb-3">
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fas fa-plus mr-1"></i>Add Infrastructure Record
    </a>
</div>
 
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h6 class="card-title mb-0">
            <i class="fas fa-building mr-2"></i>
            Infrastructure (Rooms / Labs / Library Area)
        </h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-building fa-3x mb-3 d-block"></i>
                No infrastructure records yet.
                <a asp-action="Create">Add the first one.</a>
            </div>
        }
        else
        {
            <table class="table table-sm table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Room Type</th>
                        <th width="100">Area (sq.m)</th>
                        <th>Building</th>
                        <th>Department</th>
                        <th width="80">Status</th>
                        <th width="120">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td><strong>@i.RoomType</strong></td>
                            <td>@i.AreaSqm</td>
                            <td>@(i.BuildingName ?? "—")</td>
                            <td>@(i.Department?.Name ?? "Institute-wide")</td>
                            <td>
                                @if (i.IsVisible)
                                {
                                    <span class="badge badge-success">Visible</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Hidden</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@i.Id"
                                       class="btn btn-xs btn-info">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <button type="submit" class="btn btn-xs btn-danger"
                                            onclick="return confirm('Delete this record?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>