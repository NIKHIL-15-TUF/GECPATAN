@using GECPatan.Core.Models.Domain
@model List<FacultyPatent>

@{
    ViewData["Title"] = "Patents";
    int facultyId = ViewBag.FacultyId;
    string facultyName = ViewBag.FacultyName ?? "";
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@facultyId" class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Patents</h5>
        <small class="text-muted">@facultyName</small>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Patent
                </h6>
            </div>

            <form asp-action="AddPatent" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <input type="hidden" name="FacultyId" value="@facultyId" />

                    <div class="form-group">
                        <label class="font-weight-bold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <textarea name="Title"
                                  class="form-control"
                                  rows="3"
                                  required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Application No.</label>
                        <input name="ApplicationNo" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Granted Year</label>
                        <input name="GrantedYear" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Status</label>
                        <select name="Status" class="form-control">
                            <option value="Filed">Filed</option>
                            <option value="Published">Published</option>
                            <option value="Granted">Granted</option>
                        </select>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-lightbulb mr-2"></i>Patents (@Model.Count)
                </h6>
            </div>

            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">
                        No patents added yet.
                    </p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Title</th>
                                <th>Application No</th>
                                <th>Year</th>
                                <th>Status</th>
                                <th width="60"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.Title</td>
                                    <td>@p.ApplicationNo</td>
                                    <td>@p.GrantedYear</td>
                                    <td>
                                        <span class="badge badge-info">@p.Status</span>
                                    </td>
                                    <td>
                                        <form asp-action="DeletePatent" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.FacultyPatentId" />
                                            <input type="hidden" name="facultyId" value="@facultyId" />

                                            <button type="submit"
                                                    class="btn btn-xs btn-danger"
                                                    onclick="return confirm('Remove this patent?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>