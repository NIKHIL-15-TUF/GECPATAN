@using GECPatan.Core.Models.Domain
@model List<FacultyResearchGuidance>
@{
    ViewData["Title"] = "Research Guidance";
    int facultyId = ViewBag.FacultyId;
    string facultyName = ViewBag.FacultyName ?? "";
    var masters = Model.FirstOrDefault(r => r.Level == "Masters");
    var phd     = Model.FirstOrDefault(r => r.Level == "PhD");
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@facultyId" class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Research Guidance</h5>
        <small class="text-muted">@facultyName</small>
    </div>
</div>
<div class="row">
    <!-- Upsert Form -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-save mr-2"></i>Save / Update Guidance
                </h6>
            </div>
            <form asp-action="SaveResearchGuidance" method="post">
                <div class="card-body">
                    <input type="hidden" name="FacultyId" value="@facultyId" />

                    <div class="form-group">
                        <label class="font-weight-bold">Level</label>
                        <select name="Level" class="form-control" id="levelSelect"
                                onchange="loadValues(this.value)">
                            <option value="Masters">Masters</option>
                            <option value="PhD">PhD</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Ongoing</label>
                                <input name="Ongoing" id="ongoingInput"
                                       type="number" min="0"
                                       class="form-control" value="0" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Completed</label>
                                <input name="Completed" id="completedInput"
                                       type="number" min="0"
                                       class="form-control" value="0" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Current Values -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-user-graduate mr-2"></i>Current Research Guidance
                </h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Level</th>
                            <th>Ongoing</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Masters</strong></td>
                            <td>
                                <span class="badge badge-warning">@(masters?.Ongoing ?? 0)</span>
                            </td>
                            <td>
                                <span class="badge badge-success">@(masters?.Completed ?? 0)</span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>PhD</strong></td>
                            <td>
                                <span class="badge badge-warning">@(phd?.Ongoing ?? 0)</span>
                            </td>
                            <td>
                                <span class="badge badge-success">@(phd?.Completed ?? 0)</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1"></i>
                    Select a level in the form and click <strong>Save</strong> to update its counts.
                    Values are pre-filled automatically when you switch level.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pre-fill form when switching level
        const guidanceData = {
            'Masters': { Ongoing: @(masters?.Ongoing ?? 0), Completed: @(masters?.Completed ?? 0) },
            'PhD':     { Ongoing: @(phd?.Ongoing ?? 0),     Completed: @(phd?.Completed ?? 0) }
        };
        function loadValues(level) {
            const d = guidanceData[level] || { Ongoing: 0, Completed: 0 };
            document.getElementById('ongoingInput').value   = d.Ongoing;
            document.getElementById('completedInput').value = d.Completed;
        }
        // seed on load
        loadValues(document.getElementById('levelSelect').value);
    </script>
}