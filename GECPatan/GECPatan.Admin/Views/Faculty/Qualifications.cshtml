@using GECPatan.Admin.Models.Domain
@model List<FacultyQualification>
@{
    ViewData["Title"] = "Qualifications";
    int facultyId = ViewBag.FacultyId;
    string facultyName = ViewBag.FacultyName ?? "";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@facultyId" class="btn btn-secondary btn-sm mr-3"><i class="fas fa-arrow-left"></i></a>
    <div><h5 class="mb-0">Educational Qualifications</h5><small class="text-muted">@facultyName</small></div>
</div>
<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0"><i class="fas fa-plus mr-2"></i>Add Qualification</h6>
            </div>
            <form asp-action="AddQualification" method="post">
                <div class="card-body">
                    <input type="hidden" name="FacultyId" value="@facultyId" />
                    <div class="form-group">
                        <label class="font-weight-bold">Degree <span class="text-danger">*</span></label>
                        <input name="Degree" class="form-control" placeholder="e.g. Ph.D, M.Tech, B.E" required />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">University</label>
                        <input name="University" class="form-control" placeholder="University name" />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Year</label>
                                <input name="Year" class="form-control" placeholder="e.g. 2015" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Specialization</label>
                                <input name="Specialization" class="form-control" placeholder="Optional" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-plus mr-2"></i>Add</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0"><i class="fas fa-graduation-cap mr-2"></i>Qualifications (@Model.Count)</h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No qualifications added yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr><th>Degree</th><th>University</th><th>Year</th><th width="60"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model)
                            {
                                <tr>
                                    <td><strong>@q.Degree</strong>@if (!string.IsNullOrEmpty(q.Specialization)){
                                        <small class="text-muted d-block">@q.Specialization</small>
                                    }
                                </td>
                                <td>@q.University</td>
                                <td>@q.Year</td>
                                <td>
                                    <form asp-action="DeleteQualification" method="post">
                                        <input type="hidden" name="id" value="@q.FacultyQualificationId" />
                                        <input type="hidden" name="facultyId" value="@facultyId" />
                                        <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('Remove?')"><i class="fas fa-times"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
</div>