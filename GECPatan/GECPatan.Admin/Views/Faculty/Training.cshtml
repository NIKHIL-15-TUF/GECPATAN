@using GECPatan.Admin.Models.Domain
@model List<FacultyTraining>
@{
    ViewData["Title"] = "Training & Workshops";
    int facultyId = ViewBag.FacultyId;
    string facultyName = ViewBag.FacultyName ?? "";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@facultyId" class="btn btn-secondary btn-sm mr-3"><i class="fas fa-arrow-left"></i></a>
    <div><h5 class="mb-0">Training & Workshops</h5><small class="text-muted">@facultyName</small></div>
</div>
<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0"><i class="fas fa-plus mr-2"></i>Add Training</h6>
            </div>
            <form asp-action="AddTraining" method="post">
                <div class="card-body">
                    <input type="hidden" name="FacultyId" value="@facultyId" />
                    <div class="form-group">
                        <label class="font-weight-bold">Title <span class="text-danger">*</span></label>
                        <input name="Title" class="form-control" placeholder="Training/Workshop title" required />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Organized By</label>
                        <input name="OrganizedBy" class="form-control" placeholder="Organization name" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Date</label>
                        <input name="Date" class="form-control" placeholder="e.g. Jan 2023 or 15-20 Jan 2023" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-plus mr-2"></i>Add</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0"><i class="fas fa-chalkboard mr-2"></i>Training Records (@Model.Count)</h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No training records yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr><th>Title</th><th>Organized By</th><th>Date</th><th width="60"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td><strong>@t.Title</strong></td>
                                    <td>@t.OrganizedBy</td>
                                    <td>@t.Date</td>
                                    <td>
                                        <form asp-action="DeleteTraining" method="post">
                                            <input type="hidden" name="id" value="@t.FacultyTrainingId" />
                                            <input type="hidden" name="facultyId" value="@facultyId" />
                                            <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('Remove?')"><i class="fas fa-times"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>