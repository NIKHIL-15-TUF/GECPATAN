@using GECPatan.Core.Models.Domain
@model List<FacultyExperience>
@{
    ViewData["Title"] = "Experience";
    int facultyId     = ViewBag.FacultyId;
    string facultyName= ViewBag.FacultyName ?? "";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@facultyId"
       class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Professional Experience</h5>
        <small class="text-muted">@facultyName</small>
    </div>
</div>
<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Experience
                </h6>
            </div>
            <form asp-action="AddExperience" method="post">
                <div class="card-body">
                    <input type="hidden" name="FacultyId" value="@facultyId" />
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Position <span class="text-danger">*</span>
                        </label>
                        <input name="Position" class="form-control"
                               placeholder="e.g. Assistant Professor" required />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Organization <span class="text-danger">*</span>
                        </label>
                        <input name="Organization" class="form-control"
                               placeholder="College/Company name" required />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">From Date</label>
                                <input name="FromDate" class="form-control"
                                       type="date" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">
                                    To Date
                                    <small class="text-muted">(blank=Present)</small>
                                </label>
                                <input name="ToDate" class="form-control"
                                       type="date" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-briefcase mr-2"></i>
                    Experience (@Model.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No experience records yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Position</th>
                                <th>Organization</th>
                                <th>Duration</th>
                                <th width="60"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model)
                            {
                                <tr>
                                    <td><strong>@e.Position</strong></td>
                                    <td>@e.Organization</td>
                                    <td>
                                        <small>
                                            @(e.FromDate.HasValue
                                                ? e.FromDate.Value.ToString("MMM yyyy")
                                                : "")
                                            →
                                            @(e.ToDate.HasValue
                                                ? e.ToDate.Value.ToString("MMM yyyy")
                                                : "Present")
                                        </small>
                                    </td>
                                    <td>
                                        <form asp-action="DeleteExperience" method="post">
                                            <input type="hidden" name="id"
                                                   value="@e.FacultyExperienceId" />
                                            <input type="hidden" name="facultyId"
                                                   value="@facultyId" />
                                            <button type="submit"
                                                    class="btn btn-xs btn-danger"
                                                    onclick="return confirm('Remove?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>