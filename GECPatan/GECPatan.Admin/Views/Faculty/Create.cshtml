@model GECPatan.Admin.Models.ViewModels.FacultyCreateVM
@{
    ViewData["Title"] = "Add Faculty";
}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title"><i class="fas fa-user-plus mr-2"></i>Add Faculty Member</h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group">
                                <label asp-for="Name" class="font-weight-bold"></label>
                                <input asp-for="Name" class="form-control" placeholder="Full name e.g. Dr. John Smith" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label asp-for="Designation" class="font-weight-bold"></label>
                                <input asp-for="Designation" class="form-control" placeholder="e.g. Associate Professor" />
                                <span asp-validation-for="Designation" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group">
                                <label asp-for="DeptId" class="font-weight-bold"></label>
                                <select asp-for="DeptId" asp-items="Model.Departments" class="form-control">
                                    <option value="">-- Select Department --</option>
                                </select>
                                <span asp-validation-for="DeptId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label asp-for="DateOfJoining" class="font-weight-bold"></label>
                                <input asp-for="DateOfJoining" class="form-control" type="date" />
                                <span asp-validation-for="DateOfJoining" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Qualification" class="font-weight-bold"></label>
                                <input asp-for="Qualification" class="form-control" placeholder="e.g. Ph.D, M.Tech" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="AreaOfInterest" class="font-weight-bold"></label>
                                <input asp-for="AreaOfInterest" class="form-control" placeholder="e.g. Machine Learning, IoT" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="Website" class="font-weight-bold"></label>
                                <input asp-for="Website" class="form-control" placeholder="https://..." />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SeniorityOrder" class="font-weight-bold"></label>
                                <input asp-for="SeniorityOrder" class="form-control" type="number" min="0" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Faculty Photo</label>
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="Photo" name="Photo" accept="image/*" onchange="previewPhoto(this)" />
                                    <label class="custom-file-label" for="Photo">Choose photo...</label>
                                </div>
                                <small class="text-muted">Recommended: Square image, min 200x200px</small>
                            </div>
                            <div class="col-md-4 text-center">
                                <img id="photoPreview" src="#" class="img-thumbnail rounded-circle d-none" style="width:80px;height:80px;object-fit:cover;" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsTeaching" type="checkbox" class="custom-control-input" id="isTeaching" />
                            <label class="custom-control-label" for="isTeaching">Teaching Staff <small class="text-muted ml-1">(Uncheck for non-teaching/lab staff)</small></label>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left mr-2"></i>Back</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-2"></i>Save Faculty</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0"><i class="fas fa-info-circle mr-2 text-info"></i>Next Steps</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-2">After saving, add more details from faculty list:</p>
                <ul class="small text-muted pl-3">
                    <li class="mb-1"><i class="fas fa-graduation-cap mr-1 text-primary"></i>Educational Qualifications</li>
                    <li class="mb-1"><i class="fas fa-briefcase mr-1 text-success"></i>Professional Experience</li>
                    <li class="mb-1"><i class="fas fa-chalkboard mr-1 text-warning"></i>Training & Workshops</li>
                    <li class="mb-1"><i class="fas fa-book mr-1 text-danger"></i>Publications</li>
                    <li class="mb-1"><i class="fas fa-id-card mr-1 text-info"></i>Personal Details</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function previewPhoto(input) {
        const preview = document.getElementById('photoPreview');
        if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.classList.remove('d-none'); };
        reader.readAsDataURL(input.files[0]);
        input.nextElementSibling.textContent = input.files[0].name;
        }
        }
    </script>
}