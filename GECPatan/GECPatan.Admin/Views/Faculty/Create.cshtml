@model GECPatan.Admin.Models.ViewModels.FacultyCreateVM
@{
    ViewData["Title"] = "Add Faculty";
}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-user-plus mr-2"></i>Add Faculty Member
                </h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group">
                                <label asp-for="Name" class="font-weight-bold"></label>
                                <input asp-for="Name" class="form-control"
                                       placeholder="Full name e.g. Dr. John Smith" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label asp-for="Designation" class="font-weight-bold"></label>
                                <select asp-for="Designation"
                                        asp-items="Model.Designations"
                                        class="form-control"
                                        id="designationSelect"
                                        onchange="updateTeachingBadge(this.value)">
                                    <option value="">-- Select Designation --</option>
                                </select>
                                <span asp-validation-for="Designation" class="text-danger small"></span>
                                <div id="teachingBadge" class="mt-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group">
                                <label asp-for="DeptId" class="font-weight-bold"></label>
                                <select asp-for="DeptId" asp-items="Model.Departments"
                                        class="form-control">
                                    <option value="">-- Select Department --</option>
                                </select>
                                <span asp-validation-for="DeptId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label asp-for="DateOfJoining" class="font-weight-bold"></label>
                                <input asp-for="DateOfJoining" class="form-control" type="date" />
                                <span asp-validation-for="DateOfJoining" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="AreaOfInterest" class="font-weight-bold"></label>
                                <input asp-for="AreaOfInterest" class="form-control"
                                       placeholder="e.g. Machine Learning, IoT" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="LetterNumber" class="font-weight-bold"></label>
                                <input asp-for="LetterNumber" class="form-control"
                                       placeholder="GECP/APP/2026/001...." />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Website" class="font-weight-bold"></label>
                                <input asp-for="Website" class="form-control"
                                       placeholder="https://..." />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label asp-for="SeniorityOrder" class="font-weight-bold"></label>
                                <input asp-for="SeniorityOrder" class="form-control"
                                       type="number" min="0" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Faculty Photo</label>
                        <div class="row align-items-center">
                            <div class="col-8">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input"
                                           id="Photo" name="Photo" accept="image/*"
                                           onchange="previewPhoto(this)" />
                                    <label class="custom-file-label" for="Photo">
                                        Choose photo...
                                    </label>
                                </div>
                                <small class="text-muted">Square image recommended</small>
                            </div>
                            <div class="col-4 text-center">
                                <img id="photoPreview" src="#"
                                     class="img-thumbnail rounded-circle d-none"
                                     style="width:70px;height:70px;object-fit:cover;" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save Faculty
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-info"></i>Designation Guide
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="p-2 border-bottom">
                    <small class="font-weight-bold text-primary d-block mb-1">
                        Teaching Staff
                    </small>
                    <small class="text-muted d-block">• Professor</small>
                    <small class="text-muted d-block">• Associate Professor</small>
                    <small class="text-muted d-block">• Assistant Professor</small>
                </div>
                <div class="p-2">
                    <small class="font-weight-bold text-secondary d-block mb-1">
                        Non-Teaching Staff
                    </small>
                    <small class="text-muted d-block">• Lab Assistant</small>
                    <small class="text-muted d-block">• Technical Assistant</small>
                    <small class="text-muted d-block">• Clerk / Other</small>
                </div>
                <div class="p-2 bg-light border-top">
                    <small class="text-muted">
                        <i class="fas fa-info-circle mr-1"></i>
                        <strong>IsTeaching</strong> is set automatically from designation.
                        Qualification is added from the sub-section after saving.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const teachingDesignations = [
        'Professor', 'Associate Professor', 'Assistant Professor'
        ];
 
        function updateTeachingBadge(val) {
        const badge = document.getElementById('teachingBadge');
        if (!val) { badge.innerHTML = ''; return; }
        const isTeaching = teachingDesignations.includes(val);
        badge.innerHTML = isTeaching
        ? '<span class="badge badge-primary">Teaching Staff</span>'
        : '<span class="badge badge-secondary">Non-Teaching Staff</span>';
        }
 
        function previewPhoto(input) {
        const preview = document.getElementById('photoPreview');
        if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
        preview.src = e.target.result;
        preview.classList.remove('d-none');
        };
        reader.readAsDataURL(input.files[0]);
        input.nextElementSibling.textContent = input.files[0].name;
        }
        }
 
        // Show badge for existing value
        updateTeachingBadge(document.getElementById('designationSelect')?.value);
    </script>
}