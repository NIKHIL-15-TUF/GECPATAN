@model GECPatan.Admin.Models.ViewModels.PersonalDetailVM
@{
    ViewData["Title"] = "Personal Details";
    int facultyId = ViewBag.FacultyId;
    string facultyName = ViewBag.FacultyName ?? "";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@facultyId" class="btn btn-secondary btn-sm mr-3"><i class="fas fa-arrow-left"></i></a>
    <div><h5 class="mb-0">Personal Details</h5><small class="text-muted">@facultyName</small></div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0"><i class="fas fa-id-card mr-2"></i>Contact & Details</h6>
            </div>
            <form asp-action="SavePersonalDetails" method="post">
                <div class="card-body">
                    <input type="hidden" name="FacultyId" value="@facultyId" />
                    <input type="hidden" name="PersonalDetailId" value="@Model.PersonalDetailId" />
                    <div class="form-group">
                        <label class="font-weight-bold">Department</label>
                        <input name="Department" class="form-control" value="@Model.Department" placeholder="Department name (as shown on profile)" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Contact Number</label>
                        <input name="Contact" class="form-control" value="@Model.Contact" placeholder="e.g. +91 9876543210" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Email Address</label>
                        <input name="Email" class="form-control" type="email" value="@Model.Email" placeholder="official@gecpatan.ac.in" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-save mr-2"></i>Save Details</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0"><i class="fas fa-info-circle mr-2 text-info"></i>Note</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted">These details are shown on the faculty profile page on the public website.</p>
                <p class="small text-muted">The <strong>Department</strong> field is the display name shown on the faculty card.</p>
                <p class="small text-muted mb-0">The <strong>Email</strong> field is the public contact email shown on the profile page.</p>
            </div>
        </div>
    </div>
</div>