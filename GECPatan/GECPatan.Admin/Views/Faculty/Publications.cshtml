@using GECPatan.Core.Models.Domain
@model List<FacultyPublication>
@{
    ViewData["Title"] = "Publications";
    int facultyId = ViewBag.FacultyId;
    string facultyName = ViewBag.FacultyName ?? "";
    int nextSrNo = Model.Any() ? Model.Max(p => p.SrNo) + 1 : 1;
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@facultyId" class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Publications</h5>
        <small class="text-muted">@facultyName</small>
    </div>
</div>
<div class="row">
    <!-- Add Form -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Publication
                </h6>
            </div>
            <form asp-action="AddPublication" method="post">
                <div class="card-body">
                    <input type="hidden" name="FacultyId" value="@facultyId" />

                    <div class="form-group">
                        <label class="font-weight-bold">Sr. No.</label>
                        <input name="SrNo" class="form-control" type="number"
                               value="@nextSrNo" min="1" />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <textarea name="Title" class="form-control" rows="3"
                                  placeholder="Full publication title..." required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Type</label>
                        <select name="Type" class="form-control">
                            <option value="International">International Journal</option>
                            <option value="National">National Journal</option>
                            <option value="Conference">Conference</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Journal / Conference Name</label>
                        <input name="JournalName" class="form-control"
                               placeholder="e.g. IEEE Transactions..." />
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Year</label>
                                <input name="Year" class="form-control" placeholder="e.g. 2023" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Co-Authors</label>
                                <input name="CoAuthors" class="form-control"
                                       placeholder="e.g. A. Sharma, B. Patel" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- List -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-book mr-2"></i>Publications (@Model.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No publications added yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th width="40">Sr.</th>
                                <th>Title</th>
                                <th width="95">Type</th>
                                <th>Journal</th>
                                <th width="50">Year</th>
                                <th width="50"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="text-muted">@p.SrNo</td>
                                    <td style="font-size:13px;">
                                        @p.Title
                                        @if (!string.IsNullOrEmpty(p.CoAuthors))
                                        {
                                            <small class="text-muted d-block">@p.CoAuthors</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-@(p.Type == "International" ? "primary" : p.Type == "National" ? "success" : "warning")">
                                            @p.Type
                                        </span>
                                    </td>
                                    <td><small>@p.JournalName</small></td>
                                    <td>@p.Year</td>
                                    <td>
                                        <form asp-action="DeletePublication" method="post">
                                            <input type="hidden" name="id"
                                                   value="@p.FacultyPublicationId" />
                                            <input type="hidden" name="facultyId"
                                                   value="@facultyId" />
                                            <button type="submit"
                                                    class="btn btn-xs btn-danger"
                                                    onclick="return confirm('Remove?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>