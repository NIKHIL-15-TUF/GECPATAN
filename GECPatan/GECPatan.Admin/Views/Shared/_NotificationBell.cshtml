@using Microsoft.AspNetCore.Identity
@using GECPatan.Core.Models.Domain
@using GECPatan.Core.Services
@inject UserManager<ApplicationUser> UserManager
@inject NotificationService NotifyService
 
@{
    var user = await UserManager.GetUserAsync(User);
    var userId = user?.Id ?? "";
    var roles = user != null
        ? await UserManager.GetRolesAsync(user)
        : new List<string>();
    var role = roles.FirstOrDefault() ?? "";
 
    var items = await NotifyService.GetLatestAsync(userId, role, 10);
    var count = await NotifyService.GetUnreadCountAsync(userId, role);
}
 
<li class="nav-item dropdown">
    <a class="nav-link" data-toggle="dropdown" href="#"
           id="bellBtn" title="Notifications">
        <i class="far fa-bell"></i>
        @if (count > 0)
        {
            <span class="badge badge-danger navbar-badge"
                  style="font-size:10px;">
                @(count > 99 ? "99+" : count.ToString())
            </span>
        }
    </a>
 
    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right"
         style="min-width:360px;">
 
        <!-- Header -->
        <div class="dropdown-item dropdown-header d-flex
            justify-content-between align-items-center
            py-2">
            <span>
                <i class="fas fa-bell mr-1"></i>
                Notifications
                @if (count > 0)
                {
                    <span class="badge badge-primary ml-1">
                        @count unread
                    </span>
                }
            </span>
            @if (count > 0)
            {
                <form asp-controller="Notification"
                      asp-action="MarkAllRead"
                      method="post" class="d-inline">
                    <button type="submit"
                            class="btn btn-xs btn-link text-primary p-0"
                            style="font-size:11px;">
                        Mark all read
                    </button>
                </form>
            }
        </div>
 
        <div class="dropdown-divider my-0"></div>
 
        <!-- Items -->
        @if (!items.Any())
        {
            <div class="dropdown-item text-center text-muted py-3">
                <i class="fas fa-bell-slash fa-2x mb-2 d-block
                text-light"></i>
                <small>No notifications in last 30 days</small>
            </div>
        }
        else
        {
            @foreach (var n in items)
            {
                string href = n.Link != null
                    ? $"/Notification/Read/{n.Id}?link={Uri.EscapeDataString(n.Link)}"
                    : $"/Notification/Read/{n.Id}";
 
                <a href="@href"
                       class="dropdown-item py-2"
                       style="@(!n.IsRead
                                                              ? "background:#f0f4ff;border-left:3px solid #1a237e;"
                                                              : "border-left:3px solid transparent;")">
                    <div class="d-flex align-items-start">
                        <div class="mr-2 mt-1">
                            <span class="badge badge-@n.IconColor p-1"
                                  style="width:28px;height:28px;
                                display:flex;align-items:center;
                                justify-content:center;">
                                <i class="fas @n.Icon"
                                   style="font-size:11px;"></i>
                            </span>
                        </div>
                        <div class="flex-fill overflow-hidden">
                            <div class="d-flex justify-content-between">
                                <span class="@(!n.IsRead ? "font-weight-bold" : "")"
                                      style="font-size:12px;
                                    white-space:normal;
                                    line-height:1.3;">
                                    @n.Title
                                </span>
                                <small class="text-muted ml-1 flex-shrink-0"
                                       style="font-size:10px;">
                                    @n.TimeAgo
                                </small>
                            </div>
                            @if (!string.IsNullOrEmpty(n.Message))
                            {
                                <small class="text-muted d-block"
                                       style="font-size:10px;
                                    white-space:normal;">
                                    @n.Message
                                </small>
                            }
                        </div>
                    </div>
                </a>
                <div class="dropdown-divider my-0"></div>
            }
        }
 
        <!-- Footer -->
        <a asp-controller="Notification" asp-action="Index"
               class="dropdown-item dropdown-footer text-center py-2"
               style="font-size:12px;">
            <i class="fas fa-list mr-1"></i>
            See All Notifications
        </a>
    </div>
</li>