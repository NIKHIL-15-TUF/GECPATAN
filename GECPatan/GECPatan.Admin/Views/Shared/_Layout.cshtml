<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GEC Patan Admin</title>

    <!-- 🔷 AdminLTE CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

</head>
<body class="hold-transition sidebar-mini layout-fixed">

    <div class="wrapper">

        <!-- 🔷 Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        
            <!-- Sidebar toggle -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>

            <!-- Right side -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <span class="nav-link">Welcome, Admin</span>
                </li>
            </ul>
        </nav>

        <!-- 🔷 Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
        
            <!-- Brand Logo -->
           
            <a href="/" class="brand-link text-center">
                <img src="/adminlte/img/GECP_LOGO_recreated.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">GEC Patan Admin</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">

                <!-- Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview">

                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-home"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Department" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-building"></i>
                                <p>Departments</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Faculty" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Faculties</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="CampusCommittee" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-building"></i>
                                <p>Campus Committees</p>
                            </a>
                        </li>
                        @* <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-flask"></i>
                                <p>Labs</p>
                            </a>
                        </li> *@
                        <li class="nav-header">HOME PAGE</li>

                        <li class="nav-item">
                            <a asp-controller="Slider" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Slider" ? "active" : "")">
                                <i class="nav-icon fas fa-images"></i>
                                <p>Master Slider</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Marquee" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Marquee" ? "active" : "")">
                                <i class="nav-icon fas fa-bullhorn"></i>
                                <p>Marquee</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Testimonial" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Testimonial" ? "active" : "")">
                                <i class="nav-icon fas fa-comments"></i>
                                <p>Testimonial</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="TopRecruiter" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TopRecruiter" ? "active" : "")">
                                <i class="nav-icon fas fa-briefcase"></i>
                                <p>Top Recruiters</p>
                            </a>
                        </li>
                        <li class="nav-header">INSTITUTE</li>
                        <li class="nav-item">
                            <a asp-controller="AboutUs" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AboutUs" ? "active" : "")">
                                <i class="nav-icon fas fa-university"></i>
                                <p>About Us</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="NewsItem" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NewsItem" ? "active" : "")">
                                <i class="nav-icon fas fa-newspaper"></i>
                                <p>News & Notices</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="NewsLetter" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NewsLetter" ? "active" : "")">
                                <i class="nav-icon fas fa-file-pdf"></i>
                                <p>News Letters</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="TenderCategory" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tender" ? "active" : "")">
                                <i class="nav-icon fas fa-file-contract"></i>
                                <p>Tenders</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="ImportantDocument" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ImportantDocument" ? "active" : "")">
                                <i class="nav-icon fas fa-folder-open"></i>
                                <p>Important Docs</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="MoU" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MoU" ? "active" : "")">
                                <i class="nav-icon fas fa-handshake"></i>
                                <p>MoU Documents</p>
                            </a>
                        </li>
                        <li class="nav-header">ACADEMICS</li>
                        <li class="nav-item">
                            <a asp-controller="AcademicCalendar" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AcademicCalendar" ? "active" : "")">
                                <i class="nav-icon fas fa-calendar-alt"></i>
                                <p>Academic Calendars</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="SSIPDocument" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SSIPDocument" ? "active" : "")">
                                <i class="nav-icon fas fa-lightbulb"></i>
                                <p>SSIP Documents</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="ResearchGrant" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ResearchGrant" ? "active" : "")">
                                <i class="nav-icon fas fa-flask"></i>
                                <p>Research Grants</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="ProgramIntake" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProgramIntake" ? "active" : "")">
                                <i class="nav-icon fas fa-graduation-cap"></i>
                                <p>Program Intake</p>
                            </a>
                        </li>
                        <li class="nav-header">Placement</li>
                        <li class="nav-item">
                            <a asp-controller="Placement" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Placement" ? "active" : "")">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>Placement Statistics</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="PlacementTeam" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PlacementTeam" ? "active" : "")">
                                <i class="nav-icon fas fa-user-graduate"></i>
                                <p>Placement Team</p>
                            </a>
                        </li>
                        <li class="nav-header">STUDENT CORNER</li>
                        <li class="nav-item">
                            <a asp-controller="StudentClub" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StudentClub" ? "active" : "")">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Student Clubs</p>
                            </a>
                        </li>
                        <li class="nav-header">FACILITIES</li>
                        <li class="nav-item">
                            <a asp-controller="Facility" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Facility" ? "active" : "")">
                                <i class="nav-icon fas fa-building"></i>
                                <p>Facility Pages</p>
                            </a>
                        </li>
                         <li class="nav-header">ADMINISTRATION</li>
                        <li class="nav-item">
                            <a asp-controller="Principal" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Principal" ? "active" : "")">
                                <i class="nav-icon fas fa-user-tie"></i>
                                <p>Principal Profile</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Contact" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")">
                                <i class="nav-icon fas fa-phone-alt"></i>
                                <p>Contact Info</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Gallery" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gallery" ? "active" : "")">
                                <i class="nav-icon fas fa-images"></i>
                                <p>Gallery</p>
                            </a>
                        </li>
                        
                        <!-- 🔴 Logout -->
                        <li class="nav-header">Logout</li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="nav-link btn btn-link text-left">
                                    <i class="nav-icon fas fa-door-open"></i>
                                    <p>Logout</p>
                                </button>
                            </form>
                        </li> 
                    </ul>
                </nav>

            </div>
        </aside>

        <!-- 🔷 Content Wrapper -->
        <div class="content-wrapper">

            <!-- Header -->
            <section class="content-header">
                <div class="container-fluid">
                    <h1>@ViewData["Title"]</h1>
                </div>
            </section>

            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>

        </div>

        <!-- 🔷 Footer -->
        <footer class="main-footer text-center">
            <strong>© 2026 GEC Patan</strong>
        </footer>

    </div>

    <!-- 🔷 Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>