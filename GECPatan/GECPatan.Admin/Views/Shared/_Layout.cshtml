<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GEC Patan Admin</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <!-- Custom CSS -->
    <style>
            body {
                background-color: #f4f6f9;
            }

            .navbar {
                background-color: #343a40;
            }

            .navbar-brand {
                font-weight: bold;
            }

            .sidebar {
                min-height: 100vh;
                background: #2c3e50;
                color: white;
            }

                .sidebar a {
                    color: white;
                    display: block;
                    padding: 10px;
                }

                    .sidebar a:hover {
                        background: #1a252f;
                        text-decoration: none;
                    }

            .content-wrapper {
                padding: 20px;
            }
    </style>
</head>
<body>

    <!-- 🔷 Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <a class="navbar-brand" href="/">GEC Patan Admin</a>

        <div class="ml-auto text-white">
            Welcome, Admin
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- 🔷 Sidebar -->
            <div class="col-md-2 sidebar p-0">
                <h5 class="text-center py-3">Menu</h5>

                <a asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home mr-2"></i> Dashboard
                </a>

                <a asp-controller="Department" asp-action="Index">
                    <i class="fas fa-building mr-2"></i> Departments
                </a>

                <a href="#">
                    <i class="fas fa-users mr-2"></i> Faculties
                </a>

                <a href="#">
                    <i class="fas fa-flask mr-2"></i> Labs
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-danger">Logout</button>
                </form>
            </div>

            <!-- 🔷 Main Content -->
            <div class="col-md-10 content-wrapper">
                @RenderBody()  <!-- 🔥 MOST IMPORTANT -->
            </div>

        </div>
    </div>

    <!-- 🔷 Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>