@model List<GECPatan.Admin.Models.ViewModels.MenuItemTreeVM>
@{
    bool isFooter = ViewBag.IsFooter == true;
    string menuType = ViewBag.MenuType ?? "Main";
    ViewData["Title"] = isFooter ? "Footer Menu" : "Navigation Menu";
}
 
<!-- Tab switcher -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="btn-group">
            <a asp-action="Index" asp-route-menuType="Main"
                   class="btn btn-sm @(menuType == "Main" ? "btn-primary" : "btn-outline-primary")">
                <i class="fas fa-bars mr-1"></i>Navigation Menu
            </a>
            <a asp-action="Index" asp-route-menuType="Footer"
                   class="btn btn-sm @(menuType == "Footer" ? "btn-primary" : "btn-outline-primary")">
                <i class="fas fa-grip-horizontal mr-1"></i>Footer Menu
            </a>
        </div>
    </div>
    <div class="col-md-6 text-right">
        <a asp-action="Create"
               asp-route-menuType="@menuType"
               class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-1"></i>Add Top-Level Item
        </a>
    </div>
</div>
 
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h6 class="card-title mb-0">
            <i class="fas fa-sitemap mr-2"></i>
            @(isFooter ? "Footer" : "Navigation") Menu — Tree View
            <small class="ml-2 opacity-75">
                (@Model.Count top-level items)
            </small>
        </h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-sitemap fa-3x mb-3 d-block"></i>
                No menu items yet. Click
                <strong>Add Top-Level Item</strong> to start.
            </div>
        }
        else
        {
            <table class="table table-sm table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Menu Item</th>
                        <th width="120">Link Type</th>
                        <th width="200">Target</th>
                        <th width="60">Order</th>
                        <th width="70">Status</th>
                        <th width="180">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        @await Html.PartialAsync("_MenuTreeRow",
                            (item, menuType))
                    }
                </tbody>
            </table>
        }
    </div>
</div>