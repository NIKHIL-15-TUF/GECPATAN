@model List<GECPatan.Admin.Models.ViewModels.MenuItemTreeVM>
@{
    string menuType = ViewBag.MenuType ?? "Main";
    bool isFooter = menuType == "Footer";
}
 
<!-- Tabs + Add button -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group">
        <a asp-action="Index" asp-route-menuType="Main"
               class="btn btn-sm @(menuType == "Main" ? "btn-primary" : "btn-outline-primary")">
            <i class="fas fa-bars mr-1"></i>Main Navbar
        </a>
        <a asp-action="Index" asp-route-menuType="Footer"
               class="btn btn-sm @(menuType == "Footer" ? "btn-primary" : "btn-outline-primary")">
            <i class="fas fa-grip-horizontal mr-1"></i>Footer
        </a>
    </div>
    <a asp-action="Create" asp-route-menuType="@menuType"
           class="btn btn-success btn-sm">
        <i class="fas fa-plus mr-1"></i>Add Top-Level Item
    </a>
</div>
 
<!-- Legend -->
<div class="d-flex mb-3" style="gap:8px;flex-wrap:wrap;">
    <span class="badge badge-secondary px-2 py-1">
        <i class="fas fa-ban mr-1"></i>No Link
    </span>
    <span class="badge badge-primary px-2 py-1">
        <i class="fas fa-link mr-1"></i>Internal
    </span>
    <span class="badge badge-success px-2 py-1">
        <i class="fas fa-database mr-1"></i>Dynamic
    </span>
    <span class="badge badge-info px-2 py-1">
        <i class="fas fa-external-link-alt mr-1"></i>External/PDF
    </span>
    <span class="badge badge-warning px-2 py-1">
        <i class="fas fa-eye-slash mr-1"></i>Hidden
    </span>
</div>
 
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-sitemap fa-3x mb-3 d-block"></i>
                No menu items yet.
                <a asp-action="Create" asp-route-menuType="@menuType">
                    Add your first item
                </a>
            </div>
        }
        else
        {
            <table class="table table-sm mb-0" id="menuTree">
                <thead style="background:#1a237e;color:#fff;">
                    <tr>
                        <th>Menu Item</th>
                        <th width="100">Type</th>
                        <th width="220">Links To</th>
                        <th width="110">Order</th>
                        <th width="70">Status</th>
                        <th width="190">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        @await Html.PartialAsync("_MenuRow", item, ViewData)
                    }
                </tbody>
            </table>
        }
    </div>
</div>  