@model GECPatan.Admin.Models.ViewModels.MenuItemFormVM
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Menu Item" : "Add Menu Item";
}
 
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title mb-0">
                    <i class="fas fa-bars mr-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <form asp-action="@(isEdit?"Edit":"Create")" method="post">
                @if (isEdit)
                {
                    <input asp-for="Id" type="hidden" />
                }
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">
                            @Html.ValidationSummary(false)
                        </div>
                    }
 
                    <!-- Row 1: Text + Section -->
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="MenuText" class="font-weight-bold"></label>
                                <input asp-for="MenuText" class="form-control"
                                       placeholder="e.g. About Us" autofocus />
                                <span asp-validation-for="MenuText"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="MenuType" class="font-weight-bold"></label>
                                <select asp-for="MenuType" class="form-control">
                                    <option value="Top">Top Bar</option>
                                    <option value="Main">Main Navbar</option>
                                    <option value="Footer">Footer</option>
                                </select>
                            </div>
                        </div>
                    </div>
 
                    <!-- Row 2: Parent + Position -->
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="ParentId" class="font-weight-bold"></label>
                                <select asp-for="ParentId"
                                        asp-items="Model.ParentOptions"
                                        class="form-control">
                                </select>
                                <small class="text-muted">
                                    Choose parent or leave as Top Level
                                </small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Position" class="font-weight-bold"></label>
                                <input asp-for="Position" class="form-control"
                                       type="number" min="0" />
                                <small class="text-muted">0 = first</small>
                            </div>
                        </div>
                    </div>
 
                    <hr />
 
                    <!-- LINK TYPE CARDS -->
                    <label class="font-weight-bold d-block mb-2">
                        Link Type <span class="text-danger">*</span>
                    </label>
                    <div class="row mb-3">
                        @{
                            var ltypes = new[]
                            {
                        ("none",     "fa-ban",              "No Link / Container",
                         "Use for items that only group children together.",
                         "secondary"),
                        ("internal", "fa-link",             "Internal Page",
                         "Link to any page on this website by Controller + Action.",
                         "primary"),
                        ("dynamic",  "fa-database",         "Dynamic Page",
                         "Auto-links to a Department, Committee, Facility etc.",
                         "success"),
                        ("external", "fa-external-link-alt","External / PDF",
                         "Link to an external website URL or PDF file path.",
                         "info")
                    };
                        }
                        @foreach (var (val, icon, label, desc, color) in ltypes)
                        {
                            <div class="col-md-6 mb-2">
                                <label class="w-100 mb-0" style="cursor:pointer;">
                                    <input type="radio" asp-for="LinkType"
                                           value="@val"
                                           class="d-none lt-radio"
                                           onchange="switchLinkType('@val')" />
                                    <div class="card lt-card h-100"
                                         id="lt-@val"
                                         style="cursor:pointer;border:2px solid #dee2e6;">
                                        <div class="card-body py-2 px-3">
                                            <div class="d-flex align-items-center">
                                                <i class="fas @icon text-@color mr-2"
                                                   style="font-size:18px;width:24px;"></i>
                                                <div>
                                                    <strong style="font-size:12px;">
                                                        @label
                                                    </strong>
                                                    <small class="text-muted d-block"
                                                           style="font-size:10px;line-height:1.3;">
                                                        @desc
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>
 
                    <!-- INTERNAL FIELDS -->
                    <div id="fields-internal" class="lt-fields d-none">
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white py-1">
                                <small class="font-weight-bold">
                                    <i class="fas fa-link mr-1"></i>Internal Page Route
                                </small>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group mb-0">
                                            <label class="small font-weight-bold">
                                                Controller Name
                                            </label>
                                            <input asp-for="ControllerName"
                                                   class="form-control form-control-sm"
                                                   placeholder="e.g. PlacementCell" />
                                            <span asp-validation-for="ControllerName"
                                                  class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group mb-0">
                                            <label class="small font-weight-bold">
                                                Action Name
                                            </label>
                                            <input asp-for="ActionName"
                                                   class="form-control form-control-sm"
                                                   placeholder="e.g. Index" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
 
                    <!-- DYNAMIC FIELDS -->
                    <div id="fields-dynamic" class="lt-fields d-none">
                        <div class="card border-success mb-3">
                            <div class="card-header bg-success text-white py-1">
                                <small class="font-weight-bold">
                                    <i class="fas fa-database mr-1"></i>
                                    Dynamic Page Link
                                </small>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="small font-weight-bold">
                                                Type <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="DynamicType"
                                                    class="form-control form-control-sm"
                                                    id="dynTypeSelect"
                                                    onchange="onDynTypeChange(this.value)">
                                                <option value="">
                                                    -- Select Type --
                                                </option>
                                                <option value="Department">
                                                    Department
                                                </option>
                                                <option value="Committee">
                                                    Committee / Cell
                                                </option>
                                                <option value="Facility">
                                                    Facility
                                                </option>
                                                <option value="Club">
                                                    Student Club
                                                </option>
                                                <option value="Document">
                                                    Document Category
                                                </option>
                                                <option value="ContentPage">
                                                    Content Page
                                                </option>
                                            </select>
                                            <span asp-validation-for="DynamicType"
                                                  class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="small font-weight-bold">
                                                Select Item <span class="text-danger">*</span>
                                            </label>
                                            <select id="dynIdSelect"
                                                    name="DynamicId"
                                                    class="form-control form-control-sm">
                                                <option value="">
                                                    -- Select type first --
                                                </option>
                                                @foreach (var opt in Model.DynamicIdOptions)
                                                {
                                                    <option value="@opt.Value"
                                                            selected="@(opt.Value == Model.DynamicId?.ToString())">
                                                        @opt.Text
                                                    </option>
                                                }
                                            </select>
                                            <span asp-validation-for="DynamicId"
                                                  class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="small font-weight-bold">
                                                Route
                                                <small class="text-muted">(auto-fills)</small>
                                            </label>
                                            <div class="input-group input-group-sm">
                                                <input asp-for="ControllerName"
                                                       id="dynCtrl"
                                                       class="form-control"
                                                       placeholder="Controller" />
                                                <input asp-for="ActionName"
                                                       id="dynAction"
                                                       class="form-control"
                                                       placeholder="Action" />
                                            </div>
                                            <small class="text-muted">
                                                Can override if needed.
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
 
                    <!-- EXTERNAL FIELDS -->
                    <div id="fields-external" class="lt-fields d-none">
                        <div class="card border-info mb-3">
                            <div class="card-header bg-info text-white py-1">
                                <small class="font-weight-bold">
                                    <i class="fas fa-external-link-alt mr-1"></i>
                                    External URL or PDF Path
                                </small>
                            </div>
                            <div class="card-body py-2">
                                <div class="form-group mb-0">
                                    <input asp-for="ExternalLink"
                                           class="form-control"
                                           placeholder="https://example.com  or  /DataFiles/Documents/file.pdf" />
                                    <span asp-validation-for="ExternalLink"
                                          class="text-danger small"></span>
                                    <small class="text-muted">
                                        For PDFs stored in the project use path like
                                        <code>/DataFiles/Documents/file.pdf</code>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
 
                    <!-- Options row -->
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="CssClass" class="font-weight-bold"></label>
                                <input asp-for="CssClass" class="form-control"
                                       placeholder="e.g. MenuOrange" />
                                <small class="text-muted">
                                    Optional. Adds CSS class to &lt;li&gt; element.
                                </small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mt-4">
                                <div class="custom-control custom-switch">
                                    <input asp-for="IsVisible" type="checkbox"
                                           class="custom-control-input"
                                           id="isVisible" />
                                    <label class="custom-control-label"
                                           for="isVisible">
                                        Show in menu
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mt-4">
                                <div class="custom-control custom-switch">
                                    <input asp-for="OpenInNewTab" type="checkbox"
                                           class="custom-control-input"
                                           id="openInNewTab" />
                                    <label class="custom-control-label"
                                           for="openInNewTab">
                                        Open in new tab
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index"
                           asp-route-menuType="@Model.MenuType"
                           class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>
                        @(isEdit ? "Save Changes" : "Add Item")
                    </button>
                </div>
            </form>
        </div>
    </div>
 
    <!-- Guide panel -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-primary"></i>
                    Quick Guide
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="p-2 border-bottom">
                    <strong class="small">🚫 No Link / Container</strong>
                    <p class="small text-muted mb-0">
                        For items like "Departments" or "Institute" that
                        don't open a page themselves but contain sub-items.
                    </p>
                </div>
                <div class="p-2 border-bottom">
                    <strong class="small">🔗 Internal Page</strong>
                    <p class="small text-muted mb-0">
                        Enter the <strong>Controller</strong> and
                        <strong>Action</strong> of the page.<br />
                        e.g. Controller: <code>PlacementCell</code>
                        Action: <code>Index</code>
                    </p>
                </div>
                <div class="p-2 border-bottom">
                    <strong class="small">🗄️ Dynamic Page</strong>
                    <p class="small text-muted mb-0">
                        Select a Department, Committee, Facility etc.
                        from the dropdown. Controller &amp; Action
                        fill automatically.
                    </p>
                </div>
                <div class="p-2">
                    <strong class="small">🌐 External / PDF</strong>
                    <p class="small text-muted mb-0">
                        Full URL like <code>https://gtu.ac.in</code>
                        or PDF path like
                        <code>/DataFiles/Documents/file.pdf</code>.
                        Enable "Open in new tab" for external links.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
 
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Default controller/action per dynamic type
        const dynRoutes = {
        'Department':  { ctrl: 'Department',      action: 'DepartmentDetails' },
        'Committee':   { ctrl: 'CampusCommittee', action: 'CommitteePage'     },
        'Facility':    { ctrl: 'Facility',         action: 'FacilityPage'      },
        'Club':        { ctrl: 'StudentCorner',    action: 'ClubPage'          },
        'Document':    { ctrl: 'Documents',        action: 'Index'             },
        'ContentPage': { ctrl: 'Page',             action: 'View'              }
        };
 
        function switchLinkType(type) {
        // Hide all field sections
        document.querySelectorAll('.lt-fields')
        .forEach(f => f.classList.add('d-none'));
 
        // Reset all card borders
        document.querySelectorAll('.lt-card')
        .forEach(c => {
        c.style.border = '2px solid #dee2e6';
        c.style.background = '';
        });
 
        // Highlight selected card
        const card = document.getElementById('lt-' + type);
        if (card) {
        card.style.border = '2px solid #1a237e';
        card.style.background = '#eef0fb';
        }
 
        // Show relevant fields
        const sec = document.getElementById('fields-' + type);
        if (sec) sec.classList.remove('d-none');
        }
 
        async function onDynTypeChange(type) {
        const sel   = document.getElementById('dynIdSelect');
        const ctrl  = document.getElementById('dynCtrl');
        const act   = document.getElementById('dynAction');
 
        sel.innerHTML = '<option>Loading…</option>';
        sel.disabled  = true;
 
        // Auto-fill route
        const route = dynRoutes[type];
        if (route) {
        ctrl.value = route.ctrl;
        act.value  = route.action;
        }
 
        try {
        const res  = await fetch(
        `/MenuItem/GetDynamicOptions?type=${type}`);
        const data = await res.json();
 
        sel.innerHTML = '<option value="">-- Select --</option>';
        data.forEach(item => {
        const opt      = document.createElement('option');
        opt.value      = item.id;
        opt.textContent= item.text;
        sel.appendChild(opt);
        });
        sel.disabled = false;
        } catch(e) {
        sel.innerHTML = '<option>Error loading items</option>';
        sel.disabled  = false;
        }
        }
 
        // ── Init ────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function() {
        const current = '@Model.LinkType';
        switchLinkType(current);
 
        // If editing dynamic — restore the select
        const dynType = '@Model.DynamicType';
        if (dynType && current === 'dynamic') {
        document.getElementById('dynCtrl').value   = '@Model.ControllerName';
        document.getElementById('dynAction').value = '@Model.ActionName';
        onDynTypeChange(dynType).then(() => {
        const sel = document.getElementById('dynIdSelect');
        sel.value = '@Model.DynamicId';
        });
        }
        });
    </script>
}