@model GECPatan.Admin.Models.ViewModels.MenuItemFormVM
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Menu Item" : "Add Menu Item";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title mb-0">
                    <i class="fas fa-bars mr-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
                @if (isEdit)
                {
                    <input asp-for="Id" type="hidden" />
                }
                @* Preserve the already-saved PDF path across a failed re-submit
                   (e.g. a validation error elsewhere on the form) when the
                   user did NOT pick a new file this time. *@
                <input asp-for="PdfPath" type="hidden" />
                @* Filled by JS from whichever Tab dropdown is active *@
                <input asp-for="TabAnchor" type="hidden" id="tabAnchorHidden" />
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <!-- Row 1: Text + Section -->
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="MenuText" class="font-weight-bold"></label>
                                <input asp-for="MenuText" class="form-control"
                                       placeholder="e.g. About Us" autofocus />
                                <span asp-validation-for="MenuText"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="MenuType" class="font-weight-bold"></label>
                                <select asp-for="MenuType" class="form-control">
                                    <option value="Top">Top Bar</option>
                                    <option value="Main">Main Navbar</option>
                                    <option value="Footer">Footer</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Parent + Position -->
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="ParentId" class="font-weight-bold"></label>
                                <select asp-for="ParentId"
                                        asp-items="Model.ParentOptions"
                                        class="form-control">
                                </select>
                                <small class="text-muted">
                                    Choose parent or leave as Top Level
                                </small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Position" class="font-weight-bold"></label>
                                <input asp-for="Position" class="form-control"
                                       type="number" min="0" />
                                <small class="text-muted">0 = first</small>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- LINK TYPE CARDS -->
                    <label class="font-weight-bold d-block mb-2">
                        Link Type <span class="text-danger">*</span>
                    </label>
                    <div class="row mb-3">
                        @{
                            var ltypes = new[]
                            {
                        ("none",     "fa-ban",              "No Link / Container",
                         "Use for items that only group children together.",
                         "secondary"),
                        ("internal", "fa-link",             "Internal Page",
                         "Pick a page of this website from a list.",
                         "primary"),
                        ("dynamic",  "fa-database",         "Dynamic Page",
                         "Pick a Department, Committee, Facility etc. (and a tab) from lists.",
                         "success"),
                        ("external", "fa-external-link-alt","External Website",
                         "Link to an external website URL.",
                         "info"),
                        ("PDF",      "fa-file-pdf",         "PDF Document",
                         "Upload a PDF file to open directly.",
                         "danger")
                    };
                        }
                        @foreach (var (val, icon, label, desc, color) in ltypes)
                        {
                            <div class="col-md-6 mb-2">
                                <label class="w-100 mb-0" style="cursor:pointer;">
                                    <input type="radio" asp-for="LinkType"
                                           value="@val"
                                           class="d-none lt-radio"
                                           onchange="switchLinkType('@val')" />
                                    <div class="card lt-card h-100"
                                         id="lt-@val"
                                         style="cursor:pointer;border:2px solid #dee2e6;">
                                        <div class="card-body py-2 px-3">
                                            <div class="d-flex align-items-center">
                                                <i class="fas @icon text-@color mr-2"
                                                   style="font-size:18px;width:24px;"></i>
                                                <div>
                                                    <strong style="font-size:12px;">
                                                        @label
                                                    </strong>
                                                    <small class="text-muted d-block"
                                                           style="font-size:10px;line-height:1.3;">
                                                        @desc
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>

                    <!-- INTERNAL FIELDS -->
                    <div id="fields-internal" class="lt-fields d-none">
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white py-1">
                                <small class="font-weight-bold">
                                    <i class="fas fa-link mr-1"></i>Internal Page
                                </small>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-0">
                                            <label class="small font-weight-bold">
                                                Page <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="InternalPage"
                                                    asp-items="Model.InternalPageOptions"
                                                    id="intPageSelect"
                                                    class="form-control form-control-sm">
                                                <option value="">-- Select page --</option>
                                            </select>
                                            <span asp-validation-for="InternalPage"
                                                  class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- DYNAMIC FIELDS -->
                    <div id="fields-dynamic" class="lt-fields d-none">
                        <div class="card border-success mb-3">
                            <div class="card-header bg-success text-white py-1">
                                <small class="font-weight-bold">
                                    <i class="fas fa-database mr-1"></i>
                                    Dynamic Page Link
                                </small>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="small font-weight-bold">
                                                Type <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="DynamicType"
                                                    class="form-control form-control-sm"
                                                    id="dynTypeSelect"
                                                    onchange="onDynTypeChange(this.value)">
                                                <option value="">
                                                    -- Select Type --
                                                </option>
                                                <option value="Department">
                                                    Department
                                                </option>
                                                <option value="Committee">
                                                    Committee / Cell
                                                </option>
                                                <option value="Facility">
                                                    Facility
                                                </option>
                                                <option value="Club">
                                                    Student Club
                                                </option>
                                                <option value="Document">
                                                    Document Category
                                                </option>
                                                <option value="ContentPage">
                                                    Content Page
                                                </option>
                                            </select>
                                            <span asp-validation-for="DynamicType"
                                                  class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="small font-weight-bold">
                                                Select Item <span class="text-danger">*</span>
                                            </label>
                                            <select id="dynIdSelect"
                                                    name="DynamicId"
                                                    class="form-control form-control-sm"
                                                    onchange="onDynItemChange(this.value)">
                                                <option value="">
                                                    -- Select type first --
                                                </option>
                                                @foreach (var opt in Model.DynamicIdOptions)
                                                {
                                                    <option value="@opt.Value"
                                                            selected="@(opt.Value == Model.DynamicId?.ToString())">
                                                        @opt.Text
                                                    </option>
                                                }
                                            </select>
                                            <span asp-validation-for="DynamicId"
                                                  class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="small font-weight-bold">
                                                Open Tab <small class="text-muted">(optional)</small>
                                            </label>
                                            <select id="dynTabSelect"
                                                    class="form-control form-control-sm"
                                                    onchange="syncTab()" disabled>
                                                <option value="">Default tab</option>
                                            </select>
                                            <small id="dynTabHint" class="text-muted">
                                                Select an item first.
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- EXTERNAL FIELDS -->
                    <div id="fields-external" class="lt-fields d-none">
                        <div class="card border-info mb-3">
                            <div class="card-header bg-info text-white py-1">
                                <small class="font-weight-bold">
                                    <i class="fas fa-external-link-alt mr-1"></i>
                                    External Website URL
                                </small>
                            </div>
                            <div class="card-body py-2">
                                <div class="form-group mb-0">
                                    <input asp-for="ExternalLink"
                                           class="form-control"
                                           placeholder="https://example.com" />
                                    <span asp-validation-for="ExternalLink"
                                          class="text-danger small"></span>
                                    <small class="text-muted">
                                        For PDFs, use the "PDF Document" link type instead —
                                        it lets you upload the file directly.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PDF FIELDS -->
                    <div id="fields-PDF" class="lt-fields d-none">
                        <div class="card border-danger mb-3">
                            <div class="card-header bg-danger text-white py-1">
                                <small class="font-weight-bold">
                                    <i class="fas fa-file-pdf mr-1"></i>
                                    Upload PDF
                                </small>
                            </div>
                            <div class="card-body py-2">
                                <div class="form-group mb-0">
                                    <input type="file"
                                           name="PdfFile"
                                           id="pdfFileInput"
                                           class="form-control-file"
                                           accept="application/pdf,.pdf" />
                                    <span asp-validation-for="PdfFile"
                                          class="text-danger small d-block"></span>
                                    <small class="text-muted d-block mt-1">
                                        PDF only, up to 10 MB.
                                        @if (isEdit && !string.IsNullOrEmpty(Model.PdfPath))
                                        {
                                            <text>Uploading a new file will replace the current one.</text>
                                        }
                                    </small>

                                    @if (!string.IsNullOrEmpty(Model.PdfPath))
                                    {
                                        <div class="mt-2">
                                            <a href="@Model.PdfPath"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-file-pdf mr-1"></i>
                                                View Current PDF
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Options row -->
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="CssClass" class="font-weight-bold"></label>
                                <input asp-for="CssClass" class="form-control"
                                       placeholder="e.g. MenuOrange" />
                                <small class="text-muted">
                                    Optional. Adds CSS class to &lt;li&gt; element.
                                </small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mt-4">
                                <div class="custom-control custom-switch">
                                    <input asp-for="IsVisible" type="checkbox"
                                           class="custom-control-input"
                                           id="isVisible" />
                                    <label class="custom-control-label"
                                           for="isVisible">
                                        Show in menu
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mt-4">
                                <div class="custom-control custom-switch">
                                    <input asp-for="OpenInNewTab" type="checkbox"
                                           class="custom-control-input"
                                           id="openInNewTab" />
                                    <label class="custom-control-label"
                                           for="openInNewTab">
                                        Open in new tab
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index"
                       asp-route-menuType="@Model.MenuType"
                       class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>
                        @(isEdit ? "Save Changes" : "Add Item")
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Guide panel -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-primary"></i>
                    Quick Guide
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="p-2 border-bottom">
                    <strong class="small">🚫 No Link / Container</strong>
                    <p class="small text-muted mb-0">
                        For items like "Departments" or "Institute" that
                        don't open a page themselves but contain sub-items.
                    </p>
                </div>
                <div class="p-2 border-bottom">
                    <strong class="small">🔗 Internal Page</strong>
                    <p class="small text-muted mb-0">
                        Choose the page from the list.
                    </p>
                </div>
                <div class="p-2 border-bottom">
                    <strong class="small">🗄️ Dynamic Page</strong>
                    <p class="small text-muted mb-0">
                        Select the type (Department, Committee, Facility,
                        Club…), then the item, then optionally a tab
                        (e.g. Labs, Members). Nothing else to fill in.
                    </p>
                </div>
                <div class="p-2 border-bottom">
                    <strong class="small">🌐 External Website</strong>
                    <p class="small text-muted mb-0">
                        Full URL like <code>https://gtu.ac.in</code>.
                        Enable "Open in new tab" for external links.
                    </p>
                </div>
                <div class="p-2">
                    <strong class="small">📄 PDF Document</strong>
                    <p class="small text-muted mb-0">
                        Upload a PDF directly — no need to know a file path.
                        The file is validated and stored automatically.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const savedTab = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TabAnchor ?? ""));

        function currentLinkType() {
            const r = document.querySelector('.lt-radio:checked');
            return r ? r.value : 'none';
        }

        // Copy the visible Tab dropdown into the hidden field that gets posted
        function syncTab() {
            const t = currentLinkType();
            const hidden = document.getElementById('tabAnchorHidden');
            if (t === 'dynamic') hidden.value = document.getElementById('dynTabSelect').value;
            else hidden.value = '';
        }

        function switchLinkType(type) {
            document.querySelectorAll('.lt-fields')
                .forEach(f => f.classList.add('d-none'));

            document.querySelectorAll('.lt-card').forEach(c => {
                c.style.border = '2px solid #dee2e6';
                c.style.background = '';
            });

            const card = document.getElementById('lt-' + type);
            if (card) {
                card.style.border = '2px solid #1a237e';
                card.style.background = '#eef0fb';
            }

            const sec = document.getElementById('fields-' + type);
            if (sec) sec.classList.remove('d-none');

            syncTab();
        }

        // Fill a Tab dropdown from /MenuItem/GetTabs and select `selected` if present
        async function loadTabs(selectId, hintId, query, selected) {
            const sel = document.getElementById(selectId);
            const hint = document.getElementById(hintId);
            sel.innerHTML = '<option value="">Default tab</option>';
            sel.disabled = true;
            hint.textContent = 'Loading tabs…';
            try {
                const res = await fetch('/MenuItem/GetTabs?' + query);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const result = await res.json();
                const data = result.tabs;
                if (!data.length) {
                    hint.textContent = result.live
                        ? 'This page has no tabs.'
                        : 'No tabs found (' + (result.reason || 'unknown reason') + ').';
                } else {
                    data.forEach(t => {
                        const o = document.createElement('option');
                        o.value = t.value;
                        o.textContent = t.text;
                        sel.appendChild(o);
                    });
                    sel.disabled = false;
                    hint.textContent = result.live
                        ? 'Read from the live page. Leave as "Default tab" to open the first tab.'
                        : 'Live page not read (' + (result.reason || 'unknown reason') + ') - showing the standard list.';
                    if (selected) {
                        // keep a saved tab even if it no longer exists in the list
                        if (![...sel.options].some(o => o.value === selected)) {
                            const o = document.createElement('option');
                            o.value = selected;
                            o.textContent = selected + ' (saved)';
                            sel.appendChild(o);
                        }
                        sel.value = selected;
                    }
                }
            } catch (e) {
                hint.textContent = 'Could not load tabs (' + e.message + ').';
            }
            syncTab();
        }

        // ── Dynamic ──────────────────────────────────────────
        function resetDynTab() {
            const sel = document.getElementById('dynTabSelect');
            sel.innerHTML = '<option value="">Default tab</option>';
            sel.disabled = true;
            document.getElementById('dynTabHint').textContent = 'Select an item first.';
            syncTab();
        }

        async function onDynTypeChange(type) {
            const sel = document.getElementById('dynIdSelect');
            resetDynTab();
            sel.innerHTML = '<option>Loading…</option>';
            sel.disabled = true;

            try {
                const res = await fetch('/MenuItem/GetDynamicOptions?type=' + encodeURIComponent(type));
                const data = await res.json();

                sel.innerHTML = '<option value="">-- Select --</option>';
                data.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.id;
                    opt.textContent = item.text;
                    sel.appendChild(opt);
                });
                sel.disabled = false;
            } catch (e) {
                sel.innerHTML = '<option>Error loading items</option>';
                sel.disabled = false;
            }
        }

        function onDynItemChange(id) {
            const type = document.getElementById('dynTypeSelect').value;
            if (!id || !type) { resetDynTab(); return; }
            return loadTabs('dynTabSelect', 'dynTabHint',
                'type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(id), '');
        }

        // ── Init ─────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', async function () {
            const current = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LinkType ?? "none"));
            switchLinkType(current);

            // Editing a dynamic link: restore item + tabs
            const dynType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DynamicType ?? ""));
            if (dynType && current === 'dynamic') {
                await onDynTypeChange(dynType);
                const sel = document.getElementById('dynIdSelect');
                sel.value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DynamicId?.ToString() ?? ""));
                if (sel.value) {
                    await loadTabs('dynTabSelect', 'dynTabHint',
                        'type=' + encodeURIComponent(dynType) + '&id=' + encodeURIComponent(sel.value),
                        savedTab);
                }
            }
        });
    </script>
}