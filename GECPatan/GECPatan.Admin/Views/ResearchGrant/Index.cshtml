@using  GECPatan.Core.Models.Domain
@model List<ResearchGrant>
@{
    ViewData["Title"] = "Research Grants";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Grant(s)
        </span>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-2"></i>Add Research Grant
        </a>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th>Title</th>
                    <th width="180">Principal Investigator</th>
                    <th width="120">Duration</th>
                    <th width="120">Cost</th>
                    <th width="80">Status</th>
                    <th width="130">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-flask fa-2x mb-2 d-block"></i>
                            No research grants yet.
                        </td>
                    </tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <strong>@r.Title</strong>
                            @if (!string.IsNullOrEmpty(r.SponsoringAuthority))
                            {
                                <small class="text-muted d-block">
                                    @r.SponsoringAuthority
                                </small>
                            }
                        </td>
                        <td><small>@r.PrincipalInvestigator</small></td>
                        <td>
                            <small>
                                @r.StartDate
                                @* @if (!string.IsNullOrEmpty(r.CompletionDate)) *@
                                {
                                    <span> → @r.CompletionDate</span>
                                }
                            </small>
                        </td>
                        <td><small>@r.ProjectCost</small></td>
                        <td>
                            @if (r.IsVisible)
                            {
                                <span class="badge badge-success">Visible</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Hidden</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@r.Id"
                                   class="btn btn-sm btn-info">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="ToggleVisible" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit"
                                        class="btn btn-sm @(r.IsVisible ? "btn-warning" : "btn-success")">
                                    <i class="fas @(r.IsVisible ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>