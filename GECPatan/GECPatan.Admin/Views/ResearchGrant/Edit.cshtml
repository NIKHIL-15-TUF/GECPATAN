@model GECPatan.Admin.Models.ViewModels.ResearchGrantVM
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Research Grant" : "Add Research Grant";
    string action = isEdit ? "Edit" : "Create";
}
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h3 class="card-title">
            <i class="fas fa-flask mr-2"></i>@ViewData["Title"]
        </h3>
    </div>
    <form asp-action="@action" method="post">
        @if (isEdit)
        {
            <input asp-for="Id" type="hidden" />
        }
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
            }
            <div class="form-group">
                <label asp-for="Title" class="font-weight-bold"></label>
                <textarea asp-for="Title" class="form-control" rows="2"
                          placeholder="Project/grant title..."></textarea>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PrincipalInvestigator" class="font-weight-bold"></label>
                        <input asp-for="PrincipalInvestigator" class="form-control"
                               placeholder="e.g. Dr. John Smith" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SponsoringAuthority" class="font-weight-bold"></label>
                        <input asp-for="SponsoringAuthority" class="form-control"
                               placeholder="e.g. DST, ISRO, GUJCOST" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="StartDate" class="font-weight-bold"></label>
                        <input asp-for="StartDate" class="form-control"
                               placeholder="e.g. Jan 2023" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="CompletionDate" class="font-weight-bold"></label>
                        <input asp-for="CompletionDate" class="form-control"
                               placeholder="e.g. Dec 2025" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Duration" class="font-weight-bold"></label>
                        <input asp-for="Duration" class="form-control"
                               placeholder="e.g. 2 Years" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="ProjectCost" class="font-weight-bold"></label>
                        <input asp-for="ProjectCost" class="form-control"
                               placeholder="e.g. ₹5,00,000" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mt-4">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">
                                Visible on website
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left mr-2"></i>Back
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>Save
            </button>
        </div>
    </form>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}