@model List<GECPatan.Admin.Models.ViewModels.DeptEquipmentListVM>
@{
    ViewData["Title"] = "Department Equipment Lists";
}
 
<div class="card mb-3"
     style="background:linear-gradient(135deg,#1a237e,#283593);
    color:#fff;border:none;">
    <div class="card-body py-3">
        <h5 class="mb-0">
            <i class="fas fa-tools mr-2"></i>
            Department-wise Equipment Lists
        </h5>
        <small style="opacity:.8;">
            TinyMCE editor per department — appears in
            Section 11 of Mandatory Disclosure
        </small>
    </div>
</div>
 
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Department</th>
                    <th width="120">Content Status</th>
                    <th width="160">Last Updated</th>
                    <th width="100">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr class="@(!dept.HasContent ? "table-warning" : "")">
                        <td>
                            <strong>@dept.DeptName</strong>
                        </td>
                        <td>
                            @if (dept.HasContent)
                            {
                                <span class="badge badge-success">
                                    <i class="fas fa-check mr-1"></i>Filled
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-warning">
                                    <i class="fas fa-exclamation mr-1"></i>Empty
                                </span>
                            }
                        </td>
                        <td>
                            @if (dept.LastUpdated.HasValue)
                            {
                                <small>
                                    @dept.LastUpdated.Value.ToString("dd MMM yyyy HH:mm")
                                    <br />
                                    <span class="text-muted">@dept.UpdatedBy</span>
                                </small>
                            }
                            else
                            {
                                <small class="text-muted">Never updated</small>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit"
                                   asp-route-deptId="@dept.DeptId"
                                   class="btn btn-sm btn-primary">
                                <i class="fas fa-edit mr-1"></i>Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
