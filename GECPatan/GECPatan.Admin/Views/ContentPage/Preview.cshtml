@using GECPatan.Admin.Models.Domain
@model ContentPage
@{
    Layout = null;
    ViewData["Title"] = Model.Title;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title — Preview</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <style>
        body { padding: 30px; }
        .preview-banner {
            background: #1a237e;
            color: white;
            padding: 10px 20px;
            margin: -30px -30px 30px;
            font-size: 13px;
        }
        img { max-width: 100%; }
    </style>
</head>
<body>
    <div class="preview-banner d-flex justify-content-between align-items-center">
        <span>
            <strong>Preview:</strong> @Model.Title
            &nbsp;|&nbsp;
            <code style="background:rgba(255,255,255,0.2);padding:2px 6px;border-radius:3px;">
                /page/@Model.Slug
            </code>
        </span>
        <button onclick="window.close()" class="btn btn-sm btn-light">
            Close Preview
        </button>
    </div>
    <div class="container">
        <h1 class="mb-4">@Model.Title</h1>
        <hr />
        @Html.Raw(Model.HtmlContent)
    </div>
</body>
</html>
