@model GECPatan.Admin.Models.ViewModels.ContentPageFormVM
@{
    // Shared by ContentPageController.Create and ContentPageController.Edit
    // (return View("Form", model)).
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Page" : "Create Page";
    string action = isEdit ? "Edit" : "Create";
}
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        @if (isEdit)
        {
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    <i class="fas fa-file-alt mr-2"></i>@Model.Title
                </h3>
                <div class="d-flex align-items-center" style="gap:8px;">
                    <span class="badge badge-light" style="font-size:11px;">
                        <i class="fas fa-link mr-1"></i>@Model.GeneratedUrl
                    </span>
                    <a asp-action="Preview" asp-route-id="@Model.Id" target="_blank"
                       class="btn btn-sm btn-light" title="Shows the last saved version">
                        <i class="fas fa-eye mr-1"></i>Preview
                    </a>
                </div>
            </div>
        }
        else
        {
            <h3 class="card-title">
                <i class="fas fa-file-alt mr-2"></i>New Content Page
            </h3>
        }
    </div>

    <form asp-action="@action" asp-route-id="@(isEdit ? Model.Id : (int?)null)"
          method="post" enctype="multipart/form-data" id="pageForm" novalidate>
        @if (isEdit)
        {
            <input asp-for="Id" type="hidden" />
        }
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
            }

            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <span class="text-danger">*</span>
                        <input asp-for="Title" class="form-control"
                               placeholder="e.g. NIRF Report 2025" />
                        <span asp-validation-for="Title" id="err-Title" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Slug" class="font-weight-bold">
                            URL Slug
                            @if (!isEdit)
                            {
                                <small class="text-muted">(auto-generated)</small>
                            }
                        </label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">/page/</span>
                            </div>
                            <input asp-for="Slug" class="form-control" id="slugInput"
                                   placeholder="nirf-report-2025" />
                        </div>
                        <span asp-validation-for="Slug" id="err-Slug" class="text-danger small"></span>
                        @if (isEdit)
                        {
                            <small class="text-warning d-block">
                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                Changing the slug changes the URL. Update any existing links.
                            </small>
                        }
                    </div>
                </div>
            </div>

            <!-- Title Image (single image) -->
            <div class="form-group">
                <label asp-for="TitleImage" class="font-weight-bold"></label>
                <small class="text-muted d-block mb-1">
                    @(isEdit
                        ? "This image is used as the page title/banner image. Select a new image to replace it."
                        : "Optional. This image will be used as the page title/banner image.")
                </small>

                @if (isEdit)
                {
                    if (!string.IsNullOrWhiteSpace(Model.TitleImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.TitleImageUrl" class="img-thumbnail"
                                 style="max-height:150px;max-width:100%;" alt="Current Title Image" />
                            <div class="small text-muted mt-1">Current Title Image</div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small mb-2">No Title Image uploaded yet.</div>
                    }
                }

                <div class="custom-file">
                    <input asp-for="TitleImage" type="file" id="titleImageInput"
                           class="custom-file-input" accept="image/*" />
                    <label class="custom-file-label" for="titleImageInput">
                        @(isEdit ? "Choose replacement image..." : "Choose Title Image...")
                    </label>
                </div>
                <span asp-validation-for="TitleImage" id="err-TitleImage" class="text-danger small d-block"></span>

                <img id="titleImagePreview" src="#" class="img-thumbnail mt-2 d-none"
                     style="max-height:150px;max-width:100%;" alt="Title image preview" />
            </div>

            <!-- Carousel Images (separate from page content) -->
            <div class="form-group">
                <label class="font-weight-bold">Carousel Images</label>
                <small class="text-muted d-block mb-1">
                    @(isEdit
                        ? "Shown as a slideshow above the page content — separate from the editor below."
                        : "Optional. These are shown as a slideshow above the page content — separate from what you write in the editor below. You can add more later.")
                </small>

                @if (isEdit)
                {
                    if (Model.ExistingImages.Any())
                    {
                        <div class="d-flex flex-wrap mb-2" style="gap:10px;">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div class="position-relative" style="width:110px;">
                                    <img src="@img.ImageUrl" alt="@img.Caption"
                                         style="width:110px;height:80px;object-fit:cover;border-radius:4px;border:1px solid #ddd;" />
                                    @* type="button": the delete form is OUTSIDE this form (see below). *@
                                    <button type="button"
                                            class="btn btn-danger btn-sm py-0 px-1 position-absolute"
                                            style="top:2px;right:2px;"
                                            title="Remove image"
                                            onclick="deleteCarouselImage(@img.Id)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small mb-2">No carousel images yet.</div>
                    }

                    <label class="small font-weight-bold mb-1">Add more images</label>
                }

                <input type="file" name="CarouselImages" id="carouselInput"
                       class="form-control-file" accept="image/*" multiple />
                <span id="err-CarouselImages" class="text-danger small d-block mt-1"></span>
                <div id="carouselPreview" class="d-flex flex-wrap mt-2" style="gap:8px;"></div>
            </div>

            <!-- TinyMCE Editor -->
            <div class="form-group">
                <label asp-for="HtmlContent" class="font-weight-bold">Page Content</label>
                @if (!isEdit)
                {
                    <small class="text-muted d-block mb-1">
                        Use the editor below to add text, images, tables, or paste from Word.
                    </small>
                }
                <textarea asp-for="HtmlContent" id="contentEditor" class="form-control" rows="15"
                          placeholder="Start writing your page content here..."></textarea>
                <span id="err-HtmlContent" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input asp-for="IsVisible" type="checkbox"
                           class="custom-control-input" id="isVisible" />
                    <label class="custom-control-label" for="isVisible">
                        @(isEdit ? "Published" : "Publish immediately")
                        <small class="text-muted">
                            @(isEdit ? "(uncheck to save as draft)" : "(unchecked = save as draft)")
                        </small>
                    </label>
                </div>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between">
            @if (isEdit && User.IsInRole(AppRoles.ContentEditor))
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i>Back to home
                </a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i>Back
                </a>
            }

            <button type="submit" class="btn btn-primary" id="saveBtn">
                <i class="fas fa-save mr-2"></i>@(isEdit ? "Save Changes" : "Save Page")
            </button>
        </div>
    </form>

    @if (isEdit)
    {
        @* HTML does not allow a <form> inside a <form>. The delete-image button therefore
           submits this separate form instead of the main one. *@
        <form id="deleteImageForm" asp-action="DeleteImage" method="post" class="d-none">
            <input type="hidden" name="id" id="deleteImageId" />
            <input type="hidden" name="pageId" value="@Model.Id" />
        </form>
    }
</div>
@section Scripts {
    <script src="https://cdn.tiny.cloud/1/18c5arljshkibt2xb5jfkdlmr3uosv3lagdiujmk5c9jlv49/tinymce/6/tinymce.min.js"
            referrerpolicy="origin"></script>
    <script>
    (function () {
        'use strict';

        // ── Settings (keep in step with your IFileStorageService limits) ──
        const isEdit          = @(isEdit ? "true" : "false");
        const existingCount   = @Model.ExistingImages.Count;   // carousel images already saved
        const MAX_IMAGE_MB    = 5;      // per image
        const MAX_TOTAL_MB    = 25;     // all images in one save (hosts usually cap ~28-30 MB)
        const MAX_CAROUSEL    = 20;     // saved + newly selected carousel images
        const TITLE_MAX       = 300;
        const SLUG_MAX        = 300;
        const REQUIRE_CONTENT = false;  // the server allows empty content (pages can be sections only)
        const ALLOWED_TYPES   = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];

        const form        = document.getElementById('pageForm');
        const titleEl     = document.getElementById('Title');
        const slugEl      = document.getElementById('slugInput');
        const titleImgEl  = document.getElementById('titleImageInput');
        const carouselEl  = document.getElementById('carouselInput');
        const saveBtn     = document.getElementById('saveBtn');
        const saveBtnHtml = saveBtn.innerHTML;

        // ── Helpers ───────────────────────────────────────────────────
        // Same rules as ContentPageController.GenerateSlug
        const slugify = s => (s || '').toLowerCase()
            .replace(/\s+/g, '-')
            .replace(/[^a-z0-9\-]/g, '')
            .replace(/-+/g, '-')
            .replace(/^-|-$/g, '');

        const mb = bytes => (bytes / 1048576).toFixed(1);

        function setError(name, input, message) {
            const span = document.getElementById('err-' + name);
            if (span) span.textContent = message || '';
            if (input) input.classList.toggle('is-invalid', !!message);
            return !message;
        }

        function fileProblem(file) {
            if (!ALLOWED_TYPES.includes(file.type))
                return '"' + file.name + '" is not a supported image (use JPG, PNG, WEBP or GIF).';
            if (file.size > MAX_IMAGE_MB * 1048576)
                return '"' + file.name + '" is ' + mb(file.size) + ' MB. Maximum is ' + MAX_IMAGE_MB + ' MB per image.';
            return '';
        }

        // ── Validators (each returns true when the field is valid) ────
        function validateTitle() {
            const v = titleEl.value.trim();
            if (!v)
                return setError('Title', titleEl, 'Title is required.');
            if (v.length > TITLE_MAX)
                return setError('Title', titleEl, 'Title cannot exceed ' + TITLE_MAX + ' characters.');
            return setError('Title', titleEl, '');
        }

        function validateSlug() {
            const raw = slugEl.value.trim();
            if (raw.length > SLUG_MAX)
                return setError('Slug', slugEl, 'Slug cannot exceed ' + SLUG_MAX + ' characters.');

            const cleaned = slugify(raw || titleEl.value);
            if (cleaned) return setError('Slug', slugEl, '');

            if (raw)
                return setError('Slug', slugEl, 'Use English letters, numbers and hyphens only.');
            if (titleEl.value.trim())
                return setError('Slug', slugEl, 'The title has no English letters or numbers. Please type a slug.');
            return setError('Slug', slugEl, '');   // empty title: the Title error is shown instead
        }

        function validateTitleImage() {
            const file = titleImgEl.files[0];
            if (!file) return setError('TitleImage', titleImgEl, '');
            return setError('TitleImage', titleImgEl, fileProblem(file));
        }

        function validateCarousel() {
            const files = Array.from(carouselEl.files);
            if (!files.length) return setError('CarouselImages', carouselEl, '');

            if (existingCount + files.length > MAX_CAROUSEL)
                return setError('CarouselImages', carouselEl,
                    'A page can have at most ' + MAX_CAROUSEL + ' carousel images (' + existingCount + ' already saved).');

            for (const f of files) {
                const problem = fileProblem(f);
                if (problem) return setError('CarouselImages', carouselEl, problem);
            }

            const total = files.reduce((s, f) => s + f.size, 0) +
                          (titleImgEl.files[0] ? titleImgEl.files[0].size : 0);
            if (total > MAX_TOTAL_MB * 1048576)
                return setError('CarouselImages', carouselEl,
                    'Selected images total ' + mb(total) + ' MB. Maximum per save is ' + MAX_TOTAL_MB + ' MB.');

            return setError('CarouselImages', carouselEl, '');
        }

        function validateContent() {
            const editor = window.tinymce ? tinymce.get('contentEditor') : null;
            let message = '';

            if (REQUIRE_CONTENT && editor) {
                const hasText  = editor.getContent({ format: 'text' }).trim().length > 0;
                const hasImage = /<img\b/i.test(editor.getContent());
                if (!hasText && !hasImage) message = 'Page content is required.';
            }
            if (editor) editor.getContainer().style.border = message ? '1px solid #dc3545' : '';
            return setError('HtmlContent', null, message);
        }

        // Validate when leaving a field; once it shows an error, re-check as the user types.
        function attach(el, fn) {
            el.addEventListener('blur', fn);
            el.addEventListener('input', function () { if (el.classList.contains('is-invalid')) fn(); });
        }
        attach(titleEl, validateTitle);
        attach(slugEl, validateSlug);

        titleEl.addEventListener('input', function () {
            if (slugEl.classList.contains('is-invalid') && !slugEl.value.trim()) validateSlug();
        });

        // ── Slug auto-generation: Create only, and only until the admin edits the slug ──
        let slugTouched = false;
        slugEl.addEventListener('input', function () { slugTouched = true; });
        if (!isEdit) {
            titleEl.addEventListener('input', function () {
                if (!slugTouched) slugEl.value = slugify(titleEl.value);
            });
        }

        // ── Title image: validate + preview ───────────────────────────
        const defaultTitleLabel = isEdit ? 'Choose replacement image...' : 'Choose Title Image...';
        titleImgEl.addEventListener('change', function (e) {
            const file = e.target.files[0];
            const preview = document.getElementById('titleImagePreview');
            const label = e.target.nextElementSibling;

            preview.classList.add('d-none');
            preview.src = '#';

            if (!file) { label.textContent = defaultTitleLabel; validateTitleImage(); return; }

            if (!validateTitleImage()) {
                e.target.value = '';
                label.textContent = defaultTitleLabel;
                e.target.classList.add('is-invalid');   // keep the red state beside the message
                return;
            }

            label.textContent = file.name;
            const reader = new FileReader();
            reader.onload = function (ev) { preview.src = ev.target.result; preview.classList.remove('d-none'); };
            reader.readAsDataURL(file);
            validateCarousel();   // the total-size check depends on this file
        });

        // ── Carousel images: validate + preview ───────────────────────
        carouselEl.addEventListener('change', function (e) {
            const preview = document.getElementById('carouselPreview');
            preview.innerHTML = '';

            if (!validateCarousel()) {
                e.target.value = '';
                e.target.classList.add('is-invalid');
                return;
            }

            Array.from(e.target.files).forEach(function (file) {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const img = document.createElement('img');
                    img.src = ev.target.result;
                    img.style.cssText = 'width:100px;height:75px;object-fit:cover;border-radius:4px;border:1px solid #ddd;';
                    preview.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        });

        // ── Delete one saved carousel image (separate form, see markup) ──
        window.deleteCarouselImage = function (id) {
            if (!confirm('Remove this image?')) return;
            document.getElementById('deleteImageId').value = id;
            document.getElementById('deleteImageForm').submit();
        };

        // ── TinyMCE ───────────────────────────────────────────────────
        tinymce.init({
            selector: '#contentEditor',
            plugins: 'link lists code image table wordcount',
            toolbar: 'undo redo | formatselect | ' +
                     'bold italic underline | ' +
                     'alignleft aligncenter alignright | ' +
                     'bullist numlist | link image table | code',
            height: isEdit ? 550 : 500,
            menubar: true,
            promotion: false,
            branding: false,
            image_upload_url: '/Upload/TinyMceUpload',
            automatic_uploads: true,
            setup: function (editor) {
                editor.on('change', function () { tinymce.triggerSave(); });
                editor.on('blur', validateContent);
            }
        });

        // ── Submit: validate everything, then lock the button ─────────
        form.addEventListener('submit', function (e) {
            tinymce.triggerSave();

            // Run every check (no short-circuit) so all messages appear together.
            const results = [
                validateTitle(), validateSlug(), validateTitleImage(),
                validateCarousel(), validateContent()
            ];

            if (results.includes(false)) {
                e.preventDefault();
                const firstMsg = form.querySelector('[id^="err-"]:not(:empty)');
                if (firstMsg) firstMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
                const firstBad = form.querySelector('input.is-invalid');
                if (firstBad && firstBad.type !== 'hidden') firstBad.focus({ preventScroll: true });
                return;
            }

            // Send the same slug the server will store.
            const cleaned = slugify(slugEl.value.trim() || titleEl.value);
            if (cleaned) slugEl.value = cleaned;

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Saving...';
        });

        // The browser "back" button can restore the page with the button still locked.
        window.addEventListener('pageshow', function (ev) {
            if (ev.persisted) { saveBtn.disabled = false; saveBtn.innerHTML = saveBtnHtml; }
        });
    })();
    </script>
}
