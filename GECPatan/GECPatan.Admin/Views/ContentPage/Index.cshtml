@model List<GECPatan.Admin.Models.ViewModels.ContentPageListVM>
@{
    ViewData["Title"] = "Content Pages";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge badge-info px-3 py-2" style="font-size:13px;">
                @Model.Count Page(s)
            </span>
            <small class="text-muted ml-2">
                Standalone pages with custom URLs
            </small>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>New Page
        </a>
    </div>
</div>
 
@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="fas fa-file-alt fa-3x mb-3 d-block"></i>
            No pages yet. Click <strong>New Page</strong> to create your first page.
            <div class="mt-2">
                <small>
                    Examples: NIRF Report, RTI, AQAR, Annual Report...
                </small>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead style="background:#1a237e;color:#fff;">
                    <tr>
                        <th>Title</th>
                        <th>Public URL</th>
                        <th width="120">Created By</th>
                        <th width="120">Date</th>
                        <th width="80">Status</th>
                        <th width="200">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong>@p.Title</strong>
                            </td>
                            <td>
                                <div class="input-group input-group-sm" style="max-width:300px;">
                                    <input type="text" class="form-control form-control-sm"
                                           value="@p.PublicUrl" readonly
                                           id="url-@p.Id" />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-sm"
                                                onclick="copyUrl('@p.PublicUrl', this)"
                                                title="Copy URL">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <small>@p.CreatedBy</small>
                            </td>
                            <td>
                                <small>@p.CreatedDate.ToString("dd MMM yyyy")</small>
                            </td>
                            <td>
                                @if (p.IsVisible)
                                {
                                    <span class="badge badge-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Draft</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-info mb-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Preview" asp-route-id="@p.Id"
                                       target="_blank"
                                       class="btn btn-sm btn-secondary mb-1">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <form asp-action="ToggleVisible" method="post"
                                      class="d-inline">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(p.IsVisible ? "btn-warning" : "btn-success") mb-1"
                                            title="@(p.IsVisible ? "Unpublish" : "Publish")">
                                        <i class="fas @(p.IsVisible ? "fa-eye-slash" : "fa-check")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger mb-1"
                                            onclick="return confirm('Delete this page?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
 
@section Scripts {
    <script>
        function copyUrl(url, btn) {
            navigator.clipboard.writeText(window.location.origin + url)
                .then(() => {
                    btn.innerHTML = '<i class="fas fa-check text-success"></i>';
                    setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 2000);
                });
        }
    </script>
}