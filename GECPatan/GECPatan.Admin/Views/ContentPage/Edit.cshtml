@model GECPatan.Admin.Models.ViewModels.ContentPageEditVM
@{
    ViewData["Title"] = "Edit Page";
}
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">
                <i class="fas fa-file-alt mr-2"></i>@Model.Title
            </h3>
            <div class="d-flex align-items-center" style="gap:8px;">
                <span class="badge badge-light" style="font-size:11px;">
                    <i class="fas fa-link mr-1"></i>@Model.GeneratedUrl
                </span>
                <a asp-action="Preview" asp-route-id="@Model.Id" target="_blank"
                   class="btn btn-sm btn-light">
                    <i class="fas fa-eye mr-1"></i>Preview
                </a>
            </div>
        </div>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
            }
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Slug" class="font-weight-bold">
                            URL Slug
                        </label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">/page/</span>
                            </div>
                            <input asp-for="Slug" class="form-control" />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                        <small class="text-warning">
                            <i class="fas fa-exclamation-triangle mr-1"></i>
                            Changing the slug changes the URL. Update any existing links.
                        </small>
                    </div>
                </div>
            </div>
 
            <!-- Carousel Images (separate from page content) -->
            <div class="form-group">
                <label class="font-weight-bold">Carousel Images</label>
                <small class="text-muted d-block mb-1">
                    Shown as a slideshow above the page content — separate from the editor below.
                </small>
 
                @if (Model.ExistingImages.Any())
                {
                    <div class="d-flex flex-wrap mb-2" style="gap:10px;">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="position-relative" style="width:110px;">
                                <img src="@img.ImageUrl" style="width:110px;height:80px;object-fit:cover;border-radius:4px;border:1px solid #ddd;" />
                                <form asp-action="DeleteImage" method="post" class="position-absolute" style="top:2px;right:2px;">
                                    <input type="hidden" name="id" value="@img.Id" />
                                    <input type="hidden" name="pageId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm py-0 px-1"
                                            title="Remove image"
                                            onclick="return confirm('Remove this image?')">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small mb-2">No carousel images yet.</div>
                }
 
                <label class="small font-weight-bold mb-1">Add more images</label>
                <input type="file" name="CarouselImages" id="carouselInput"
                       class="form-control-file" accept="image/*" multiple />
                <div id="carouselPreview" class="d-flex flex-wrap mt-2" style="gap:8px;"></div>
            </div>
 
            <!-- TinyMCE Editor -->
            <div class="form-group">
                <label class="font-weight-bold">Page Content</label>
                <textarea asp-for="HtmlContent" id="contentEditor"
                          class="form-control" rows="15"></textarea>
            </div>
 
            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input asp-for="IsVisible" type="checkbox"
                           class="custom-control-input" id="isVisible" />
                    <label class="custom-control-label" for="isVisible">
                        Published
                        <small class="text-muted">(uncheck to save as draft)</small>
                    </label>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
           @if (User.IsInRole(AppRoles.ContentEditor))
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i>Back to home
                </a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i>Back
                </a>
            }
 
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>Save Changes
            </button>
        </div>
    </form>
</div>
@section Scripts {
    <script src="~/tinymce/tinymce.min.js"></script>
    <script src="https://cdn.tiny.cloud/1/18c5arljshkibt2xb5jfkdlmr3uosv3lagdiujmk5c9jlv49/tinymce/6/tinymce.min.js"
            referrerpolicy="origin"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        tinymce.init({
            selector: '#contentEditor',
            plugins: 'link lists code image table wordcount',
            toolbar: 'undo redo | formatselect | ' +
                     'bold italic underline | ' +
                     'alignleft aligncenter alignright | ' +
                     'bullist numlist | link image table | code',
            height: 550,
            menubar: true,
            promotion: false,
            branding: false,
            image_upload_url: '/Upload/TinyMceUpload',
            automatic_uploads: true,
            setup: function(editor) {
                editor.on('change', function() { tinymce.triggerSave(); });
            }
        });
 
        document.querySelector('form').addEventListener('submit', function() {
            tinymce.triggerSave();
        });
 
        document.getElementById('carouselInput').addEventListener('change', function (e) {
            const preview = document.getElementById('carouselPreview');
            preview.innerHTML = '';
            Array.from(e.target.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = ev => {
                    const img = document.createElement('img');
                    img.src = ev.target.result;
                    img.style.cssText = 'width:100px;height:75px;object-fit:cover;border-radius:4px;border:1px solid #ddd;';
                    preview.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
}
