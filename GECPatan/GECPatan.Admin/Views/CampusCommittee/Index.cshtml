@model List<GECPatan.Admin.Models.ViewModels.CommitteeListVM>
@{
    ViewData["Title"] = "Campus Committees";
}
 
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Committee(s)
        </span>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus mr-2"></i>Add Committee
            </a>
        }
    </div>
</div>
 
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th width="60">Image</th>
                    <th>Title</th>
                    <th>Tagline</th>
                    <th width="80">Members</th>
                    <th width="80">Status</th>
                    <th width="250">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-users fa-2x mb-2 d-block"></i>
                            No committees yet.
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(c.TitleImagePath))
                            {
                                <img src="@c.TitleImagePath" class="img-thumbnail"
                                     style="width:45px;height:45px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="width:45px;height:45px;border-radius:4px;">
                                    <i class="fas fa-users text-muted"></i>
                                </div>
                            }
                        </td>
                        <td><strong>@c.Title</strong></td>
                        <td><small class="text-muted">@c.Tagline</small></td>
                        <td>
                            <span class="badge badge-secondary">@c.MemberCount</span>
                        </td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-info mb-1">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Members" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-secondary mb-1">
                                <i class="fas fa-users"></i> Members
                            </a>
                            <a asp-controller="DynamicSection" asp-action="Index"
                                   asp-route-pageType="2" asp-route-pageId="@c.Id"
                                   class="btn btn-sm btn-primary mb-1">
                                <i class="fas fa-layer-group"></i> Sections
                            </a>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(c.IsActive ? "btn-warning" : "btn-success") mb-1"
                                            onclick="return confirm('Toggle?')">
                                        <i class="fas @(c.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger mb-1"
                                            onclick="return confirm('Delete?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>