@model GECPatan.Admin.Models.ViewModels.CommitteeEditVM
@{
    ViewData["Title"] = "Edit Committee";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 mb-2">@Html.ValidationSummary(false)</div>
    }

    <ul class="nav nav-tabs mb-0 border-bottom-0" id="commTabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#basic" role="tab"><i class="fas fa-info-circle mr-1"></i>Basic Info</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#vision" role="tab"><i class="fas fa-eye mr-1"></i>Vision & Mission</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#objectives" role="tab"><i class="fas fa-list mr-1"></i>Objectives</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#images" role="tab"><i class="fas fa-images mr-1"></i>Images</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tabs" role="tab"><i class="fas fa-columns mr-1"></i>Tab Titles</a></li>
    </ul>

    <div class="card" style="border-top:none; border-radius:0 0 8px 8px;">
        <div class="card-body pt-3">
            <div class="tab-content" id="commTabContent">
                
                <div class="tab-pane fade show active" id="basic" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Title" class="font-weight-bold"></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Tagline" class="font-weight-bold"></label>
                                <input asp-for="Tagline" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">About</label>
                        <textarea asp-for="About" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="BlogLink" class="font-weight-bold"></label>
                                <input asp-for="BlogLink" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Link" class="font-weight-bold"></label>
                                <input asp-for="Link" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Account" class="font-weight-bold"></label>
                                <input asp-for="Account" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                                <input asp-for="DisplayOrder" class="form-control" type="number" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="custom-control custom-switch mt-2">
                                <input asp-for="ShowDocument" type="checkbox" class="custom-control-input" id="showDoc" />
                                <label class="custom-control-label font-weight-bold" for="showDoc">Show Documents Tab</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="custom-control custom-switch mt-2">
                                <input asp-for="TableView" type="checkbox" class="custom-control-input" id="tableView" />
                                <label class="custom-control-label font-weight-bold" for="tableView">Table View</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="vision" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="font-weight-bold text-primary">Vision Statements</label>
                            <small class="text-muted d-block mb-2">One per line</small>
                            <textarea name="VisionItems" class="form-control" rows="8">@string.Join("\n", Model.VisionItems ?? new List<string>())</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="font-weight-bold text-success">Mission Statements</label>
                            <small class="text-muted d-block mb-2">One per line</small>
                            <textarea name="MissionItems" class="form-control" rows="8">@string.Join("\n", Model.MissionItems ?? new List<string>())</textarea>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="objectives" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="font-weight-bold text-warning">Objectives</label>
                            <small class="text-muted d-block mb-2">One per line</small>
                            <textarea name="ObjectiveItems" class="form-control" rows="8">@string.Join("\n", Model.ObjectiveItems ?? new List<string>())</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="font-weight-bold text-info">Sub Objectives / Bullets</label>
                            <small class="text-muted d-block mb-2">One per line</small>
                            <textarea name="SubObjectiveItems" class="form-control" rows="8">@string.Join("\n", Model.SubObjectiveItems ?? new List<string>())</textarea>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="images" role="tabpanel">
                    <div class="row">
                        @{
                            void ImageField(string label, string inputName, string? path)
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="font-weight-bold">@label</label>
                                    <div class="border p-2 rounded bg-light">
                                        @if (!string.IsNullOrEmpty(path))
                                        {
                                            <img src="@path" class="img-thumbnail mb-2 d-block" style="max-height:80px;" />
                                        }
                                        <input type="file" name="@inputName" class="form-control-file" />
                                    </div>
                                </div>
                            }
                            ImageField("Banner Image", "TitleImage", Model.ExistingTitleImagePath);
                            ImageField("Measure Image", "MeasureImage", Model.ExistingMeasureImagePath);
                            ImageField("Sub Objectives Image", "SubObjImage", Model.ExistingSubObjImagePath);
                            ImageField("Page Flyer", "PageFlyer", Model.ExistingPageFlyerPath);
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="tabs" role="tabpanel">
                    <div class="row">
                        @foreach (var p in new[] { "TabAbout", "TabVisionMission", "TabObjectives", "TabMembers", "TabActivities", "TabDocuments", "TabLink" })
                        {
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold">@p.Replace("Tab", "") Title</label>
                                <input name="@p" value="@Model.GetType().GetProperty(p)?.GetValue(Model)" class="form-control" />
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Back</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Save Changes</button>
        </div>
    </div>
</form>

<div class="card mt-3 shadow-sm">
    <div class="card-body p-3">
        <div class="row text-center">
            <div class="col-md-3">
                <a asp-action="Members" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-block">
                    <i class="fas fa-users d-block mb-1"></i> Members
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="DynamicSection" asp-action="Index"
                       asp-route-pageType="2" asp-route-pageId="@Model.Id"
                       class="btn btn-outline-primary btn-block btn-sm">
                    <i class="fas fa-layer-group d-block mb-1" style="font-size:18px;"></i>Sections
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Activity" asp-action="Index" asp-route-committeeId="@Model.Id" class="btn btn-outline-success btn-block">
                    <i class="fas fa-calendar-alt d-block mb-1"></i> Activities
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Achievement" asp-action="Index" asp-route-committeeId="@Model.Id" class="btn btn-outline-warning btn-block">
                    <i class="fas fa-trophy d-block mb-1"></i> Achievements
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Ensure standard font size and tab switching
        const activeTab = localStorage.getItem('commActiveTab');
        if (activeTab) {
        $(`#commTabs a[href="${activeTab}"]`).tab('show');
        }
        $('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
        localStorage.setItem('commActiveTab', $(e.target).attr('href'));
        });
    </script>
}