@model GECPatan.Admin.Models.ViewModels.ContactMessageFilterVM
@{
    ViewData["Title"] = ViewData["Title"] ?? "Contact Messages";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <span class="badge badge-secondary px-3 py-2" style="font-size:13px;">
                @Model.TotalCount total
            </span>
            @if (Model.UnreadCount > 0)
            {
                <span class="badge badge-danger px-3 py-2" style="font-size:13px;">
                    @Model.UnreadCount unread
                </span>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="form-row align-items-end">
            <div class="col-md-4 form-group mb-2">
                <label class="font-weight-bold small">Search</label>
                <input type="text" name="Search" value="@Model.Search" class="form-control"
                       placeholder="Name, email, or subject" />
            </div>
            <div class="col-md-3 form-group mb-2">
                <label class="font-weight-bold small">Category</label>
                <select name="Category" class="form-control">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c" selected="@(c == Model.Category)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-3 form-group mb-2">
                <label class="font-weight-bold small">Status</label>
                <select name="Status" class="form-control">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">All</option>
                    <option value="Unread" selected="@(Model.Status == "Unread")">Unread</option>
                    <option value="Read" selected="@(Model.Status == "Read")">Read</option>
                    <option value="Replied" selected="@(Model.Status == "Replied")">Replied</option>
                    <option value="NotReplied" selected="@(Model.Status == "NotReplied")">Not Replied</option>
                </select>
            </div>
            <div class="col-md-2 form-group mb-2">
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-filter mr-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th width="30"></th>
                    <th>From</th>
                    <th>Category</th>
                    <th>Subject</th>
                    <th class="text-center" width="110">Status</th>
                    <th width="150">Received</th>
                    <th class="text-center" width="90">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Messages.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                            No messages found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var m in Model.Messages)
                    {
                        <tr class="@(!m.IsRead ? "font-weight-bold" : "")">
                            <td class="text-center">
                                @if (!m.IsRead)
                                {
                                    <i class="fas fa-circle text-danger" style="font-size:8px;" title="Unread"></i>
                                }
                            </td>
                            <td>
                                @m.FullName
                                <div class="text-muted small font-weight-normal">@m.Email</div>
                            </td>
                            <td><span class="badge badge-secondary">@m.Category</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@m.Id" class="text-dark">@m.Subject</a>
                            </td>
                            <td class="text-center">
                                @if (m.IsReplied)
                                {
                                    <span class="badge badge-success">Replied</span>
                                }
                                else if (m.IsRead)
                                {
                                    <span class="badge badge-info">Read</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Unread</span>
                                }
                            </td>
                            <td class="font-weight-normal">@m.SubmittedDate</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
