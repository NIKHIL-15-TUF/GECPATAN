@model GECPatan.Admin.Models.ViewModels.ContactMessageDetailVM
@{
    ViewData["Title"] = ViewData["Title"] ?? "Message Details";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Contact Messages</a></li>
        <li class="breadcrumb-item active">@Model.Subject</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:#1a237e;color:#fff;">
                <h3 class="card-title mb-0">@Model.Subject</h3>
                <span class="badge @(Model.IsReplied ? "badge-success" : "badge-warning")">
                    @(Model.IsReplied ? "Replied" : "Awaiting Reply")
                </span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">From</dt>
                    <dd class="col-sm-9">@Model.FullName &lt;@Model.Email&gt;</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9"><span class="badge badge-secondary">@Model.Category</span></dd>

                    <dt class="col-sm-3">Received</dt>
                    <dd class="col-sm-9">@Model.SubmittedDate</dd>

                    @if (!string.IsNullOrEmpty(Model.IpAddress))
                    {
                        <dt class="col-sm-3">IP Address</dt>
                        <dd class="col-sm-9 text-muted">@Model.IpAddress</dd>
                    }
                </dl>
                <hr />
                <p style="white-space:pre-wrap;">@Model.Message</p>
            </div>
        </div>

        @if (Model.IsReplied)
        {
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-reply mr-2"></i>Your Reply</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        Sent @Model.RepliedDate by @Model.RepliedBy
                    </p>
                    <p style="white-space:pre-wrap;">@Model.ReplyMessage</p>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-envelope mr-2"></i>@(Model.IsReplied ? "Send Another Reply" : "Reply")
                </h5>
            </div>
            <form asp-action="Reply" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="form-group">
                        <textarea name="replyBody" class="form-control" rows="6"
                                  placeholder="Type your reply to @Model.FullName..." required></textarea>
                    </div>
                    <small class="form-text text-muted">
                        This will be emailed to <b>@Model.Email</b> from the college's configured support/sender
                        address, and the message will be marked as Replied automatically.
                    </small>
                </div>
                <div class="card-footer text-right">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane mr-2"></i>Send Reply
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Actions</h5>
            </div>
            <div class="card-body">
                <form asp-action="ToggleRead" asp-route-id="@Model.Id" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-block">
                        <i class="fas @(Model.IsRead ? "fa-envelope" : "fa-envelope-open") mr-2"></i>
                        Mark as @(Model.IsRead ? "Unread" : "Read")
                    </button>
                </form>

                @if (!Model.IsReplied)
                {
                    <form asp-action="MarkReplied" asp-route-id="@Model.Id" method="post" class="mb-2"
                          onsubmit="return confirm('Mark this message as replied without sending an email? Use this only if you already responded outside the system.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success btn-block">
                            <i class="fas fa-check mr-2"></i>Mark as Replied
                        </button>
                    </form>
                }

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Delete this message? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-block">
                        <i class="fas fa-trash mr-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
