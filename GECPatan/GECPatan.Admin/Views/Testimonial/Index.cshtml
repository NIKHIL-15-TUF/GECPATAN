@using GECPatan.Admin.Models.Domain
@model List<Testimonial>
@{
    ViewData["Title"] = "Testimonials";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">@Model.Count Testimonial(s)</span>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Add Testimonial
        </a>
    </div>
</div>
<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5 text-muted">
                    <i class="fas fa-quote-left fa-3x mb-3 d-block"></i>
                    No testimonials yet.
                </div>
            </div>
        </div>
    }
    @foreach (var t in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card @(!t.IsVisible ? "border-secondary" : "")">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mr-3"
                             style="width:40px;height:40px;min-width:40px;">
                            <i class="fas fa-user text-white"></i>
                        </div>
                        <div>
                            <strong>@t.StudentName</strong>
                            <small class="text-muted d-block">
                                @t.Department — @t.PassoutYear
                            </small>
                        </div>
                        @if (!t.IsVisible)
                        {
                            <span class="badge badge-secondary ml-auto">Hidden</span>
                        }
                    </div>
                    <p class="text-muted small mb-0" style="font-style:italic;">
                        "@(t.TestimonialText.Length > 120 ? t.TestimonialText.Substring(0, 120) + "..." : t.TestimonialText)"
                    </p>
                </div>
                <div class="card-footer py-2 d-flex justify-content-end" style="gap:6px;">
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-info">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <form asp-action="ToggleVisible" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit"
                                class="btn btn-sm @(t.IsVisible?"btn-warning":"btn-success")">
                            <i class="fas @(t.IsVisible?"fa-eye-slash":"fa-eye")"></i>
                        </button>
                    </form>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Delete?')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>