@using GECPatan.Core.Models.Domain
@model List<Testimonial>

@{
    ViewData["Title"] = "Testimonials";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Testimonial(s)
        </span>

        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-2"></i>Add Testimonial
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead style="background:#1a237e;color:#fff;">
                    <tr>
                        <th width="50">ID</th>
                        <th width="220">Student</th>
                        <th>Testimonial</th>
                        <th width="90">Status</th>
                        <th width="200">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-quote-left fa-2x mb-2 d-block"></i>
                                No testimonials yet.
                            </td>
                        </tr>
                    }

                    @foreach (var t in Model)
                    {
                        <tr class="@(!t.IsVisible ? "table-secondary" : "")">
                            <td class="align-middle">
                                <small class="text-muted">@t.Id</small>
                            </td>

                            <td class="align-middle">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mr-2"
                                         style="width:35px;height:35px;min-width:35px;">
                                        <i class="fas fa-user text-white"></i>
                                    </div>

                                    <div>
                                        <strong style="font-size:13px;">
                                            @t.StudentName
                                        </strong>

                                        <small class="text-muted d-block">
                                            @t.Department — @t.PassoutYear
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td class="align-middle">
                                <small class="text-muted" style="font-style:italic;">
                                    "@(string.IsNullOrEmpty(t.TestimonialText)
                                                                            ? ""
                                                                            : t.TestimonialText.Length > 150
                                                                                ? t.TestimonialText.Substring(0, 150) + "..."
                                                                                : t.TestimonialText)"
                                </small>
                            </td>

                            <td class="align-middle">
                                @if (!t.IsVisible)
                                {
                                    <span class="badge badge-secondary"
                                          style="font-size:9px;">
                                        Hidden
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-success"
                                          style="font-size:9px;">
                                        Visible
                                    </span>
                                }
                            </td>

                            <td class="align-middle">
                                <a asp-action="Edit"
                                   asp-route-id="@t.Id"
                                   class="btn btn-xs btn-info">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <form asp-action="ToggleVisible"
                                      method="post"
                                      class="d-inline">
                                    <input type="hidden" name="id" value="@t.Id" />

                                    <button type="submit"
                                            class="btn btn-xs @(t.IsVisible ? "btn-warning" : "btn-success")"
                                            title="@(t.IsVisible ? "Hide" : "Show")">
                                        <i class="fas @(t.IsVisible ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                </form>

                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline">
                                    <input type="hidden" name="id" value="@t.Id" />

                                    <button type="submit"
                                            class="btn btn-xs btn-danger"
                                            onclick="return confirm('Delete testimonial?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>