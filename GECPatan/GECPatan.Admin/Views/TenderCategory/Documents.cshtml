@model List<GECPatan.Admin.Models.ViewModels.TenderDocumentVM>
@{
    ViewData["Title"] = "Tender Documents";
    int categoryId     = ViewBag.CategoryId;
    string catTitle    = ViewBag.CategoryTitle ?? "";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Documents</h5>
        <small class="text-muted">@catTitle</small>
    </div>
</div>
 
<div class="row">
    <!-- Add Document Form -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Document
                </h6>
            </div>
            <form asp-action="AddDocument" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    <input type="hidden" name="TenderCategoryId" value="@categoryId" />
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Document Title <span class="text-danger">*</span>
                        </label>
                        <input name="DocTitle" class="form-control"
                               placeholder="e.g. Tender Notice, Corrigendum" required />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Valid From</label>
                                <input name="ValidFrom" class="form-control"
                                       type="date" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Valid To</label>
                                <input name="ValidTo" class="form-control"
                                       type="date" />
                            </div>
                        </div>
                        <div class="col-6">
                        <div class="form-group">
                            <label class="font-weight-bold">
                                Month/Year <span class="text-danger">*</span>
                            </label>
                            <input name="MonthYear" class="form-control"
                                   placeholder="e.g. 2023-2024" required />
                        </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">PDF File</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" name="DocFile"
                                   accept=".pdf"
                                   onchange="this.nextElementSibling.textContent=this.files[0]?.name||'Choose PDF...'" />
                            <label class="custom-file-label">Choose PDF...</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" name="IsVisible" value="true"
                                   class="custom-control-input" id="isVisible" checked />
                            <label class="custom-control-label" for="isVisible">
                                Visible
                            </label>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add Document
                    </button>
                </div>
            </form>
        </div>
    </div>
 
    <!-- Documents List -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-file-alt mr-2"></i>
                    Documents (@Model.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">
                        No documents in this category yet.
                    </p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Title</th>
                                <th width="130">Valid From</th>
                                <th width="130">Valid To</th>
                                <th width="130">Month/Year</th>
                                <th width="70">File</th>
                                <th width="80">Status</th>
                                <th width="100">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model)
                            {
                                <tr>
                                    <td><strong>@doc.DocTitle</strong></td>
                                    <td>
                                        <small>
                                            @(doc.ValidFrom.HasValue
                                                ? doc.ValidFrom.Value.ToString("dd MMM yyyy") : "—")
                                        </small>
                                    </td>
                                    <td>
                                        <small>
                                            @(doc.ValidTo.HasValue
                                                ? doc.ValidTo.Value.ToString("dd MMM yyyy") : "—")
                                        </small>
                                    </td>
                                    <td>
                                        <small>@(doc.MonthYear ?? "—")</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(doc.ExistingFilePath))
                                        {
                                            <a href="@doc.ExistingFilePath" target="_blank"
                                               class="btn btn-xs btn-outline-danger">
                                                <i class="fas fa-file-pdf"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>
                                        @if (doc.IsVisible)
                                        {
                                            <span class="badge badge-success">Visible</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Hidden</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="ToggleDocVisible" method="post"
                                              class="d-inline">
                                            <input type="hidden" name="id" value="@doc.Id" />
                                            <input type="hidden" name="categoryId"
                                                   value="@categoryId" />
                                            <button type="submit"
                                                    class="btn btn-xs @(doc.IsVisible?"btn-warning":"btn-success")">
                                                <i class="fas @(doc.IsVisible?"fa-eye-slash":"fa-eye")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteDocument" method="post"
                                              class="d-inline">
                                            <input type="hidden" name="id" value="@doc.Id" />
                                            <input type="hidden" name="categoryId"
                                                   value="@categoryId" />
                                            <button type="submit" class="btn btn-xs btn-danger"
                                                    onclick="return confirm('Delete?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>