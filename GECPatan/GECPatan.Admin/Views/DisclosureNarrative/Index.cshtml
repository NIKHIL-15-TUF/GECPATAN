@{
    ViewData["Title"] = "Mandatory Disclosure — Narrative Sections";
    var grouped = ViewBag.Grouped as Dictionary<string,
        List<GECPatan.Admin.Models.ViewModels.NarrativeIndexVM>>;
}
 
<div class="card mb-3"
     style="background:linear-gradient(135deg,#1a237e,#283593);
    color:#fff;border:none;">
    <div class="card-body py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">
                <i class="fas fa-file-alt mr-2"></i>
                Narrative Sections
            </h5>
            <small style="opacity:.8;">
                Strictly 19 fixed sections — Edit content only.
                No add or delete.
            </small>
        </div>
        <a asp-controller="Disclosure" asp-action="Preview"
               target="_blank"
               class="btn btn-light btn-sm">
            <i class="fas fa-eye mr-1"></i>Preview Document
        </a>
    </div>
</div>
 
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3">
        <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
 
@if (grouped != null)
{
    @foreach (var group in grouped)
    {
        <div class="card mb-3">
            <div class="card-header" style="background:#eef0fb;">
                <h6 class="card-title mb-0 text-primary">
                    <i class="fas fa-folder-open mr-2"></i>
                    @group.Key
                    <small class="text-muted ml-2">
                        (@group.Value.Count(x => x.HasContent) /
                        @group.Value.Count filled)
                    </small>
                </h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Section</th>
                            <th width="90">Storage</th>
                            <th width="90">Status</th>
                            <th width="80">Visible</th>
                            <th width="160">Last Updated</th>
                            <th width="80">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in group.Value)
                        {
                            <tr class="@(!item.HasContent ? "table-warning" : "")">
                                <td>
                                    <strong>@item.SectionTitle</strong>
                                    <small class="text-muted d-block"
                                           style="font-size:10px;">
                                        Key: @item.SectionKey
                                    </small>
                                </td>
                                <td>
                                    @if (item.IsDbSection)
                                    {
                                        <span class="badge badge-primary"
                                              style="font-size:9px;">DB</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary"
                                              style="font-size:9px;">Settings</span>
                                    }
                                </td>
                                <td>
                                    @if (item.HasContent)
                                    {
                                        <span class="badge badge-success">
                                            Filled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">
                                            Empty
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!item.IsDbSection)
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                    else if (item.IsVisible)
                                    {
                                        <span class="badge badge-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    @if (item.LastUpdated.HasValue)
                                    {
                                        <small>
                                            @item.LastUpdated.Value.ToString("dd MMM yyyy")
                                            <br />
                                            <span class="text-muted">
                                                @item.UpdatedBy
                                            </span>
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Never</small>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit"
                                           asp-route-key="@item.SectionKey"
                                           class="btn btn-xs btn-primary">
                                        <i class="fas fa-edit mr-1"></i>Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}