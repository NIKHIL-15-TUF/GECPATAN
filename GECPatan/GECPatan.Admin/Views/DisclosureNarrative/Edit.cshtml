@model GECPatan.Admin.Models.ViewModels.DisclosureNarrativeEditVM
@{
    ViewData["Title"] = "Edit Narrative Section";
}
 
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h3 class="card-title mb-0">
            <i class="fas fa-edit mr-2"></i>@Model.SectionTitle
        </h3>
    </div>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="SectionKey" type="hidden" />
        <input asp-for="SectionTitle" type="hidden" />
 
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    @Html.ValidationSummary(false)
                </div>
            }
 
            <div class="alert alert-light border py-2 mb-3">
                <small class="text-muted">
                    <i class="fas fa-lock mr-1"></i>
                    Section: <strong>@Model.SectionTitle</strong>
                    (<code>@Model.SectionKey</code>) —
                    title and key are fixed by AICTE format.
                </small>
            </div>
 
            <div class="form-group">
                <label asp-for="HtmlContent" class="font-weight-bold">
                    Content
                </label>
                <textarea asp-for="HtmlContent" id="htmlContent"
                          class="form-control" rows="14"></textarea>
            </div>
 
            <div class="form-group mt-3">
                <div class="custom-control custom-switch">
                    <input asp-for="IsVisible" type="checkbox"
                           class="custom-control-input" id="isVisible" />
                    <label class="custom-control-label" for="isVisible">
                        Include this section in generated documents
                    </label>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left mr-2"></i>Back
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>Save
            </button>
        </div>
    </form>
</div>
 
@section Scripts {
   <script src="~/tinymce/tinymce.min.js"></script>
    <script src="https://cdn.tiny.cloud/1/18c5arljshkibt2xb5jfkdlmr3uosv3lagdiujmk5c9jlv49/tinymce/6/tinymce.min.js"
            referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '#htmlContent',
            height: 400,
            menubar: false,
            plugins: 'lists link table code',
            toolbar: 'undo redo | formatselect | bold italic | ' +
                     'bullist numlist | table | link | code'
        });
    </script>
}