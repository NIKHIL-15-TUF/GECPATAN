@using GECPatan.Core.Models.Domain
@model List<SSIPDocument>
@{
    ViewData["Title"] = "SSIP Documents";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Document(s)
        </span>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-2"></i>Add SSIP Document
        </a>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th>Title</th>
                    <th width="130">Upload Date</th>
                    <th width="80">File</th>
                    <th width="80">Status</th>
                    <th width="140">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fas fa-lightbulb fa-2x mb-2 d-block"></i>
                            No SSIP documents yet.
                        </td>
                    </tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td><strong>@s.Title</strong></td>
                        <td><small>@s.UploadDate</small></td>
                        <td>
                            @if (!string.IsNullOrEmpty(s.FilePath))
                            {
                                <a href="@s.FilePath" target="_blank"
                                   class="btn btn-xs btn-outline-danger">
                                    <i class="fas fa-file-pdf mr-1"></i>View
                                </a>
                            }
                        </td>
                        <td>
                            @if (s.IsVisible)
                            {
                                <span class="badge badge-success">Visible</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Hidden</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.Id"
                               class="btn btn-sm btn-info">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="ToggleVisible" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit"
                                        class="btn btn-sm @(s.IsVisible?"btn-warning":"btn-success")">
                                    <i class="fas @(s.IsVisible?"fa-eye-slash":"fa-eye")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>