@model GECPatan.Admin.Models.ViewModels.ChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
    bool isForced = ViewBag.IsForcedChange == true;
}
<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        @if (isForced)
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                <strong>Action Required:</strong>
                You must change your password before continuing.
            </div>
        }
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title mb-0">
                    <i class="fas fa-key mr-2"></i>
                    @(isForced ? "Set Your New Password" : "Change Password")
                </h3>
            </div>
            <form asp-action="ChangePassword" method="post">
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="form-group">
                        <label asp-for="CurrentPassword" class="font-weight-bold"></label>
                        <input asp-for="CurrentPassword" class="form-control"
                               type="password"
                               placeholder="Enter current / temporary password" />
                        <span asp-validation-for="CurrentPassword"
                              class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewPassword" class="font-weight-bold"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" class="form-control"
                                   type="password" id="newPwd"
                                   placeholder="Minimum 8 characters" />
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="togglePwd('newPwd',this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="font-weight-bold"></label>
                        <input asp-for="ConfirmPassword" class="form-control"
                               type="password"
                               placeholder="Re-enter new password" />
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-check mr-2"></i>
                        @(isForced ? "Set Password & Continue" : "Change Password")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePwd(id, btn) {
            const input = document.getElementById(id);
            const isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            btn.innerHTML = isText
                ? '<i class="fas fa-eye"></i>'
                : '<i class="fas fa-eye-slash"></i>';
        }
    </script>
}