@model GECPatan.Admin.Models.ViewModels.LoginVM
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AccountLayout";
}

<div class="login-box">

    <div class="login-logo">
        <a href="#">
            <i class="fas fa-university" style="font-size:48px; color:#fff; display:block; text-align:center; margin-bottom:8px;"></i>
            <strong>GEC Patan</strong>
            <small>Admin Panel</small>
        </a>
    </div>

    <div class="card">
        <div class="card-body login-card-body text-center">

            <i class="fas fa-ban fa-4x text-danger mb-3 mt-2"></i>
            <h4 class="mb-2">Access Denied</h4>
            <p class="text-muted mb-4">
                You do not have permission to view this page.<br />
                Please contact your administrator.
            </p>

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-block mb-2">
                <i class="fas fa-home mr-2"></i> Go to Dashboard
            </a>

            <a asp-controller="Account" asp-action="Logout" class="btn btn-secondary btn-block">
                <i class="fas fa-sign-out-alt mr-2"></i> Logout
            </a>

        </div>
    </div>

</div>