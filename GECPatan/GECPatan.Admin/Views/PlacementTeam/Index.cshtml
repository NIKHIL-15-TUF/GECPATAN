@using GECPatan.Admin.Models.Domain
@model List<PlacementTeamMember>
@{
    ViewData["Title"] = "Placement Team";
}
 
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Member(s)
        </span>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-2"></i>Add Member
        </a>
    </div>
</div>
 
<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5 text-muted">
                    <i class="fas fa-user-tie fa-3x mb-3 d-block"></i>
                    No team members yet.
                </div>
            </div>
        </div>
    }
    @foreach (var t in Model)
    {
        <div class="col-md-3 col-6 mb-3">
            <div class="card text-center @(!t.IsVisible ? "border-secondary" : "")">
                <div class="card-body p-3">
                    @if (!string.IsNullOrEmpty(t.ImagePath))
                    {
                        <img src="@t.ImagePath"
                             class="img-thumbnail rounded-circle mb-2"
                             style="width:70px;height:70px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary rounded-circle d-inline-flex
                            align-items-center justify-content-center mb-2"
                             style="width:70px;height:70px;">
                            <i class="fas fa-user fa-2x text-white"></i>
                        </div>
                    }
                    <h6 class="mb-0" style="font-size:13px;">@t.Name</h6>
                    <small class="text-muted">@t.Designation</small>
                    @if (!string.IsNullOrEmpty(t.Email))
                    {
                        <small class="text-muted d-block" style="font-size:11px;">
                            @t.Email
                        </small>
                    }
                    @if (!t.IsVisible)
                    {
                        <span class="badge badge-secondary mt-1">Hidden</span>
                    }
                </div>
                <div class="card-footer py-1 d-flex justify-content-center"
                     style="gap:3px;">
                    <form asp-action="Reorder" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <input type="hidden" name="direction" value="up" />
                        <button type="submit" class="btn btn-xs btn-light border px-1">
                            <i class="fas fa-chevron-left" style="font-size:9px;"></i>
                        </button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@t.Id"
                           class="btn btn-xs btn-info px-1">
                        <i class="fas fa-edit" style="font-size:9px;"></i>
                    </a>
                    <form asp-action="ToggleVisible" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit"
                                class="btn btn-xs @(t.IsVisible ? "btn-warning" : "btn-success") px-1">
                            <i class="fas @(t.IsVisible ? "fa-eye-slash" : "fa-eye")"
                               style="font-size:9px;"></i>
                        </button>
                    </form>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn btn-xs btn-danger px-1"
                                onclick="return confirm('Delete?')">
                            <i class="fas fa-trash" style="font-size:9px;"></i>
                        </button>
                    </form>
                    <form asp-action="Reorder" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <input type="hidden" name="direction" value="down" />
                        <button type="submit" class="btn btn-xs btn-light border px-1">
                            <i class="fas fa-chevron-right" style="font-size:9px;"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>