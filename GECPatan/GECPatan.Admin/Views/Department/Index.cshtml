@model List<GECPatan.Admin.Models.ViewModels.DepartmentListVM>
@{
    ViewData["Title"] = "Departments";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Department(s)
        </span>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus mr-2"></i>Add Department
            </a>
        }
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th width="60">Order</th>
                    <th width="60">Image</th>
                    <th>Name</th>
                    <th width="80">Code</th>
                    <th width="80">Intake</th>
                    <th width="80">Faculty</th>
                    <th width="80">Labs</th>
                    <th width="80">Status</th>
                    <th width="180">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="fas fa-building fa-2x mb-2 d-block"></i>
                            No departments yet.
                        </td>
                    </tr>
                }
                @foreach (var dept in Model)
                {
                    <tr>
                        <td>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <div class="d-flex flex-column" style="gap:2px;">
                                    <form asp-action="Reorder" method="post">
                                        <input type="hidden" name="id" value="@dept.DeptId" />
                                        <input type="hidden" name="direction" value="up" />
                                        <button type="submit" class="btn btn-xs btn-light border px-2 py-1">
                                            <i class="fas fa-chevron-up" style="font-size:10px;"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Reorder" method="post">
                                        <input type="hidden" name="id" value="@dept.DeptId" />
                                        <input type="hidden" name="direction" value="down" />
                                        <button type="submit" class="btn btn-xs btn-light border px-2 py-1">
                                            <i class="fas fa-chevron-down" style="font-size:10px;"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(dept.TitleImagePath))
                            {
                                <img src="@dept.TitleImagePath" class="img-thumbnail"
                                     style="width:45px;height:45px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="width:45px;height:45px;border-radius:4px;">
                                    <i class="fas fa-building text-muted"></i>
                                </div>
                            }
                        </td>
                        <td><strong>@dept.Name</strong></td>
                        <td>
                            @if (!string.IsNullOrEmpty(dept.ShortCode))
                            {
                                <span class="badge badge-secondary">@dept.ShortCode</span>
                            }
                        </td>
                        <td>
                            <span class="badge badge-light border">@dept.Intake</span>
                        </td>
                        <td>
                            <span class="badge badge-success">@dept.FacultyCount</span>
                        </td>
                        <td>
                            <span class="badge badge-info">@dept.LabCount</span>
                        </td>
                        <td>
                            @if (dept.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@dept.DeptId"
                                   class="btn btn-sm btn-info mb-1">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@dept.DeptId" />
                                    <button type="submit"
                                            class="btn btn-sm @(dept.IsActive ? "btn-warning" : "btn-success") mb-1"
                                            onclick="return confirm('Toggle status?')">
                                        <i class="fas @(dept.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@dept.DeptId" />
                                    <button type="submit" class="btn btn-sm btn-danger mb-1"
                                            onclick="return confirm('Delete?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>