@model GECPatan.Admin.Models.ViewModels.DepartmentCreateVM
@{
    ViewData["Title"] = "Add Department";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e; color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-building mr-2"></i>New Department
                </h3>
            </div>

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div class="card-body">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <!-- Name + ShortCode -->
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="Name" class="font-weight-bold"></label>
                                <input asp-for="Name" class="form-control"
                                       placeholder="e.g. Computer Science & Engineering" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ShortCode" class="font-weight-bold"></label>
                                <input asp-for="ShortCode" class="form-control"
                                       placeholder="e.g. CSE" />
                            </div>
                        </div>
                    </div>

                    <!-- About -->
                    <div class="form-group">
                        <label class="font-weight-bold">About Department</label>
                        <textarea asp-for="About" class="form-control" rows="4"
                                  placeholder="Brief description of the department..."></textarea>
                    </div>

                    <!-- Stats -->
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Intake" class="font-weight-bold"></label>
                                <input asp-for="Intake" class="form-control" type="number" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="FacultyCount" class="font-weight-bold"></label>
                                <input asp-for="FacultyCount" class="form-control" type="number" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="LabCount" class="font-weight-bold"></label>
                                <input asp-for="LabCount" class="form-control" type="number" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="AnnualPlacement" class="font-weight-bold"></label>
                                <input asp-for="AnnualPlacement" class="form-control" type="number" min="0" />
                            </div>
                        </div>
                    </div>

                    <!-- Title Image -->
                    <div class="form-group">
                        <label class="font-weight-bold">Department Banner Image</label>
                        <div class="input-group">
                            <div class="custom-file">
                                <input type="file" class="custom-file-input"
                                       id="TitleImage" name="TitleImage"
                                       accept="image/*"
                                       onchange="previewImage(this, 'titlePreview')" />
                                <label class="custom-file-label" for="TitleImage">
                                    Choose image...
                                </label>
                            </div>
                        </div>
                        <img id="titlePreview" src="#" alt="Preview"
                             class="img-thumbnail mt-2 d-none"
                             style="max-height:120px;" />
                    </div>

                    <!-- HOD Info -->
                    <hr />
                    <h6 class="font-weight-bold text-muted mb-3">
                        <i class="fas fa-user-tie mr-2"></i>HOD Information
                    </h6>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="HODName" class="font-weight-bold"></label>
                                <input asp-for="HODName" class="form-control"
                                       placeholder="Dr. Full Name" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">HOD Photo</label>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input"
                                           id="HODImage" name="HODImage"
                                           accept="image/*"
                                           onchange="previewImage(this, 'hodPreview')" />
                                    <label class="custom-file-label" for="HODImage">
                                        Choose photo...
                                    </label>
                                </div>
                                <img id="hodPreview" src="#" alt="Preview"
                                     class="img-thumbnail mt-2 d-none"
                                     style="max-height:80px;" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="HODMessage" class="font-weight-bold"></label>
                        <textarea asp-for="HODMessage" class="form-control" rows="3"
                                  placeholder="HOD's message to students..."></textarea>
                    </div>

                    <!-- Other -->
                    <hr />
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="Tagline" class="font-weight-bold"></label>
                                <input asp-for="Tagline" class="form-control"
                                       placeholder="e.g. Innovate. Create. Lead." />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                                <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="ShowIntake" type="checkbox"
                                   class="custom-control-input" id="showIntake" />
                            <label class="custom-control-label" for="showIntake">
                                Show Intake on Website
                            </label>
                        </div>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save Department
                    </button>
                </div>

            </form>
        </div>
    </div>

    <!-- Tips -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-info"></i>Tips
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-2">
                    <i class="fas fa-check text-success mr-1"></i>
                    After creating the department, go to <strong>Edit</strong> to add Vision, Mission, PEOs and PSOs.
                </p>
                <p class="small text-muted mb-2">
                    <i class="fas fa-check text-success mr-1"></i>
                    Faculty members can be assigned to this department from the <strong>Faculty</strong> section.
                </p>
                <p class="small text-muted mb-0">
                    <i class="fas fa-check text-success mr-1"></i>
                    Use <strong>Display Order</strong> to control the order departments appear on the website.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input, previewId) {
            const preview = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Update file input label
        document.querySelectorAll('.custom-file-input').forEach(input => {
            input.addEventListener('change', function () {
                const label = this.nextElementSibling;
                if (this.files.length > 0) {
                    label.textContent = this.files[0].name;
                }
            });
        });
    </script>
}