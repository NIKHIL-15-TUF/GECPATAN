@model GECPatan.Admin.Models.ViewModels.DepartmentCreateVM
@{
    ViewData["Title"] = "Add Department";
}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title">
                    <i class="fas fa-building mr-2"></i>New Department
                </h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="Name" class="font-weight-bold"></label>
                                <input asp-for="Name" class="form-control"
                                       placeholder="e.g. Computer Science & Engineering" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ShortCode" class="font-weight-bold"></label>
                                <input asp-for="ShortCode" class="form-control"
                                       placeholder="e.g. CSE" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">About Department</label>
                        <textarea asp-for="About" class="form-control" rows="4"
                                  placeholder="Brief description..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Tagline" class="font-weight-bold"></label>
                                <input asp-for="Tagline" class="form-control"
                                       placeholder="e.g. Innovate. Create. Lead." />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="AnnualPlacement" class="font-weight-bold"></label>
                                <input asp-for="AnnualPlacement" class="form-control"
                                       type="number" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                                <input asp-for="DisplayOrder" class="form-control"
                                       type="number" min="0" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Title Image</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" name="TitleImage"
                                   accept="image/*"
                                   onchange="previewImg(this,'titlePreview')" />
                            <label class="custom-file-label">Choose image...</label>
                        </div>
                        <img id="titlePreview" src="#"
                             class="img-thumbnail mt-2 d-none" style="max-height:100px;" />
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="ShowIntake" type="checkbox"
                                   class="custom-control-input" id="showIntake" />
                            <label class="custom-control-label" for="showIntake">
                                Show Intake on Website
                            </label>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Save Department
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle mr-2 text-info"></i>Next Steps
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-1">After creating, go to Edit to add:</p>
                <ul class="small text-muted pl-3 mb-0">
                    <li>Banner Images (carousel)</li>
                    <li>Vision & Mission statements</li>
                    <li>PEOs & PSOs</li>
                    <li>Program Intake (year-wise)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function previewImg(input, previewId) {
        const preview = document.getElementById(previewId);
        if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
        preview.src = e.target.result;
        preview.classList.remove('d-none');
        };
        reader.readAsDataURL(input.files[0]);
        input.nextElementSibling.textContent = input.files[0].name;
        }
        }
    </script>
}