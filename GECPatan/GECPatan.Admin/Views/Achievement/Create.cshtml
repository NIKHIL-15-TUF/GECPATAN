@model GECPatan.Admin.Models.ViewModels.AchievementCreateVM
@{
    ViewData["Title"] = "Add Achievement";
}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h3 class="card-title"><i class="fas fa-trophy mr-2"></i>Add Achievement</h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                    }
                    <div class="form-group">
                        <label asp-for="Title" class="font-weight-bold"></label>
                        <textarea asp-for="Title" class="form-control" rows="2" placeholder="Achievement title..."></textarea>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the achievement..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Date" class="font-weight-bold"></label>
                                <input asp-for="Date" class="form-control" placeholder="e.g. 2025/12/13" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Year" class="font-weight-bold"></label>
                                <input asp-for="Year" class="form-control" type="number" placeholder="e.g. 2025" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Type" class="font-weight-bold"></label>
                                <select asp-for="Type" asp-items="Model.Types" class="form-control"></select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DeptId" class="font-weight-bold"></label>
                                <select asp-for="DeptId" asp-items="Model.Departments" class="form-control">
                                    <option value="">-- None --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DeptName" class="font-weight-bold"></label>
                                <input asp-for="DeptName" class="form-control" placeholder="e.g. CSE, NSS, Gymkhana" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="CommitteeId" class="font-weight-bold"></label>
                        <select asp-for="CommitteeId" asp-items="Model.Committees" class="form-control">
                            <option value="">-- None --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="Keywords" class="font-weight-bold"></label>
                        <input asp-for="Keywords" class="form-control" placeholder="e.g. NSS, Sports, Academic" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Achievement Image</label>
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" name="Image" accept="image/*"
                                           onchange="previewImg(this)" />
                                    <label class="custom-file-label">Choose image...</label>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <img id="imgPreview" src="#" class="img-thumbnail d-none"
                                     style="max-height:80px;" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox" class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">Visible on website</label>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left mr-2"></i>Back</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-2"></i>Save Achievement</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0"><i class="fas fa-info-circle mr-2 text-info"></i>Tips</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-2"><i class="fas fa-check text-success mr-1"></i><strong>Date</strong> format: YYYY/MM/DD (e.g. 2025/12/13)</p>
                <p class="small text-muted mb-2"><i class="fas fa-check text-success mr-1"></i><strong>Dept Name</strong> is the display label (e.g. "CSE", "NSS")</p>
                <p class="small text-muted mb-0"><i class="fas fa-check text-success mr-1"></i>Link to Dept OR Committee — both optional.</p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function previewImg(input) {
        const preview = document.getElementById('imgPreview');
        if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.classList.remove('d-none'); };
        reader.readAsDataURL(input.files[0]);
        input.nextElementSibling.textContent = input.files[0].name;
        }
        }
    </script>
}