@model GECPatan.Admin.Models.ViewModels.AchievementEditVM
@{
    ViewData["Title"] = "Edit Achievement";
}
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h3 class="card-title"><i class="fas fa-edit mr-2"></i>Edit Achievement</h3>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
            }
            <div class="form-group">
                <label asp-for="Title" class="font-weight-bold"></label>
                <textarea asp-for="Title" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label class="font-weight-bold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Date" class="font-weight-bold"></label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Year" class="font-weight-bold"></label>
                        <input asp-for="Year" class="form-control" type="number" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Type" class="font-weight-bold"></label>
                        <select asp-for="Type" asp-items="Model.Types" class="form-control"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DeptId" class="font-weight-bold"></label>
                        <select asp-for="DeptId" asp-items="Model.Departments" class="form-control">
                            <option value="">-- None --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DeptName" class="font-weight-bold"></label>
                        <input asp-for="DeptName" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="CommitteeId" class="font-weight-bold"></label>
                <select asp-for="CommitteeId" asp-items="Model.Committees" class="form-control">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Keywords" class="font-weight-bold"></label>
                <input asp-for="Keywords" class="form-control" />
            </div>
            <div class="form-group">
                <label class="font-weight-bold">Achievement Image</label>
                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                {
                    <div class="mb-2">
                        <img src="@Model.ExistingImagePath" class="img-thumbnail" style="max-height:100px;" />
                        <small class="text-muted d-block">Current image</small>
                    </div>
                }
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="custom-file">
                            <input type="file" name="Image" class="custom-file-input" accept="image/*"
                                   onchange="previewImg(this)" />
                            <label class="custom-file-label">@(string.IsNullOrEmpty(Model.ExistingImagePath) ? "Choose image..." : "Replace image...")</label>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <img id="imgPreview" src="#" class="img-thumbnail d-none" style="max-height:80px;" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input asp-for="IsVisible" type="checkbox" class="custom-control-input" id="isVisible" />
                    <label class="custom-control-label" for="isVisible">Visible on website</label>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left mr-2"></i>Back</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-2"></i>Save Changes</button>
        </div>
    </form>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function previewImg(input) {
        const preview = document.getElementById('imgPreview');
        if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.classList.remove('d-none'); };
        reader.readAsDataURL(input.files[0]);
        input.nextElementSibling.textContent = input.files[0].name;
        }
        }
    </script>
}
