@using  GECPatan.Core.Models.Domain
@model List<PrincipalAchievement>
@{
    int principalId = ViewBag.PrincipalId;
    string principalName = ViewBag.PrincipalName ?? "";
    ViewData["Title"] = "Achievements";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@principalId"
           class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Achievements</h5>
        <small class="text-muted">@principalName</small>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Achievement
                </h6>
            </div>
            <form asp-action="AddAchievement" method="post">
                <div class="card-body">
                    <input type="hidden" name="PrincipalId"
                           value="@principalId" />
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Achievement <span class="text-danger">*</span>
                        </label>
                        <textarea name="AchievementText"
                                  class="form-control" rows="3" required
                                  placeholder="Describe the achievement..."></textarea>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Year</label>
                        <input name="Year" class="form-control"
                               placeholder="e.g. 2023" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Display Order</label>
                        <input name="DisplayOrder" class="form-control"
                               type="number" value="@Model.Count" min="0" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-trophy mr-2"></i>
                    Achievements (@Model.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">
                        No achievements yet.
                    </p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in Model)
                        {
                            <li class="list-group-item d-flex
                                justify-content-between
                                align-items-start">
                                <div>
                                    <i class="fas fa-trophy text-warning mr-2"></i>
                                    @a.AchievementText
                                    @if (!string.IsNullOrEmpty(a.Year))
                                    {
                                        <span class="badge badge-secondary ml-1">
                                            @a.Year
                                        </span>
                                    }
                                </div>
                                <form asp-action="DeleteAchievement"
                                      method="post" class="ml-2">
                                    <input type="hidden" name="id"
                                           value="@a.Id" />
                                    <input type="hidden" name="principalId"
                                           value="@principalId" />
                                    <button type="submit"
                                            class="btn btn-xs btn-danger"
                                            onclick="return confirm('Remove?')">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>