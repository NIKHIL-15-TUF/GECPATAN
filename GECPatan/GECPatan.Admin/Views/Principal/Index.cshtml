@model GECPatan.Admin.Models.ViewModels.PrincipalVM
@{
    ViewData["Title"] = "Principal Profile";
}
<form asp-action="Index" method="post" enctype="multipart/form-data">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
    }

    <ul class="nav nav-tabs mb-0" id="principalTabs">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#basic">
                <i class="fas fa-user mr-1"></i>Basic Info
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#message">
                <i class="fas fa-comment mr-1"></i>Message
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#academic">
                <i class="fas fa-graduation-cap mr-1"></i>Academic
            </a>
        </li>
    </ul>

    <div class="card" style="border-top:none;border-radius:0 0 8px 8px;">
        <div class="tab-content card-body">

            <!-- TAB 1: BASIC INFO -->
            <div class="tab-pane fade show active" id="basic">
                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group">
                            <label asp-for="Name" class="font-weight-bold"></label>
                            <input asp-for="Name" class="form-control"
                                   placeholder="Dr. Full Name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Designation" class="font-weight-bold"></label>
                                    <input asp-for="Designation" class="form-control"
                                           placeholder="e.g. Principal & Professor" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Qualification" class="font-weight-bold"></label>
                                    <input asp-for="Qualification" class="form-control"
                                           placeholder="e.g. Ph.D., M.E." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Email" class="font-weight-bold"></label>
                                    <input asp-for="Email" class="form-control"
                                           placeholder="principal@gecpatan.ac.in" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Contact" class="font-weight-bold"></label>
                                    <input asp-for="Contact" class="form-control"
                                           placeholder="+91 9876543210" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">About</label>
                            <textarea asp-for="About" class="form-control" rows="5"
                                      placeholder="Brief about the principal..."></textarea>
                        </div>
                    </div>

                    <!-- Photo -->
                    <div class="col-md-4 text-center">
                        @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                        {
                            <img src="@Model.ExistingImagePath" id="photoPreview"
                                 class="img-thumbnail rounded-circle mb-2"
                                 style="width:150px;height:150px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary rounded-circle d-inline-flex
                                align-items-center justify-content-center mb-2"
                                 style="width:150px;height:150px;">
                                <i class="fas fa-user fa-4x text-white"></i>
                            </div>
                            <img id="photoPreview" src="#"
                                 class="img-thumbnail rounded-circle mb-2 d-none"
                                 style="width:150px;height:150px;object-fit:cover;" />
                        }
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" name="Photo"
                                   accept="image/*"
                                   onchange="previewPhoto(this)" />
                            <label class="custom-file-label">
                                @(string.IsNullOrEmpty(Model.ExistingImagePath)
                                    ? "Upload photo" : "Replace photo")
                            </label>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Square image recommended
                        </small>
                    </div>
                </div>
            </div>

            <!-- TAB 2: MESSAGE -->
            <div class="tab-pane fade" id="message">
                <div class="form-group">
                    <label class="font-weight-bold">
                        <i class="fas fa-comment mr-1 text-primary"></i>
                        Principal's Message
                    </label>
                    <small class="text-muted d-block mb-2">
                        This message appears on the Principal's message page.
                    </small>
                    <textarea asp-for="Message" id="messageEditor"
                              class="form-control" rows="15"
                              placeholder="Principal's message..."></textarea>
                </div>
            </div>

            <!-- TAB 3: ACADEMIC -->
            <div class="tab-pane fade" id="academic">
                <div class="form-group">
                    <label asp-for="ExperienceText" class="font-weight-bold"></label>
                    <textarea asp-for="ExperienceText" class="form-control" rows="5"
                              placeholder="Teaching and research experience..."></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="ResearchInterests" class="font-weight-bold"></label>
                    <textarea asp-for="ResearchInterests" class="form-control" rows="4"
                              placeholder="Research areas and interests..."></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="Publications" class="font-weight-bold"></label>
                    <textarea asp-for="Publications" class="form-control" rows="6"
                              placeholder="List of publications (one per line)..."></textarea>
                </div>
            </div>

        </div>

        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>Save Principal Profile
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        tinymce.init({
        selector: '#messageEditor',
        plugins: 'link lists code',
        toolbar: 'undo redo | formatselect | bold italic | bullist numlist | link | code',
        height: 400,
        menubar: false,
        promotion: false,
        branding: false,
        setup: function(editor) {
        editor.on('change', function() { tinymce.triggerSave(); });
        }
        });

        document.querySelector('form').addEventListener('submit', function() {
        tinymce.triggerSave();
        });

        function previewPhoto(input) {
        const preview = document.getElementById('photoPreview');
        if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
        preview.src = e.target.result;
        preview.classList.remove('d-none');
        };
        reader.readAsDataURL(input.files[0]);
        input.nextElementSibling.textContent = input.files[0].name;
        }
        }

        const activeTab = localStorage.getItem('principalTab');
        if (activeTab) $(`a[href="${activeTab}"]`).tab('show');
        $('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
        localStorage.setItem('principalTab', $(e.target).attr('href'));
        });
    </script>
}
