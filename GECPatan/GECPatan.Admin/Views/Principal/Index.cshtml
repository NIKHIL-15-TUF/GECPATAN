@model List<GECPatan.Admin.Models.ViewModels.PrincipalListVM>
@{
    ViewData["Title"] = "Principal";
    var active = Model.FirstOrDefault(p => p.IsActive);
    var past = Model.Where(p => !p.IsActive).ToList();
}
 
<!-- Active Principal -->
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 font-weight-bold">
            <i class="fas fa-user-tie mr-2 text-primary"></i>
            Principal Management
        </h6>
        @if (User.IsInRole("SuperAdmin"))
        {
            <div style="gap:8px;display:flex;">
                @if (active != null)
                {
                    <a asp-action="Transfer"
                           class="btn btn-warning btn-sm">
                        <i class="fas fa-exchange-alt mr-1"></i>
                        Transfer / Replace
                    </a>
                }
                else
                {
                    <a asp-action="Create"
                           class="btn btn-primary btn-sm">
                        <i class="fas fa-plus mr-1"></i>
                        Add Principal
                    </a>
                }
            </div>
        }
    </div>
</div>
 
@if (active != null)
{
    <div class="card mb-4 border-success">
        <div class="card-header bg-success text-white d-flex
            justify-content-between align-items-center">
            <h6 class="card-title mb-0">
                <i class="fas fa-check-circle mr-2"></i>
                Current Principal
            </h6>
            <span class="badge badge-light text-success">Active</span>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    @if (!string.IsNullOrEmpty(active.PhotoPath))
                    {
                        <img src="@active.PhotoPath"
                             class="img-thumbnail rounded-circle"
                             style="width:90px;height:90px;
                        object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary rounded-circle
                            d-inline-flex align-items-center
                            justify-content-center"
                             style="width:90px;height:90px;">
                            <i class="fas fa-user fa-3x text-white"></i>
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <h5 class="mb-1">@active.Name</h5>
                    <p class="text-muted mb-1">@active.Designation</p>
                    @if (active.DateOfJoiningInstitute.HasValue)
                    {
                        <small class="text-muted">
                            <i class="fas fa-calendar mr-1"></i>
                            Joined:
                            @active.DateOfJoiningInstitute.Value
                            .ToString("dd MMM yyyy")
                        </small>
                    }
                </div>
                <div class="col-md-4">
                    <div class="d-flex flex-column" style="gap:6px;">
                        <a asp-action="Edit" asp-route-id="@active.Id"
                               class="btn btn-info btn-sm">
                            <i class="fas fa-edit mr-1"></i>
                            Edit Profile
                        </a>
                        <a asp-action="Preview" asp-route-id="@active.Id"
                               target="_blank"
                               class="btn btn-secondary btn-sm">
                            <i class="fas fa-eye mr-1"></i>
                            Preview
                        </a>
                    </div>
                    <!-- Quick Sub-sections -->
                    <div class="mt-2 d-flex flex-wrap" style="gap:4px;">
                        @{
                            var subs = new[]
                            {
                                ("Qualifications", "fa-graduation-cap"),
                                ("Experience",     "fa-briefcase"),
                                ("Publications",   "fa-book-open"),
                                ("BookPublications","fa-book"),
                                ("ExpertTalks",    "fa-chalkboard"),
                                ("Achievements",   "fa-trophy"),
                                ("Memberships",    "fa-id-badge")
                            };
                        }
                        @foreach (var (action, icon) in subs)
                        {
                            <a asp-action="@action"
                                   asp-route-id="@active.Id"
                                   class="btn btn-xs btn-outline-primary"
                                   title="@action">
                                <i class="fas @icon"></i>
                            </a>
                        }
                        <a asp-controller="DynamicSection"
                               asp-action="Index"
                               asp-route-pageType="5"
                               asp-route-pageId="@active.Id"
                               class="btn btn-xs btn-outline-secondary"
                               title="Dynamic Sections">
                            <i class="fas fa-layer-group"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        No active principal configured.
        <a asp-action="Create" class="btn btn-sm btn-primary ml-2">
            Add Principal
        </a>
    </div>
}
 
<!-- Past Principals -->
@if (past.Any())
{
    <h6 class="font-weight-bold mb-2 text-muted">
        <i class="fas fa-history mr-2"></i>Past Principals
    </h6>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="thead-light">
                    <tr>
                        <th width="60">Photo</th>
                        <th>Name</th>
                        <th width="150">Joined</th>
                        <th width="150">Transferred</th>
                        <th width="250">Transfer Note</th>
                        <th width="120">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in past)
                    {
                        <tr class="table-secondary">
                            <td>
                                @if (!string.IsNullOrEmpty(p.PhotoPath))
                                {
                                    <img src="@p.PhotoPath"
                                         class="rounded-circle"
                                         style="width:35px;height:35px;
                                    object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle
                                        d-inline-flex align-items-center
                                        justify-content-center"
                                         style="width:35px;height:35px;">
                                        <i class="fas fa-user text-white"
                                           style="font-size:12px;"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong>@p.Name</strong>
                                <small class="text-muted d-block">
                                    @p.Designation
                                </small>
                            </td>
                            <td>
                                <small>
                                    @(p.DateOfJoiningInstitute.HasValue
                                        ? p.DateOfJoiningInstitute.Value
                                            .ToString("dd MMM yyyy")
                                        : "—")
                                </small>
                            </td>
                            <td>
                                <small>
                                    @(p.TransferDate.HasValue
                                        ? p.TransferDate.Value
                                            .ToString("dd MMM yyyy")
                                        : "—")
                                </small>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @p.TransferNote
                                </small>
                            </td>
                            <td>
                                <a asp-action="Edit"
                                       asp-route-id="@p.Id"
                                       class="btn btn-xs btn-info">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Preview"
                                       asp-route-id="@p.Id"
                                       target="_blank"
                                       class="btn btn-xs btn-secondary">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}