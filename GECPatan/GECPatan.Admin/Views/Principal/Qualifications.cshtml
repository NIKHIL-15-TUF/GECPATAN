@using  GECPatan.Core.Models.Domain
@model List<PrincipalQualification>
@{
    int    principalId   = ViewBag.PrincipalId;
    string principalName = ViewBag.PrincipalName ?? "";
    ViewData["Title"]    = "Qualifications";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@principalId"
       class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Educational Qualifications</h5>
        <small class="text-muted">@principalName</small>
    </div>
</div>
<div class="row">
    <!-- Add Form -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Qualification
                </h6>
            </div>
            <form asp-action="AddQualification" method="post">
                <div class="card-body">
                    <input type="hidden" name="PrincipalId" value="@principalId" />
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Degree <span class="text-danger">*</span>
                        </label>
                        <select name="Degree" class="form-control" required>
                            <option value="">-- Select Degree --</option>
                            <option>PhD</option>
                            <option>Pursuing PhD</option>
                            <option>ME / MTech</option>
                            <option>BE / BTech</option>
                            <option>MCA</option>
                            <option>MSc</option>
                            <option>BSc</option>
                            <option>Diploma</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">University</label>
                        <input name="University" class="form-control"
                               placeholder="University name" />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Year</label>
                                <input name="Year" class="form-control"
                                       placeholder="e.g. 2015" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Result</label>
                                <input name="Result" class="form-control"
                                       placeholder="e.g. First Class" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Display Order</label>
                        <input name="DisplayOrder" class="form-control"
                               type="number" value="@Model.Count" min="0" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- List -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-graduation-cap mr-2"></i>
                    Qualifications (@Model.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No qualifications yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Degree</th>
                                <th>University</th>
                                <th width="70">Year</th>
                                <th width="100">Result</th>
                                <th width="60"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model)
                            {
                                <tr>
                                    <td><strong>@q.Degree</strong></td>
                                    <td>@q.University</td>
                                    <td>@q.Year</td>
                                    <td>@q.Result</td>
                                    <td>
                                        <form asp-action="DeleteQualification"
                                              method="post">
                                            <input type="hidden" name="id"
                                                   value="@q.Id" />
                                            <input type="hidden"
                                                   name="principalId"
                                                   value="@principalId" />
                                            <button type="submit"
                                                    class="btn btn-xs btn-danger"
                                                    onclick="return confirm('Remove?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>