@using GECPatan.Core.Models.Domain
@model Principal
@{
    Layout = null;
    ViewData["Title"] = Model.Name + " — Preview";
    var dynamicSections = ViewBag.DynamicSections
        as List<DynamicSection> ?? new();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        body { background:#f5f5f5; }
        .preview-banner {
            background:#1a237e;color:#fff;
            padding:8px 20px;
            font-size:12px;
            position:sticky;top:0;z-index:999;
        }
        .profile-card {
            background:#fff;border-radius:8px;
            box-shadow:0 2px 8px rgba(0,0,0,.1);
            padding:24px;margin-bottom:20px;
        }
        .nav-tabs .nav-link.active {
            background:#1a237e;color:#fff;border-color:#1a237e;
        }
        .nav-tabs .nav-link { color:#1a237e; }
        .section-title {
            color:#1a237e;border-bottom:2px solid #1a237e;
            padding-bottom:6px;margin-bottom:16px;
            font-size:16px;font-weight:bold;
        }
        table th { background:#1a237e;color:#fff; }
    </style>
</head>
<body>
<div class="preview-banner d-flex justify-content-between
            align-items-center">
    <span>
        <i class="fas fa-eye mr-2"></i>
        Preview: @Model.Name
        @if (!Model.IsActive)
        {
            <span class="badge badge-warning ml-2">Past Principal</span>
        }
    </span>
    <button onclick="window.close()"
            class="btn btn-sm btn-light">Close</button>
</div>
 
<div class="container py-4">
 
    <!-- Profile Header -->
    <div class="profile-card">
        <div class="row align-items-center">
            <div class="col-md-3 text-center">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath"
                         class="img-fluid rounded-circle mb-2"
                         style="width:160px;height:160px;
                                object-fit:cover;
                                border:4px solid #1a237e;" />
                }
                else
                {
                    <div class="bg-secondary rounded-circle
                                d-inline-flex align-items-center
                                justify-content-center mb-2"
                         style="width:160px;height:160px;">
                        <i class="fas fa-user fa-5x text-white"></i>
                    </div>
                }
            </div>
            <div class="col-md-9">
                <h3 style="color:#1a237e;">@Model.Name</h3>
                <p class="text-muted mb-2">@Model.Designation</p>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <p class="mb-1">
                        <i class="fas fa-envelope mr-2 text-primary"></i>
                        @Model.Email
                    </p>
                }
                @if (!string.IsNullOrEmpty(Model.Contact))
                {
                    <p class="mb-1">
                        <i class="fas fa-phone mr-2 text-primary"></i>
                        @Model.Contact
                    </p>
                }
                @if (Model.DateOfJoiningInstitute.HasValue)
                {
                    <p class="mb-1">
                        <i class="fas fa-calendar mr-2 text-primary"></i>
                        Joined Institute:
                        @Model.DateOfJoiningInstitute.Value
                            .ToString("dd MMM yyyy")
                    </p>
                }
                @if (!string.IsNullOrEmpty(Model.AreaOfInterest))
                {
                    <p class="mb-0">
                        <i class="fas fa-star mr-2 text-primary"></i>
                        <strong>Area of Interest:</strong>
                        @Model.AreaOfInterest
                    </p>
                }
            </div>
        </div>
 
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <hr />
            <div>@Html.Raw(Model.Message)</div>
        }
    </div>
 
    <!-- Tabs -->
    <ul class="nav nav-tabs" id="principalTabs">
        @if (Model.Qualifications.Any())
        {
            <li class="nav-item">
                <a class="nav-link active" data-toggle="tab"
                   href="#qual">Qualifications</a>
            </li>
        }
        @if (Model.Experiences.Any())
        {
            <li class="nav-item">
                <a class="nav-link @(!Model.Qualifications.Any()?"active":"")"
                   data-toggle="tab" href="#exp">Experience</a>
            </li>
        }
        @if (Model.Publications.Any())
        {
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab"
                   href="#pub">Publications</a>
            </li>
        }
        @if (Model.BookPublications.Any())
        {
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab"
                   href="#books">Books</a>
            </li>
        }
        @if (Model.ExpertTalks.Any())
        {
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab"
                   href="#talks">Expert Talks</a>
            </li>
        }
        @if (Model.Achievements.Any())
        {
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab"
                   href="#achieve">Achievements</a>
            </li>
        }
        @if (Model.Memberships.Any())
        {
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab"
                   href="#member">Memberships</a>
            </li>
        }
        @foreach (var sec in dynamicSections)
        {
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab"
                   href="#dyn-@sec.Id">@sec.Title</a>
            </li>
        }
    </ul>
 
    <div class="tab-content profile-card"
         style="border-radius:0 0 8px 8px;">
 
        <!-- Qualifications -->
        @if (Model.Qualifications.Any())
        {
            <div class="tab-pane fade show active" id="qual">
                <div class="section-title">
                    Educational Qualifications
                </div>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Degree</th><th>University</th>
                            <th>Year</th><th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.Qualifications)
                        {
                            <tr>
                                <td>@q.Degree</td>
                                <td>@q.University</td>
                                <td>@q.Year</td>
                                <td>@q.Result</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
 
        <!-- Experience -->
        @if (Model.Experiences.Any())
        {
            <div class="tab-pane fade
                        @(!Model.Qualifications.Any()?"show active":"")"
                 id="exp">
                <div class="section-title">Professional Experience</div>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Designation</th><th>Organization</th>
                            <th>From</th><th>To</th><th>Place</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Experiences)
                        {
                            <tr>
                                <td>@e.Designation</td>
                                <td>@e.Organization</td>
                                <td>
                                    @(e.FromDate.HasValue
                                        ? e.FromDate.Value.ToString("MMM yyyy")
                                        : "")
                                </td>
                                <td>
                                    @(e.ToDate.HasValue
                                        ? e.ToDate.Value.ToString("MMM yyyy")
                                        : "Present")
                                </td>
                                <td>@e.Place</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
 
        <!-- Publications -->
        @if (Model.Publications.Any())
        {
            <div class="tab-pane fade" id="pub">
                <div class="section-title">Publications</div>
                @foreach (var type in new[]{"Journal","Conference"})
                {
                    var typePubs = Model.Publications
                        .Where(p => p.Type == type).ToList();
                    if (typePubs.Any())
                    {
                        <h6 class="text-muted">@type Papers</h6>
                        <table class="table table-bordered table-sm mb-3">
                            <thead>
                                <tr>
                                    <th>#</th><th>Title</th>
                                    <th>Journal/Conference</th>
                                    <th>Year</th><th>DOI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < typePubs.Count; i++)
                                {
                                    var pub = typePubs[i];
                                    <tr>
                                        <td>@(i+1)</td>
                                        <td>@pub.Title</td>
                                        <td>@pub.JournalOrConference</td>
                                        <td>@pub.Year</td>
                                        <td>@pub.DOI</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        }
 
        <!-- Books -->
        @if (Model.BookPublications.Any())
        {
            <div class="tab-pane fade" id="books">
                <div class="section-title">Book Publications</div>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Title</th><th>Publisher</th>
                            <th>ISBN</th><th>University</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.BookPublications)
                        {
                            <tr>
                                <td>
                                    <strong>@b.Title</strong>
                                    @if (!string.IsNullOrEmpty(b.ContentTopics))
                                    {
                                        <small class="text-muted d-block">
                                            @b.ContentTopics
                                        </small>
                                    }
                                </td>
                                <td>@b.Publisher</td>
                                <td>@b.ISBN</td>
                                <td>@b.University</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
 
        <!-- Expert Talks -->
        @if (Model.ExpertTalks.Any())
        {
            <div class="tab-pane fade" id="talks">
                <div class="section-title">Expert Talks / Guest Lectures</div>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Year</th><th>Subject</th>
                            <th>Place</th><th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.ExpertTalks)
                        {
                            <tr>
                                <td>@t.Year</td>
                                <td>@t.Subject</td>
                                <td>@t.Place</td>
                                <td>@t.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
 
        <!-- Achievements -->
        @if (Model.Achievements.Any())
        {
            <div class="tab-pane fade" id="achieve">
                <div class="section-title">Achievements</div>
                <ul class="list-group">
                    @foreach (var a in Model.Achievements)
                    {
                        <li class="list-group-item">
                            <i class="fas fa-trophy text-warning mr-2"></i>
                            @a.AchievementText
                            @if (!string.IsNullOrEmpty(a.Year))
                            {
                                <span class="badge badge-secondary ml-1">
                                    @a.Year
                                </span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
 
        <!-- Memberships -->
        @if (Model.Memberships.Any())
        {
            <div class="tab-pane fade" id="member">
                <div class="section-title">
                    Professional Memberships
                </div>
                <ul class="list-group">
                    @foreach (var m in Model.Memberships)
                    {
                        <li class="list-group-item">
                            <i class="fas fa-id-badge text-primary mr-2"></i>
                            @m.MembershipText
                        </li>
                    }
                </ul>
            </div>
        }
 
        <!-- Dynamic Sections -->
        @foreach (var sec in dynamicSections)
        {
            <div class="tab-pane fade" id="dyn-@sec.Id">
                <div class="section-title">@sec.Title</div>
                @Html.Raw(sec.HtmlContent)
            </div>
        }
    </div>
</div>
 
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>