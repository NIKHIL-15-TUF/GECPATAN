@using GECPatan.Admin.Models.Domain
@model List<PrincipalBookPublication>
@{
    int principalId = ViewBag.PrincipalId;
    string principalName = ViewBag.PrincipalName ?? "";
    ViewData["Title"] = "Book Publications";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@principalId"
           class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Book Publications</h5>
        <small class="text-muted">@principalName</small>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Book
                </h6>
            </div>
            <form asp-action="AddBookPublication" method="post">
                <div class="card-body">
                    <input type="hidden" name="PrincipalId"
                           value="@principalId" />
                    <div class="form-group">
                        <label class="font-weight-bold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input name="Title" class="form-control"
                               placeholder="Book title" required />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Book Code</label>
                        <input name="BookCode" class="form-control"
                               placeholder="e.g. CS601" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Publisher</label>
                        <input name="Publisher" class="form-control"
                               placeholder="Publisher name" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">ISBN</label>
                        <input name="ISBN" class="form-control"
                               placeholder="978-xxx-xxxx" />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">University</label>
                                <input name="University" class="form-control"
                                       placeholder="GTU" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Branch</label>
                                <input name="Branch" class="form-control"
                                       placeholder="CSE" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Semester</label>
                        <input name="Semester" class="form-control"
                               placeholder="e.g. 6th" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Content Topics</label>
                        <textarea name="ContentTopics" class="form-control"
                                  rows="2"
                                  placeholder="Key topics covered"></textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add Book
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-book mr-2"></i>
                    Book Publications (@Model.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">
                        No book publications yet.
                    </p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Title</th>
                                <th>Publisher</th>
                                <th>ISBN</th>
                                <th>Branch / Sem</th>
                                <th width="60"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@b.Title</strong>
                                        @if (!string.IsNullOrEmpty(b.BookCode))
                                        {
                                            <small class="text-muted d-block">
                                                @b.BookCode
                                            </small>
                                        }
                                    </td>
                                    <td><small>@b.Publisher</small></td>
                                    <td><small>@b.ISBN</small></td>
                                    <td>
                                        <small>@b.Branch</small>
                                        @if (!string.IsNullOrEmpty(b.Semester))
                                        {
                                            <small class="text-muted d-block">
                                                Sem: @b.Semester
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="DeleteBookPublication"
                                              method="post">
                                            <input type="hidden" name="id"
                                                   value="@b.Id" />
                                            <input type="hidden"
                                                   name="principalId"
                                                   value="@principalId" />
                                            <button type="submit"
                                                    class="btn btn-xs btn-danger"
                                                    onclick="return confirm('Remove?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>