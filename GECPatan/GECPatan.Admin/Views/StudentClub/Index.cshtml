@model List<GECPatan.Admin.Models.ViewModels.StudentClubListVM>
@{
    ViewData["Title"] = "Student Clubs";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <span class="badge badge-info px-3 py-2" style="font-size:13px;">
            @Model.Count Club(s)
        </span>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Add Club
        </a>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#1a237e;color:#fff;">
                <tr>
                    <th>Club Name</th>
                    <th width="90">Images</th>
                    <th width="90">Members</th>
                    <th width="80">Status</th>
                    <th width="230">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fas fa-users fa-2x mb-2 d-block"></i>
                            No clubs yet.
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Title</strong></td>
                        <td>
                            <span class="badge badge-success">
                                @c.ImageCount 🖼
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-secondary">@c.MemberCount</span>
                        </td>
                        <td>
                            @if (c.IsVisible)
                            {
                                <span class="badge badge-success">Visible</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Hidden</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-info mb-1">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Members" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-secondary mb-1">
                                <i class="fas fa-users"></i> Members
                            </a>
                            <a asp-controller="DynamicSection" asp-action="Index"
                                   asp-route-pageType="4" asp-route-pageId="@c.Id"
                                   class="btn btn-sm btn-primary mb-1">
                                <i class="fas fa-layer-group"></i> Sections
                            </a>
                            <form asp-action="ToggleVisible" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit"
                                        class="btn btn-sm @(c.IsVisible ? "btn-warning" : "btn-success") mb-1">
                                    <i class="fas @(c.IsVisible ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-danger mb-1"
                                        onclick="return confirm('Delete?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
