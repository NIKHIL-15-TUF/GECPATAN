@using GECPatan.Admin.Models.Domain
@model List<ClubMember>
@{
    ViewData["Title"] = "Club Members";
    int clubId        = ViewBag.ClubId;
    string clubTitle  = ViewBag.ClubTitle ?? "";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Edit" asp-route-id="@clubId" class="btn btn-secondary btn-sm mr-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0">Members</h5>
        <small class="text-muted">@clubTitle</small>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" style="background:#1a237e;color:#fff;">
                <h6 class="card-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Add Member
                </h6>
            </div>
            <form asp-action="AddMember" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    <input type="hidden" name="ClubId" value="@clubId" />
                    <div class="form-group">
                        <label class="font-weight-bold">Name <span class="text-danger">*</span></label>
                        <input name="Name" class="form-control" placeholder="Full name" required />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Position</label>
                        <input name="Position" class="form-control"
                               placeholder="e.g. President, Secretary" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Department</label>
                        <input name="Department" class="form-control"
                               placeholder="Department" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Email</label>
                        <input name="Email" class="form-control" type="email"
                               placeholder="email@gecpatan.ac.in" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Photo</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input"
                                   name="MemberPhoto" accept="image/*"
                                   onchange="this.nextElementSibling.textContent=this.files[0]?.name||'Choose...'" />
                            <label class="custom-file-label">Choose photo...</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Order</label>
                        <input name="DisplayOrder" class="form-control"
                               type="number" value="@Model.Count" min="0" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-plus mr-2"></i>Add Member
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-users mr-2"></i>Members (@Model.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No members yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th width="50">Photo</th>
                                <th>Name</th>
                                <th>Position</th>
                                <th>Dept</th>
                                <th width="60"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(m.ImagePath))
                                        {
                                            <img src="@m.ImagePath"
                                                 class="img-thumbnail rounded-circle"
                                                 style="width:35px;height:35px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded-circle
                                                        d-inline-flex align-items-center
                                                        justify-content-center"
                                                 style="width:35px;height:35px;">
                                                <i class="fas fa-user text-white"
                                                   style="font-size:12px;"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@m.Name</strong>
                                        @if (!string.IsNullOrEmpty(m.Email))
                                        {
                                            <small class="text-muted d-block">@m.Email</small>
                                        }
                                    </td>
                                    <td>@m.Position</td>
                                    <td><small>@m.Department</small></td>
                                    <td>
                                        <form asp-action="DeleteMember" method="post">
                                            <input type="hidden" name="id" value="@m.Id" />
                                            <input type="hidden" name="clubId" value="@clubId" />
                                            <button type="submit"
                                                    class="btn btn-xs btn-danger"
                                                    onclick="return confirm('Remove?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>