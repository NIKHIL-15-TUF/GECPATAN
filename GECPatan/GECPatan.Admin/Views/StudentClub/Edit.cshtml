@model GECPatan.Admin.Models.ViewModels.StudentClubEditVM
@{
    ViewData["Title"] = "Edit Club";
}
<div class="card">
    <div class="card-header" style="background:#1a237e;color:#fff;">
        <h3 class="card-title">
            <i class="fas fa-users mr-2"></i>Edit Club — @Model.Title
        </h3>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id"
          method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
            }
            <div class="form-group">
                <label asp-for="Title" class="font-weight-bold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label class="font-weight-bold">About</label>
                <textarea asp-for="About" class="form-control" rows="4"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="BlogLink" class="font-weight-bold"></label>
                        <input asp-for="BlogLink" class="form-control"
                               placeholder="https://..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="DisplayOrder" class="font-weight-bold"></label>
                        <input asp-for="DisplayOrder" class="form-control"
                               type="number" min="0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group mt-4">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsVisible" type="checkbox"
                                   class="custom-control-input" id="isVisible" />
                            <label class="custom-control-label" for="isVisible">
                                Visible
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Cover Image (separate from carousel) -->
            <label class="font-weight-bold">Cover Image</label>
            <small class="text-muted d-block mb-2">
                <i class="fas fa-info-circle mr-1"></i>
                Shown on the Student Clubs list and at the top of the club's page —
                independent of the carousel images below.
            </small>

            @if (!string.IsNullOrWhiteSpace(Model.CoverImagePath))
            {
                <div class="mb-2">
                    <img src="@Model.CoverImagePath" class="img-thumbnail"
                         style="height:100px;object-fit:cover;" />
                </div>
            }

            <div class="form-group">
                <div class="custom-file">
                    <input type="file" class="custom-file-input" name="CoverImageFile"
                           accept="image/*"
                           onchange="this.nextElementSibling.textContent=this.files[0]?.name || 'Choose new cover image...'" />
                    <label class="custom-file-label">
                        @(string.IsNullOrWhiteSpace(Model.CoverImagePath) ? "Choose cover image..." : "Replace cover image...")
                    </label>
                </div>
                <small class="text-muted">Leave empty to keep the current cover image.</small>
            </div>

            <hr />

            <!-- Club Images (carousel) -->
            <label class="font-weight-bold">
                Club Images (Carousel)
                <small class="text-muted ml-1">
                    (@Model.ExistingImages.Count current)
                </small>
            </label>
            <small class="text-muted d-block mb-2">
                <i class="fas fa-info-circle mr-1"></i>
                These images are shown as a carousel on the public website.
            </small>

            @if (Model.ExistingImages.Any())
            {
                <div class="row mb-3">
                    @foreach (var img in Model.ExistingImages)
                    {
                        <div class="col-md-3 col-6 mb-2 text-center">
                            <img src="@img.ImagePath" class="img-thumbnail"
                                 style="height:80px;object-fit:cover;width:100%;" />
                            <small class="text-muted d-block text-truncate"
                                   style="font-size:10px;">@img.Caption</small>
                            <form asp-action="DeleteImage" method="post" class="mt-1">
                                <input type="hidden" name="imageId" value="@img.Id" />
                                <input type="hidden" name="clubId" value="@Model.Id" />
                                <button type="submit" class="btn btn-xs btn-danger btn-block"
                                        onclick="return confirm('Remove image?')">
                                    <i class="fas fa-times mr-1"></i>Remove
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }

            <div class="form-group">
                <label class="font-weight-bold">Add More Images</label>
                <div class="custom-file">
                    <input type="file" class="custom-file-input" name="NewImages"
                           multiple accept="image/*"
                           onchange="this.nextElementSibling.textContent=this.files.length+' image(s) selected'" />
                    <label class="custom-file-label">
                        Choose images (multiple allowed)...
                    </label>
                </div>
                <small class="text-muted">Hold Ctrl to select multiple.</small>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left mr-2"></i>Back
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>Save Changes
            </button>
        </div>
    </form>
</div>

<!-- Quick Links -->
<div class="card mt-3">
    <div class="card-header bg-light">
        <h6 class="card-title mb-0">
            <i class="fas fa-link mr-2"></i>Quick Links
        </h6>
    </div>
    <div class="card-body p-2">
        <div class="row">
            <div class="col-md-4 mb-2">
                <a asp-action="Members" asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary btn-block btn-sm">
                    <i class="fas fa-users d-block mb-1" style="font-size:18px;"></i>
                    Members
                </a>
            </div>
            <div class="col-md-4 mb-2">
                <a asp-controller="DynamicSection" asp-action="Index"
                       asp-route-pageType="4" asp-route-pageId="@Model.Id"
                       class="btn btn-outline-primary btn-block btn-sm">
                    <i class="fas fa-layer-group d-block mb-1" style="font-size:18px;"></i>
                    Sections
                </a>
            </div>
            <div class="col-md-4 mb-2">
                <a asp-controller="Activity" asp-action="Index"
                       class="btn btn-outline-success btn-block btn-sm">
                    <i class="fas fa-calendar-alt d-block mb-1" style="font-size:18px;"></i>
                    Activities
                </a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
