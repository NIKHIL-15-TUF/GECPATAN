{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GECPatan;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "BlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "uploads",
    "PublicBaseUrl": null
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "your-smtp-account@example.com",
    "Password": "your-smtp-app-password",
    "TimeoutMs": 15000
  },
  "AllowedHosts": "*"
}
